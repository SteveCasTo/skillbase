---
import BaseLayout from "@/layouts/BaseLayout.astro";

const reason = Astro.url.searchParams.get("reason");
const disabled = reason === "disabled";
const forbidden = reason === "forbidden";
const title = forbidden ? "Permiso insuficiente" : "Acceso no habilitado";
const description = disabled
  ? "Tu cuenta interna está deshabilitada. Contacta a administración."
  : forbidden
    ? "Tu cuenta está activa, pero no tiene el rol necesario para esta sección."
    : "La cuenta autenticada no tiene una invitación activa en SkillBase.";
Astro.response.status = 403;
---

<BaseLayout title={`${title} | SkillBase`}>
  <main class="grid min-h-svh place-items-center px-5 py-12">
    <section
      class="w-full max-w-lg rounded-2xl border bg-card p-8 shadow-md"
      aria-labelledby="unauthorized-title"
    >
      <p class="font-mono text-sm text-destructive">403 / acceso restringido</p>
      <h1
        id="unauthorized-title"
        class="mt-3 text-3xl font-semibold tracking-tight"
      >
        {title}
      </h1>
      <p class="mt-4 leading-7 text-muted-foreground">{description}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        {forbidden && (
          <a
            class="inline-flex min-h-11 items-center rounded-lg bg-primary px-5 font-semibold text-primary-foreground"
            href="/app"
          >
            Volver al resumen
          </a>
        )}
        <form method="post" action="/auth/logout">
          <button
            class="min-h-11 rounded-lg border bg-background px-5 font-semibold hover:bg-secondary"
            type="submit"
          >
            Cerrar sesión
          </button>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>
