---
import { LogIn } from "lucide-react";

import BaseLayout from "@/layouts/BaseLayout.astro";
import { safeRelativeRedirect } from "@/server/auth/redirects";
import PasswordField from "@/components/auth/PasswordField";
import AuthFormPending from "@/components/auth/AuthFormPending.astro";
import { Input } from "@/components/ui/input";
import { buttonVariants } from "@/components/ui/button";

const next = safeRelativeRedirect(Astro.url.searchParams.get("next"));
const error = Astro.url.searchParams.get("error");
const signedOut = Astro.url.searchParams.get("status") === "signed_out";
const recoverySent = Astro.url.searchParams.get("status") === "recovery_sent";
---

<BaseLayout title="Iniciar sesión | SkillBase">
  <main class="grid min-h-svh place-items-center px-5 py-12">
    <section
      class="w-full max-w-md rounded-2xl border bg-card p-7 shadow-lg sm:p-9"
      aria-labelledby="login-title"
    >
      <a class="text-sm font-semibold text-primary" href="/">
        SkillBase
      </a>
      <h1 id="login-title" class="mt-6 text-3xl font-semibold tracking-tight">
        Acceso al equipo
      </h1>
      <p class="mt-3 text-sm leading-6 text-muted-foreground">
        Ingresa con Google o con el correo y la contraseña de tu cuenta.
      </p>
      {signedOut && (
        <p class="mt-5 rounded-lg border bg-muted p-3 text-sm" role="status">
          La sesión se cerró correctamente.
        </p>
      )}
      {error && (
        <p
          class="mt-5 rounded-lg border border-destructive/40 bg-destructive/10 p-3 text-sm"
          role="alert"
        >
          No pudimos iniciar la sesión. Inténtalo nuevamente.
        </p>
      )}
      {recoverySent && (
        <p class="mt-5 rounded-lg border bg-muted p-3 text-sm" role="status">
          Si podemos procesar la solicitud para una cuenta habilitada,
          enviaremos un enlace para confirmar tu acceso. Revisa también spam.
        </p>
      )}
      <form
        class="mt-7 flex flex-col gap-5"
        method="post"
        action="/auth/password"
        data-auth-form
        data-astro-reload
      >
        <input type="hidden" name="next" value={next} />
        <div class="flex flex-col gap-2">
          <label for="email" class="text-sm font-medium">
            Correo electrónico
          </label>
          <Input
            id="email"
            name="email"
            type="email"
            autoComplete="username"
            required
            maxLength={254}
          />
        </div>
        <PasswordField
          name="password"
          label="Contraseña"
          autoComplete="current-password"
          client:load
        />
        <button
          class={buttonVariants({ className: "min-h-11 w-full" })}
          type="submit"
          data-label="Iniciar sesión"
        >
          Iniciar sesión
        </button>
      </form>
      <p class="mt-6 text-center text-sm text-muted-foreground">
        O utiliza tu cuenta de Google
      </p>
      <form
        class="mt-7"
        method="post"
        action="/auth/google"
        data-auth-form
        data-astro-reload
      >
        <input type="hidden" name="next" value={next} />
        <button
          class="flex min-h-12 w-full items-center justify-center gap-3 rounded-lg bg-primary px-5 font-semibold text-primary-foreground shadow-sm hover:opacity-90"
          type="submit"
        >
          <LogIn size={19} aria-hidden="true" /> Continuar con Google
        </button>
      </form>
      <p class="mt-5 text-xs leading-5 text-muted-foreground">
        El acceso está limitado a administradores e instructores
        preaprovisionados.
      </p>
      <details class="mt-6 border-t pt-5">
        <summary class="cursor-pointer text-sm font-medium text-primary">
          ¿Olvidaste tu contraseña?
        </summary>
        <form
          class="mt-4 flex flex-col gap-3"
          method="post"
          action="/auth/forgot-password"
          data-auth-form
          data-astro-reload
        >
          <label for="recovery-email" class="text-sm font-medium">
            Correo de tu cuenta
          </label>
          <Input
            id="recovery-email"
            name="email"
            type="email"
            autoComplete="email"
            required
            maxLength={254}
          />
          <button
            class={buttonVariants({
              variant: "outline",
              className: "min-h-11",
            })}
            type="submit"
            data-label="Enviar enlace"
          >
            Enviar enlace
          </button>
        </form>
      </details>
    </section>
  </main>
  <AuthFormPending />
</BaseLayout>
