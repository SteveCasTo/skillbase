---
import { LogIn } from "lucide-react";

import BaseLayout from "@/layouts/BaseLayout.astro";
import { safeRelativeRedirect } from "@/server/auth/redirects";

const next = safeRelativeRedirect(Astro.url.searchParams.get("next"));
const error = Astro.url.searchParams.get("error");
const signedOut = Astro.url.searchParams.get("status") === "signed_out";
---

<BaseLayout title="Iniciar sesión | SkillBase">
  <main class="grid min-h-svh place-items-center px-5 py-12">
    <section
      class="w-full max-w-md rounded-2xl border bg-card p-7 shadow-lg sm:p-9"
      aria-labelledby="login-title"
    >
      <a class="text-sm font-semibold text-primary" href="/">
        SkillBase
      </a>
      <h1 id="login-title" class="mt-6 text-3xl font-semibold tracking-tight">
        Acceso al equipo
      </h1>
      <p class="mt-3 text-sm leading-6 text-muted-foreground">
        Ingresa con la cuenta de Google que fue invitada previamente.
      </p>
      {signedOut && (
        <p class="mt-5 rounded-lg border bg-muted p-3 text-sm" role="status">
          La sesión se cerró correctamente.
        </p>
      )}
      {error && (
        <p
          class="mt-5 rounded-lg border border-destructive/40 bg-destructive/10 p-3 text-sm"
          role="alert"
        >
          No pudimos iniciar la sesión. Inténtalo nuevamente.
        </p>
      )}
      <form class="mt-7" method="post" action="/auth/google">
        <input type="hidden" name="next" value={next} />
        <button
          class="flex min-h-12 w-full items-center justify-center gap-3 rounded-lg bg-primary px-5 font-semibold text-primary-foreground shadow-sm hover:opacity-90"
          type="submit"
        >
          <LogIn size={19} aria-hidden="true" /> Continuar con Google
        </button>
      </form>
      <p class="mt-5 text-xs leading-5 text-muted-foreground">
        El acceso está limitado a administradores e instructores
        preaprovisionados.
      </p>
    </section>
  </main>
</BaseLayout>
