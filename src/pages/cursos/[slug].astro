---
import CourseShell from "@/components/public-courses/CourseShell.astro";
import {
  availabilityLabels,
  levelLabels,
} from "@/components/landing/course-presentation";
import {
  civilDate,
  registrationWindow,
  type DisplayCourse,
} from "@/components/public-courses/course-details";
import { parseCourseMarkdown } from "@/components/public-courses/course-markdown";
import MarkdownNode from "@/components/public-courses/MarkdownNode.astro";
import { getDatabase } from "@/server/db/client";
import { DrizzleCourseRepository } from "@/server/db/repositories/course-repository";
import { publicArtworkUrl } from "@/server/courses/artwork";
import CourseArtworkFallback from "@/components/public-courses/CourseArtworkFallback.astro";
import PublicInterestSection from "@/components/public-courses/PublicInterestSection.astro";
import {
  EMPTY_INTEREST_VALUES,
  INTEREST_SUCCESS_MESSAGE,
} from "@/components/public-courses/public-interest-presentation";
import {
  handlePublicInterestPost,
  loadPublicInterestForm,
} from "@/server/interests/http";
import type { PublicInterestFormDto } from "@/domain/interests/types";

let interestPost:
  Awaited<ReturnType<typeof handlePublicInterestPost>> | undefined;
if (Astro.request.method === "POST" && Astro.params.slug) {
  let clientAddress = "";
  try {
    clientAddress = Astro.clientAddress;
  } catch {
    /* The backend fails closed without a trusted adapter address. */
  }
  interestPost = await handlePublicInterestPost({
    request: Astro.request,
    slug: Astro.params.slug,
    clientAddress,
  });
  const headers = new Headers(interestPost.headers);
  headers.set("Cache-Control", "no-store");
  if (Astro.request.headers.get("accept")?.includes("application/json")) {
    headers.set("Content-Type", "application/json; charset=utf-8");
    return new Response(JSON.stringify(interestPost.payload), {
      status: interestPost.status,
      headers,
    });
  }
  Astro.response.status = interestPost.status;
  headers.forEach((value, key) => Astro.response.headers.set(key, value));
}

const slug = Astro.params.slug;
let course: DisplayCourse | null = null;
let loadError = false;
try {
  course = slug
    ? await new DrizzleCourseRepository(getDatabase()).getPublic(slug)
    : null;
} catch {
  loadError = true;
  if (!interestPost) Astro.response.status = 503;
}
if (!loadError && !course && !interestPost) Astro.response.status = 404;
let interestForm: PublicInterestFormDto | null = null;
if (course && slug) {
  try {
    interestForm = await loadPublicInterestForm(slug);
  } catch {
    /* Keep the published detail readable when interest lookup is unavailable. */
  }
}
const title = course
  ? `${course.name} | Formación continua · UMSS`
  : interestPost?.payload.ok
    ? "Gracias por tu interés | Formación continua"
    : loadError
      ? "Consulta no disponible | Formación continua"
      : "Curso no encontrado | Formación continua";
const artworkUrl = publicArtworkUrl(
  course?.artwork,
  import.meta.env.PUBLIC_SUPABASE_URL,
);
const registrationDates = course ? registrationWindow(course) : null;
---

<CourseShell
  {title}
  description={
    course?.description ??
    "Consulta los cursos publicados de formación continua de Informática y Sistemas, FCyT · UMSS."
  }
  noindex={!course}
>
  <div class="detail-wrap">
    {course ? (
      <>
        <header class="detail-hero">
          <div class="detail-heading">
            <p class="course-status">
              {availabilityLabels[course.registrationAvailability].replace(
                "Preinscripción",
                "Preinscripción presencial",
              )}
            </p>
            <h1>{course.name}</h1>
            <p class="detail-description">{course.description}</p>
            {interestForm?.available && !interestPost?.payload.ok && (
              <a class="interest-anchor" href="#interes">
                Dejar mis datos de interés
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M12 4v16m-6-6 6 6 6-6" />
                </svg>
              </a>
            )}
          </div>
          {artworkUrl ? (
            <div class="detail-art has-photo" aria-hidden="true">
              <img
                src={artworkUrl}
                alt=""
                width="1200"
                height="750"
                decoding="async"
              />
            </div>
          ) : (
            <div class="detail-art has-fallback" aria-hidden="true">
              <CourseArtworkFallback name={course.name} />
            </div>
          )}
        </header>
        <div class="detail-body">
          <div class="detail-main">
            {course.contentMarkdown?.trim() && (
              <section aria-labelledby="content-title" class="detail-section">
                <h2 id="content-title">Sobre el curso</h2>
                <div class="course-markdown">
                  {parseCourseMarkdown(course.contentMarkdown).map((node) => (
                    <MarkdownNode node={node} />
                  ))}
                </div>
              </section>
            )}
            <section aria-labelledby="conditions-title" class="detail-section">
              <h2 id="conditions-title">Condiciones</h2>
              <p class="content-paragraph">{course.conditions}</p>
            </section>
          </div>
          <aside class="detail-aside" aria-label="Información del curso">
            <dl>
              <div>
                <dt>Inicio</dt>
                <dd>{civilDate(course.startsAt)}</dd>
              </div>
              <div>
                <dt>Finalización</dt>
                <dd>{civilDate(course.endsAt)}</dd>
              </div>
              <div>
                <dt>Nivel</dt>
                <dd>{levelLabels[course.level]}</dd>
              </div>
              <div>
                <dt>Duración</dt>
                <dd>{course.totalHours} horas</dd>
              </div>
              {course.instructorName?.trim() && (
                <div>
                  <dt>Instructor</dt>
                  <dd>{course.instructorName}</dd>
                </div>
              )}
              {registrationDates && (
                <div class="registration-window">
                  <dt>Ventana de preinscripción</dt>
                  <dd>
                    <span>
                      <span>Abre</span>
                      <strong>{registrationDates.opens}</strong>
                    </span>
                    <span>
                      <span>Cierra</span>
                      <strong>{registrationDates.closes}</strong>
                    </span>
                  </dd>
                </div>
              )}
            </dl>
            <section aria-labelledby="prices-title" class="prices">
              <h2 id="prices-title">Precios</h2>
              <dl>
                {course.prices.map((price) => (
                  <div>
                    <dt>
                      {price.participantType === "STUDENT"
                        ? "Estudiantes"
                        : "Personas externas"}
                    </dt>
                    <dd>Bs {price.amount}</dd>
                  </div>
                ))}
              </dl>
              <p>Importes en bolivianos (BOB).</p>
            </section>
          </aside>
        </div>
        <PublicInterestSection
          slug={slug!}
          form={interestForm}
          values={
            interestPost?.payload.ok
              ? EMPTY_INTEREST_VALUES
              : (interestPost?.values ?? EMPTY_INTEREST_VALUES)
          }
          result={interestPost?.payload}
        />
      </>
    ) : interestPost?.payload.ok ? (
      <section
        class="catalog-state detail-state"
        aria-labelledby="detail-success-title"
        role="status"
      >
        <h1 id="detail-success-title">Gracias por tu interés</h1>
        <p>{INTEREST_SUCCESS_MESSAGE}</p>
      </section>
    ) : (
      <section
        class="catalog-state detail-state"
        aria-labelledby="detail-state-title"
        role={loadError ? "alert" : undefined}
      >
        <h1 id="detail-state-title">
          {loadError
            ? "No pudimos consultar el curso."
            : "Curso no encontrado."}
        </h1>
        <p>
          {loadError
            ? "La consulta no está disponible en este momento. Intenta de nuevo más tarde."
            : "Este curso no está disponible en la cartelera pública. Consulta la oferta vigente."}
        </p>
      </section>
    )}
  </div>
</CourseShell>
