---
import { BadgeCheck, CalendarDays, ClipboardCheck } from "lucide-react";

import { FoundationLink } from "@/components/FoundationLink";
import { ThemeSelector } from "@/components/ThemeSelector";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="SkillBase | Formación continua">
  <header class="mx-auto flex w-full max-w-6xl items-center justify-between px-5 py-5 md:px-8">
    <a
      class="font-semibold tracking-tight"
      href="/"
      aria-label="SkillBase, inicio"
    >
      SkillBase
    </a>
    <ThemeSelector client:load />
  </header>

  <main>
    <section class="mx-auto grid min-h-[calc(100svh-9rem)] w-full max-w-6xl items-center gap-12 px-5 py-14 md:grid-cols-[1.2fr_0.8fr] md:px-8 md:py-20">
      <div class="flex max-w-2xl flex-col items-start gap-7">
        <p class="rounded-full border bg-card px-3 py-1 text-sm font-medium text-muted-foreground shadow-2xs">
          Plataforma en construcción
        </p>
        <div class="flex flex-col gap-5">
          <h1 class="text-balance text-4xl font-semibold leading-[1.08] tracking-[-0.04em] sm:text-5xl lg:text-6xl">
            Formación continua, del registro a la certificación.
          </h1>
          <p class="max-w-xl text-pretty text-base leading-7 text-muted-foreground sm:text-lg">
            Una base operativa para publicar cursos, organizar grupos, registrar
            resultados y emitir credenciales verificables.
          </p>
        </div>
        <FoundationLink />
      </div>

      <aside
        id="foundation"
        class="relative overflow-hidden rounded-xl border bg-card p-6 shadow-lg sm:p-8"
        aria-labelledby="foundation-title"
      >
        <div
          class="absolute inset-x-0 top-0 h-1 bg-primary"
          aria-hidden="true"
        ></div>
        <div class="flex flex-col gap-7">
          <div class="flex flex-col gap-2">
            <p class="font-mono text-sm text-primary">Phase 0 / Foundation</p>
            <h2
              id="foundation-title"
              class="text-2xl font-semibold tracking-tight"
            >
              Sistema listo para crecer
            </h2>
            <p class="text-sm leading-6 text-muted-foreground">
              Las capas iniciales están conectadas sin adelantar reglas de
              negocio.
            </p>
          </div>
          <ul class="flex flex-col gap-5" aria-label="Capacidades de la base">
            <li class="flex gap-4">
              <CalendarDays
                className="mt-0.5 text-primary"
                aria-hidden="true"
              />
              <div>
                <strong class="block text-sm">Operación responsive</strong>
                <span class="text-sm text-muted-foreground">
                  Astro server-side con islas React.
                </span>
              </div>
            </li>
            <li class="flex gap-4">
              <ClipboardCheck
                className="mt-0.5 text-primary"
                aria-hidden="true"
              />
              <div>
                <strong class="block text-sm">Calidad automatizada</strong>
                <span class="text-sm text-muted-foreground">
                  Tipos, lint, pruebas y build reproducible.
                </span>
              </div>
            </li>
            <li class="flex gap-4">
              <BadgeCheck className="mt-0.5 text-primary" aria-hidden="true" />
              <div>
                <strong class="block text-sm">Persistencia preparada</strong>
                <span class="text-sm text-muted-foreground">
                  Supabase local y acceso tipado con Drizzle.
                </span>
              </div>
            </li>
          </ul>
        </div>
      </aside>
    </section>
  </main>

  <footer class="mx-auto flex w-full max-w-6xl flex-col gap-2 border-t px-5 py-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between md:px-8">
    <span>Formación continua y certificación.</span>
    <span class="font-mono">foundation.ready</span>
  </footer>
</BaseLayout>
