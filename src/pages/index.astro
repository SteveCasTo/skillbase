---
import "@fontsource/alef/700.css";
import "@/styles/landing.css";

import { loadPublicCourses } from "@/application/courses/load-public-courses";
import LandingCertificates from "@/components/landing/LandingCertificates.astro";
import LandingCourses from "@/components/landing/LandingCourses.astro";
import LandingFooter from "@/components/landing/LandingFooter.astro";
import LandingHeader from "@/components/landing/LandingHeader.astro";
import LandingHero from "@/components/landing/LandingHero.astro";
import LandingParticipation from "@/components/landing/LandingParticipation.astro";
import {
  previewCourses,
  previewCoursesForCount,
} from "@/components/landing/preview-courses";
import type { PublicCourseDto } from "@/domain/courses/types";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDatabase } from "@/server/db/client";
import { DrizzleCourseRepository } from "@/server/db/repositories/course-repository";
import { isTransientPublicCourseReadError } from "@/server/db/repositories/transient-course-read";

const showDesignPreview = Astro.url.searchParams.get("preview") === "courses";
const showWarmPreview =
  showDesignPreview && Astro.url.searchParams.get("palette") === "warm";
let courses: readonly PublicCourseDto[] = [];
let couldNotLoadCourses = false;

if (showDesignPreview) {
  const requestedCount = Number(Astro.url.searchParams.get("count"));
  courses =
    Number.isInteger(requestedCount) && requestedCount > 0
      ? previewCoursesForCount(requestedCount)
      : previewCourses;
} else {
  try {
    const repository = new DrizzleCourseRepository(getDatabase());
    courses = await loadPublicCourses(repository, {
      isTransientError: isTransientPublicCourseReadError,
    });
  } catch {
    couldNotLoadCourses = true;
  }
}

const featuredCourse =
  courses.find((course) => "featured" in course && course.featured === true) ??
  courses.find(
    ({ registrationAvailability }) => registrationAvailability === "OPEN",
  ) ??
  courses.find(
    ({ registrationAvailability }) => registrationAvailability === "UPCOMING",
  ) ??
  courses[0];
const moreCourses = featuredCourse
  ? courses.filter(({ slug }) => slug !== featuredCourse.slug)
  : [];
---

<BaseLayout
  title="Formación continua | Informática y Sistemas · UMSS"
  description="Consulta la oferta vigente de formación continua del Departamento de Informática y Sistemas de la FCyT, UMSS."
  showToasts={false}
  noindex={showDesignPreview}
  allowSystemTheme={false}
>
  <div class:list={["landing", { "warm-preview": showWarmPreview }]}>
    <LandingHeader />
    <main id="main-content" tabindex="-1">
      <LandingHero />
      <LandingCourses
        {featuredCourse}
        {moreCourses}
        {couldNotLoadCourses}
        showPreviewArtwork={showDesignPreview}
      />
      <LandingParticipation />
      <LandingCertificates />
    </main>
    <LandingFooter />
  </div>
</BaseLayout>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const revealTargets = document.querySelectorAll<HTMLElement>(
    "[data-signal-reveal]",
  );

  if (!reducedMotion.matches && "IntersectionObserver" in window) {
    document.documentElement.classList.add("motion-enhanced");
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -8%", threshold: 0.01 },
    );
    for (const target of revealTargets) revealObserver.observe(target);
  }
</script>
