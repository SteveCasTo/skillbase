---
import "@/styles/public-certificates.css";
import CourseShell from "@/components/public-courses/CourseShell.astro";
import LocalFileVerification from "@/components/certificates/LocalFileVerification.astro";
import VerificationForm from "@/components/certificates/VerificationForm.astro";
import {
  certificateTypeLabel,
  civilDateLabel,
  isPublicCertificateDto,
  publicStateLabel,
  validCredentialCode,
} from "@/components/certificates/presentation";
import { handlePublicCertificateGet } from "@/server/certificates/public-http";
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Content-Type-Options", "nosniff");
if (Astro.request.method !== "GET")
  return new Response(null, {
    status: 405,
    headers: { Allow: "GET", "Cache-Control": "no-store" },
  });
const code = Astro.params.publicCredentialId ?? "";
const response = await handlePublicCertificateGet({
  publicCredentialId: validCredentialCode(code) ? code : "",
  clientAddress: Astro.clientAddress,
});
const payload: unknown = await response.json();
const record = response.ok && isPublicCertificateDto(payload) ? payload : null;
Astro.response.status = record?.state === "not_found" ? 404 : response.status;
const retry = response.headers.get("Retry-After");
if (retry) Astro.response.headers.set("Retry-After", retry);
const publicRecord = record && "recipientName" in record ? record : null;
---

<CourseShell
  title="Verificación de certificado | Formación continua"
  description="Consulta el estado oficial de un certificado."
  noindex
>
  <article
    data-public-verification
    class="flex w-full min-w-0 flex-col gap-8 py-8 sm:py-12"
  >
    <header class="flex flex-col gap-3">
      <h1 class="text-3xl font-semibold tracking-tight">
        {record ? publicStateLabel[record.state] : "Verificación no disponible"}
      </h1>
      {!record && (
        <p class="leading-7 text-muted-foreground">
          {response.status === 429
            ? "Espera un momento antes de volver a consultar."
            : "No se pudo consultar el registro. Intenta de nuevo más tarde."}
        </p>
      )}
    </header>
    {publicRecord && (
      <div class="grid min-w-0 items-start gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
        <section
          class="min-w-0 rounded-xl border bg-card p-5 [overflow-wrap:anywhere] sm:p-7"
          aria-label="Datos públicos del certificado"
        >
          <h2 class="break-words text-2xl font-semibold">
            {publicRecord.recipientName}
          </h2>
          <p class="mt-2 break-words leading-7">{publicRecord.courseName}</p>
          <dl class="mt-6 grid min-w-0 gap-x-8 gap-y-5 sm:grid-cols-2">
            <div>
              <dt class="text-sm text-muted-foreground">Tipo</dt>
              <dd class="mt-1 font-medium">
                {certificateTypeLabel[publicRecord.type]}
              </dd>
            </div>
            <div>
              <dt class="text-sm text-muted-foreground">Duración</dt>
              <dd class="mt-1 font-medium">
                {publicRecord.academicHours} horas académicas
              </dd>
            </div>
            <div>
              <dt class="text-sm text-muted-foreground">
                Finalización del curso
              </dt>
              <dd class="mt-1 font-medium">
                <time datetime={publicRecord.endsOn}>
                  {civilDateLabel(publicRecord.endsOn)}
                </time>
              </dd>
            </div>
            <div>
              <dt class="text-sm text-muted-foreground">Organización</dt>
              <dd class="mt-1 break-words font-medium">
                {publicRecord.organization}
              </dd>
            </div>
            <div class="min-w-0 sm:col-span-2">
              <dt class="text-sm text-muted-foreground">
                SHA-256 oficial del PDF firmado
              </dt>
              <dd class="mt-1 break-all font-mono text-xs leading-6">
                {publicRecord.signedSha256}
              </dd>
            </div>
          </dl>
        </section>
        <LocalFileVerification
          officialHash={publicRecord.signedSha256}
          state={publicRecord.state}
        />
      </div>
    )}
    {(!record || record.state === "not_found") && (
      <details class="border-t pt-4">
        <summary class="min-h-11 cursor-pointer font-medium focus-visible:outline-2 focus-visible:outline-ring">
          Consultar otro certificado
        </summary>
        <div class="mt-4">
          <VerificationForm />
        </div>
      </details>
    )}
  </article>
</CourseShell>
<style>
  h1,
  h2 {
    font-family: var(--font-sans);
  }
</style>
