---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Input } from "@/components/ui/input";
import { buttonVariants } from "@/components/ui/button";
import AuthFormPending from "@/components/auth/AuthFormPending.astro";
const sent = Astro.url.searchParams.get("status") === "recovery_sent";
const emailError =
  Astro.url.searchParams.get("error") === "email"
    ? "Introduce un correo electrónico válido."
    : "";
---

<BaseLayout title="Recuperar contraseña | SkillBase">
  <main class="grid min-h-svh place-items-center px-5 py-12">
    <section
      class="w-full max-w-md rounded-2xl border bg-card p-7 sm:p-9"
      aria-labelledby="recovery-title"
    >
      <a class="text-sm font-semibold text-primary" href="/login">
        Volver al inicio de sesión
      </a>
      <h1
        id="recovery-title"
        class="mt-6 text-3xl font-semibold tracking-tight"
      >
        Recuperar contraseña
      </h1>
      <p class="mt-3 text-sm leading-6 text-muted-foreground">
        Introduce el correo de tu cuenta para solicitar un enlace de
        recuperación.
      </p>
      {sent && (
        <p class="mt-5 rounded-lg border bg-muted p-3 text-sm" role="status">
          Si podemos procesar la solicitud para una cuenta habilitada,
          enviaremos un enlace. Revisa también spam.
        </p>
      )}
      <form
        class="mt-7 flex flex-col gap-5"
        method="post"
        action="/auth/forgot-password"
        data-auth-form
        data-auth-enhanced
        data-astro-reload
      >
        <div class="flex flex-col gap-2">
          <label for="email" class="text-sm font-medium">
            Correo electrónico
          </label>
          <Input
            id="email"
            name="email"
            type="email"
            autoComplete="email"
            required
            maxLength={254}
            aria-describedby="email-error"
            aria-invalid={emailError ? "true" : undefined}
          />
          <p
            id="email-error"
            data-auth-field-error="email"
            class="text-sm text-destructive"
            hidden={!emailError}
          >
            {emailError}
          </p>
        </div>
        <button
          class={buttonVariants({ className: "min-h-11 w-full" })}
          type="submit"
        >
          Enviar enlace
        </button>
      </form>
    </section>
  </main>
  <AuthFormPending />
</BaseLayout>
