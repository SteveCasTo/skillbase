---
import { createFormat } from "@/application/courses/manage-formats";
import CourseBreadcrumbs from "@/components/courses/CourseBreadcrumbs.astro";
import { CourseDomainError } from "@/domain/courses/errors";
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import { requireInternalUser } from "@/server/auth/context";
import { requestHasExpectedOrigin } from "@/server/auth/redirects";
import {
  logCourseInfrastructureError,
  courseDomainStatus,
} from "@/server/courses/errors";
import { getDatabase } from "@/server/db/client";
import { CourseInfrastructureError } from "@/server/db/repositories/course-infrastructure-error";
import { DrizzleFormatRepository } from "@/server/db/repositories/format-repository";
import { getPublicAuthEnvironment } from "@/server/environment";

const user = requireInternalUser(Astro.locals);
const wantsJson = Astro.request.headers
  .get("accept")
  ?.includes("application/json");
const json = (body: object, status: number) =>
  new Response(JSON.stringify(body), {
    status,
    headers: {
      "Content-Type": "application/json",
      "Cache-Control": "private, no-store",
    },
  });
void json;
let values: Record<string, string> = {};
let errors: Readonly<Record<string, string>> = {};
let pageError: string | null = null;
if (Astro.request.method === "POST") {
  if (
    !requestHasExpectedOrigin(Astro.request, getPublicAuthEnvironment().siteUrl)
  ) {
    Astro.response.status = 403;
    pageError =
      "La solicitud no tiene un origen válido. Recarga la página e inténtalo de nuevo.";
  } else {
    const data = await Astro.request.formData();
    values = Object.fromEntries(
      [
        "name",
        "totalHours",
        "sessionMinutes",
        "studentAmount",
        "externalAmount",
      ].map((key) => [
        key,
        typeof data.get(key) === "string" ? String(data.get(key)) : "",
      ]),
    );
    try {
      const created = await createFormat(
        new DrizzleFormatRepository(getDatabase()),
        user,
        {
          name: values.name ?? "",
          totalHours: values.totalHours ?? "",
          sessionMinutes: values.sessionMinutes ?? "",
          studentAmount: values.studentAmount ?? "",
          externalAmount: values.externalAmount ?? "",
        },
      );
      void created; // Astro's frontmatter checker omits references inside returned responses.
      if (wantsJson) return json({ id: created.id }, 201);
      return Astro.redirect("/app/formatos?success=created", 303);
    } catch (error) {
      if (error instanceof CourseDomainError) {
        Astro.response.status = courseDomainStatus(error);
        errors = error.fieldErrors;
        pageError = error.message;
      } else {
        Astro.response.status = 500;
        pageError = "No se pudo crear el formato. Inténtalo nuevamente.";
        if (error instanceof CourseInfrastructureError)
          logCourseInfrastructureError(error, { actorId: user.id });
      }
    }
  }
  if (wantsJson)
    return json({ message: pageError, errors }, Astro.response.status);
}
const fields = [
  {
    key: "name",
    label: "Nombre",
    hint: "Un nombre reconocible al seleccionar el formato en un curso.",
    pattern: ".*\\S.*",
    inputmode: undefined,
  },
  {
    key: "totalHours",
    label: "Duración total (horas)",
    hint: "Número entero positivo de horas.",
    pattern: "[1-9][0-9]*",
    inputmode: "numeric" as const,
  },
  {
    key: "sessionMinutes",
    label: "Duración de sesión (minutos)",
    hint: "Entre 15 y 480 minutos por día hábil.",
    pattern: "(?:1[5-9]|[2-9][0-9]|[1-3][0-9]{2}|4[0-7][0-9]|480)",
    inputmode: "numeric" as const,
  },
  {
    key: "studentAmount",
    label: "Precio estudiante (BOB)",
    hint: "Usa punto decimal y hasta dos decimales; por ejemplo, 80.50.",
    pattern: "(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,2})?",
    inputmode: "decimal" as const,
  },
  {
    key: "externalAmount",
    label: "Precio externo (BOB)",
    hint: "Usa punto decimal y hasta dos decimales; por ejemplo, 100.00.",
    pattern: "(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,2})?",
    inputmode: "decimal" as const,
  },
];
---

<PrivateLayout title="Nuevo formato">
  <header>
    <CourseBreadcrumbs current="Nuevo formato" />
    <h1 class="mt-5 text-3xl font-semibold tracking-tight sm:text-4xl">
      Nuevo formato
    </h1>
    <p class="mt-3 leading-7 text-muted-foreground">
      Define un nombre, duración y los dos precios en bolivianos. Los cursos que
      elijan este formato usarán sus valores vigentes.
    </p>
  </header>
  {pageError && (
    <p
      role="alert"
      class="mt-7 rounded-lg border border-destructive/40 p-4 text-sm text-destructive"
    >
      {pageError}
    </p>
  )}
  <form
    method="post"
    aria-label="Crear formato"
    class="mt-8 grid gap-6 rounded-xl border bg-card p-5 sm:grid-cols-2 sm:p-7 lg:grid-cols-3"
  >
    {fields.map((field) => (
      <div
        class:list={[
          "text-sm",
          field.key === "name" && "sm:col-span-2 lg:col-span-3",
        ]}
      >
        <label for={field.key} class="font-semibold">
          {field.label}
        </label>
        <p
          id={`${field.key}-hint`}
          class="mt-1 text-xs leading-5 text-muted-foreground"
        >
          {field.hint}
        </p>
        <input
          id={field.key}
          name={field.key}
          type="text"
          required
          pattern={field.pattern}
          inputmode={field.inputmode}
          value={values[field.key] ?? ""}
          aria-invalid={Boolean(errors[field.key])}
          aria-describedby={`${field.key}-hint${errors[field.key] ? ` ${field.key}-error` : ""}`}
          class="mt-2 min-h-11 w-full rounded-lg border bg-background px-3 py-2 focus-visible:outline-2 focus-visible:outline-ring"
        />
        {errors[field.key] && (
          <p id={`${field.key}-error`} class="mt-1 text-destructive">
            {errors[field.key]}
          </p>
        )}
      </div>
    ))}
    <div class="flex flex-wrap gap-3 sm:col-span-2 lg:col-span-3">
      <button
        type="submit"
        class="min-h-11 rounded-lg bg-primary px-5 text-sm font-semibold text-primary-foreground focus-visible:outline-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-40"
      >
        Crear formato
      </button>
      <a
        href="/app/formatos"
        class="inline-flex min-h-11 items-center rounded-lg border px-5 text-sm font-semibold hover:bg-secondary"
      >
        Cancelar
      </a>
    </div>
  </form>
  <p
    data-create-error
    role="alert"
    tabindex="-1"
    hidden
    class="mt-4 rounded-lg border border-destructive/40 p-4 text-sm text-destructive"
  ></p>
  <script>
    import { navigate } from "astro:transitions/client";
    import { notifications } from "@/lib/notifications";
    import { isUuid } from "@/domain/courses/mutation-result";
    document.addEventListener("astro:page-load", () => {
      const form = document.querySelector<HTMLFormElement>(
        'form[aria-label="Crear formato"]',
      );
      if (form) {
        const button = form.querySelector<HTMLButtonElement>(
          'button[type="submit"]',
        );
        const inputs = Array.from(
          form.querySelectorAll<HTMLInputElement>('input[type="text"]'),
        );
        if (button) {
          let pending = false;
          form.addEventListener("submit", (event) => {
            event.preventDefault();
            if (!form.reportValidity() || pending || button.disabled) return;
            pending = true;
            button.disabled = true;
            button.setAttribute("aria-busy", "true");
            const error = document.querySelector<HTMLElement>(
              "[data-create-error]",
            );
            if (error) error.hidden = true;
            form
              .querySelectorAll<HTMLElement>("[data-async-error]")
              .forEach((item) => item.remove());
            inputs.forEach((input) => {
              input.removeAttribute("aria-invalid");
              input.setAttribute("aria-describedby", `${input.name}-hint`);
            });
            void notifications
              .promise(
                async () => {
                  try {
                    const response = await fetch("/app/formatos/nuevo", {
                      method: "POST",
                      body: new FormData(form),
                      headers: { Accept: "application/json" },
                    });
                    if (
                      response.redirected ||
                      !response.headers
                        .get("content-type")
                        ?.includes("application/json")
                    )
                      throw new Error(
                        "La sesión cambió. Recarga la página e inténtalo de nuevo.",
                      );
                    const result: unknown = await response.json();
                    if (
                      !response.ok &&
                      result &&
                      typeof result === "object" &&
                      "errors" in result &&
                      result.errors &&
                      typeof result.errors === "object"
                    ) {
                      for (const [name, message] of Object.entries(
                        result.errors,
                      )) {
                        if (typeof message !== "string") continue;
                        const input = inputs.find((item) => item.name === name);
                        if (!input) continue;
                        const hint = document.createElement("p");
                        hint.dataset.asyncError = name;
                        hint.id = `${name}-async-error`;
                        hint.className = "mt-1 text-sm text-destructive";
                        hint.textContent = message;
                        input.parentElement?.append(hint);
                        input.setAttribute("aria-invalid", "true");
                        input.setAttribute(
                          "aria-describedby",
                          `${name}-hint ${hint.id}`,
                        );
                      }
                    }
                    if (
                      !response.ok ||
                      !result ||
                      typeof result !== "object" ||
                      !("id" in result) ||
                      !isUuid(result.id)
                    )
                      throw new Error(
                        result &&
                          typeof result === "object" &&
                          "message" in result &&
                          typeof result.message === "string"
                          ? result.message
                          : "No se pudo crear el formato.",
                      );
                    await navigate("/app/formatos");
                  } catch (failure) {
                    if (error) {
                      error.textContent =
                        failure instanceof Error
                          ? failure.message
                          : "No se pudo crear el formato.";
                      error.hidden = false;
                      error.focus();
                    }
                    throw failure;
                  } finally {
                    pending = false;
                    button.removeAttribute("aria-busy");
                    update();
                  }
                },
                {
                  loading: { title: "Creando formato…" },
                  success: { title: "Formato creado." },
                  error: (failure) => ({
                    title:
                      failure instanceof Error
                        ? failure.message
                        : "No se pudo crear el formato.",
                  }),
                },
              )
              .catch(() => {});
          });
          const allowed = (kind: string, value: string) => {
            if (kind === "name")
              return !Array.from(value).some(
                (character) =>
                  character.charCodeAt(0) < 32 ||
                  character.charCodeAt(0) === 127,
              );
            if (kind === "sessionMinutes")
              return (
                value === "" ||
                (/^\d{1,3}$/.test(value) && Number(value) <= 480)
              );
            if (kind === "totalHours")
              return (
                value === "" ||
                (/^(?:0|[1-9]\d{0,9})$/.test(value) &&
                  Number(value) <= 2147483647)
              );
            return (
              value === "" || /^(?:0|[1-9]\d{0,9})(?:\.\d{0,2})?$/.test(value)
            );
          };
          const update = () => {
            button.disabled =
              pending ||
              !inputs.every(
                (input) =>
                  input.value.trim() !== "" &&
                  input.checkValidity() &&
                  allowed(input.name, input.value),
              );
          };
          inputs.forEach((input) => {
            let previous = input.value;
            const valid = (value: string) => allowed(input.name, value);
            const insert = (text: string) =>
              valid(
                input.value.slice(
                  0,
                  input.selectionStart ?? input.value.length,
                ) +
                  text +
                  input.value.slice(input.selectionEnd ?? input.value.length),
              );
            input.addEventListener("beforeinput", (event) => {
              if (!event.isComposing && event.data && !insert(event.data))
                event.preventDefault();
            });
            input.addEventListener("paste", (event) => {
              if (!insert(event.clipboardData?.getData("text") ?? ""))
                event.preventDefault();
            });
            input.addEventListener("drop", (event) => {
              if (!insert(event.dataTransfer?.getData("text") ?? ""))
                event.preventDefault();
            });
            input.addEventListener("input", () => {
              if (valid(input.value)) previous = input.value;
              else input.value = previous;
              update();
            });
            input.addEventListener("compositionend", () => {
              if (valid(input.value)) previous = input.value;
              else input.value = previous;
              update();
            });
            input.addEventListener("change", update);
          });
          update();
        }
      }
    });
  </script>
</PrivateLayout>
