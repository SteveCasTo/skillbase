---
import { Check, Pencil, X } from "lucide-react";
import {
  deleteFormat,
  getFormat,
  renameFormat,
  reviseFormat,
  setFormatActive,
} from "@/application/courses/manage-formats";
import type { CourseFormat } from "@/domain/courses/formats";
import { CourseDomainError } from "@/domain/courses/errors";
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import { requireInternalUser } from "@/server/auth/context";
import { requestHasExpectedOrigin } from "@/server/auth/redirects";
import {
  logCourseInfrastructureError,
  courseDomainStatus,
} from "@/server/courses/errors";
import { getDatabase } from "@/server/db/client";
import { CourseInfrastructureError } from "@/server/db/repositories/course-infrastructure-error";
import { DrizzleFormatRepository } from "@/server/db/repositories/format-repository";
import { getPublicAuthEnvironment } from "@/server/environment";

const user = requireInternalUser(Astro.locals);
const id = Astro.params.id ?? "";
const validId = /^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$/i.test(id);
const repository = new DrizzleFormatRepository(getDatabase());
const wantsJson = Astro.request.headers
  .get("accept")
  ?.includes("application/json");
let format: CourseFormat | null = null;
let pageError: string | null = null;
let errors: Readonly<Record<string, string>> = {};
let editing = "";
let attemptedValue = "";
let loadError = false;
if (!validId) Astro.response.status = 404;
else {
  try {
    format = await getFormat(repository, user, id);
    if (!format) Astro.response.status = 404;
  } catch (error) {
    Astro.response.status = 500;
    loadError = true;
    if (error instanceof CourseInfrastructureError)
      logCourseInfrastructureError(error, { actorId: user.id });
  }
}
const text = (data: FormData, key: string) =>
  typeof data.get(key) === "string" ? String(data.get(key)) : "";
if (format && Astro.request.method === "POST") {
  if (
    !requestHasExpectedOrigin(Astro.request, getPublicAuthEnvironment().siteUrl)
  ) {
    Astro.response.status = 403;
    pageError =
      "La solicitud no tiene un origen válido. Recarga la página e inténtalo de nuevo.";
  } else {
    const data = await Astro.request.formData();
    const intent = text(data, "intent");
    editing = text(data, "field");
    attemptedValue = text(data, "value");
    const revisionId = text(data, "revisionId");
    const updatedAt = text(data, "updatedAt");
    try {
      if (intent === "rename" && editing === "name") {
        await renameFormat(
          repository,
          user,
          id,
          attemptedValue,
          revisionId,
          updatedAt,
        );
      } else if (
        intent === "revise" &&
        [
          "totalHours",
          "sessionMinutes",
          "studentAmount",
          "externalAmount",
        ].includes(editing)
      ) {
        await reviseFormat(
          repository,
          user,
          id,
          {
            totalHours:
              editing === "totalHours"
                ? attemptedValue
                : String(format.totalHours),
            ...(editing === "sessionMinutes"
              ? { sessionMinutes: attemptedValue }
              : format.sessionMinutes !== null
                ? { sessionMinutes: String(format.sessionMinutes) }
                : {}),
            studentAmount:
              editing === "studentAmount"
                ? attemptedValue
                : format.studentAmount,
            externalAmount:
              editing === "externalAmount"
                ? attemptedValue
                : format.externalAmount,
          },
          revisionId,
          updatedAt,
        );
      } else if (intent === "activate" || intent === "deactivate") {
        await setFormatActive(
          repository,
          user,
          id,
          intent === "activate",
          revisionId,
          updatedAt,
        );
      } else if (intent === "delete") {
        await deleteFormat(repository, user, id, revisionId, updatedAt);
        if (wantsJson)
          return new Response(JSON.stringify({ deleted: true }), {
            headers: { "Content-Type": "application/json" },
          });
        return Astro.redirect("/app/formatos?success=deleted", 303);
      } else {
        Astro.response.status = 400;
        pageError = "La acción solicitada no es válida.";
      }
      if (!pageError && wantsJson && intent !== "delete") {
        return new Response(
          JSON.stringify({ format: await getFormat(repository, user, id) }),
          {
            headers: { "Content-Type": "application/json" },
          },
        );
      }
      if (!pageError)
        return Astro.redirect(`/app/formatos/${id}?success=${intent}`, 303);
    } catch (error) {
      if (error instanceof CourseDomainError) {
        Astro.response.status =
          error.code === "FORMAT_NOT_FOUND" ? 404 : courseDomainStatus(error);
        errors = error.fieldErrors;
        pageError = error.message;
      } else {
        Astro.response.status = 500;
        pageError = "No se pudo guardar el cambio. Inténtalo nuevamente.";
        if (error instanceof CourseInfrastructureError)
          logCourseInfrastructureError(error, { actorId: user.id });
      }
    }
  }
}
if (wantsJson && Astro.request.method === "POST")
  return new Response(JSON.stringify({ message: pageError, errors }), {
    status: Astro.response.status,
    headers: { "Content-Type": "application/json" },
  });
const fields = format
  ? [
      {
        key: "name",
        label: "Nombre",
        value: format.name,
        intent: "rename",
        pattern: ".*\\S.*",
        mode: undefined,
      },
      {
        key: "totalHours",
        label: "Duración total",
        value: String(format.totalHours),
        intent: "revise",
        pattern: "[1-9][0-9]*",
        mode: "numeric" as const,
        suffix: "horas",
      },
      {
        key: "sessionMinutes",
        label: "Duración de sesión",
        value:
          format.sessionMinutes === null
            ? "Sin definir"
            : String(format.sessionMinutes),
        intent: "revise",
        pattern: "(?:1[5-9]|[2-9][0-9]|[1-3][0-9]{2}|4[0-7][0-9]|480)",
        mode: "numeric" as const,
        suffix: "minutos",
      },
      {
        key: "studentAmount",
        label: "Precio estudiante",
        value: format.studentAmount,
        intent: "revise",
        pattern: "(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,2})?",
        mode: "decimal" as const,
        suffix: "BOB",
      },
      {
        key: "externalAmount",
        label: "Precio externo",
        value: format.externalAmount,
        intent: "revise",
        pattern: "(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,2})?",
        mode: "decimal" as const,
        suffix: "BOB",
      },
    ]
  : [];
const success: Record<string, string> = {
  rename: "Nombre actualizado.",
  revise: "Nueva revisión guardada. Los borradores usan los valores vigentes.",
  activate: "Formato activado.",
  deactivate: "Formato desactivado.",
};
const successKey = Astro.url.searchParams.get("success");
---

<PrivateLayout title={format ? format.name : "Formato"}>
  <nav aria-label="Ruta de navegación" class="text-sm text-muted-foreground">
    <ol class="flex flex-wrap items-center gap-2">
      <li>
        <a href="/app" class="hover:underline">
          Resumen
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li>
        <a href="/app/cursos" class="hover:underline">
          Cursos
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li>
        <a href="/app/formatos" class="hover:underline">
          Formatos
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="font-medium text-foreground">
        {format?.name ?? "Detalle"}
      </li>
    </ol>
  </nav>
  {loadError ? (
    <p role="alert" class="mt-8 text-destructive">
      No se pudo cargar el formato. Inténtalo nuevamente.
    </p>
  ) : !format ? (
    <section class="mt-8">
      <h1 class="text-3xl font-semibold">Formato no encontrado</h1>
      <a href="/app/formatos" class="mt-4 inline-block underline">
        Ver formatos
      </a>
    </section>
  ) : (
    <>
      <header class="mt-5 flex flex-wrap items-center justify-between gap-4">
        <div class="min-w-0">
          <h1 class="break-words text-3xl font-semibold tracking-tight sm:text-4xl">
            {format.name}
          </h1>
          <p
            data-format-status
            class="mt-2 text-sm font-medium text-muted-foreground"
          >
            {format.active ? "Activo" : "Inactivo"}
          </p>
        </div>
        <div data-format-action>
          {format.used && (
            <form method="post" data-action-form hidden={format.active}>
              <input
                type="hidden"
                name="revisionId"
                value={format.revisionId}
              />
              <input type="hidden" name="updatedAt" value={format.updatedAt} />
              <input type="hidden" name="intent" value="activate" />
              <button
                type="submit"
                class="min-h-11 rounded-lg border px-4 text-sm font-semibold hover:bg-secondary focus-visible:outline-2 focus-visible:outline-ring"
              >
                Activar formato
              </button>
            </form>
          )}
          <>
            <button
              type="button"
              data-action-trigger
              hidden
              class="min-h-11 rounded-lg border border-destructive px-4 text-sm font-semibold text-destructive hover:bg-destructive/10 focus-visible:outline-2 focus-visible:outline-ring"
            >
              {format.used ? "Desactivar formato" : "Eliminar formato"}
            </button>
            <details
              data-action-fallback
              hidden={format.used && !format.active}
            >
              <summary class="flex min-h-11 cursor-pointer list-none items-center rounded-lg border border-destructive px-4 text-sm font-semibold text-destructive focus-visible:outline-2 focus-visible:outline-ring [&::-webkit-details-marker]:hidden">
                {format.used ? "Desactivar formato" : "Eliminar formato"}
              </summary>
              <div class="mt-3 rounded-lg border bg-card p-4">
                <p class="text-sm">
                  {format.used
                    ? "No se podrá elegir este formato en nuevos cursos."
                    : "Se eliminará el formato y todas sus revisiones sin uso. No se puede deshacer."}
                </p>
                <form method="post" class="mt-3 flex flex-wrap gap-2">
                  <input
                    type="hidden"
                    name="revisionId"
                    value={format.revisionId}
                  />
                  <input
                    type="hidden"
                    name="updatedAt"
                    value={format.updatedAt}
                  />
                  <input
                    type="hidden"
                    name="intent"
                    value={format.used ? "deactivate" : "delete"}
                  />
                  <button
                    type="submit"
                    class="min-h-11 rounded-lg border border-destructive px-4 text-sm font-semibold text-destructive"
                  >
                    {format.used
                      ? "Sí, desactivar formato"
                      : "Sí, eliminar formato"}
                  </button>
                  <a
                    href={`/app/formatos/${id}`}
                    class="inline-flex min-h-11 items-center rounded-lg border px-4 text-sm font-medium focus-visible:outline-2 focus-visible:outline-ring"
                  >
                    Cancelar
                  </a>
                </form>
              </div>
            </details>
          </>
        </div>
      </header>
      <dialog
        data-action-dialog
        aria-labelledby="action-dialog-title"
        aria-describedby="action-dialog-description"
        class="m-auto w-[min(28rem,calc(100%-2rem))] rounded-xl border bg-card p-6 text-card-foreground shadow-xl backdrop:bg-foreground/40"
      >
        <h2 id="action-dialog-title" class="text-lg font-semibold">
          {format.used ? "¿Desactivar formato?" : "¿Eliminar formato?"}
        </h2>
        <p
          id="action-dialog-description"
          class="mt-2 text-sm leading-6 text-muted-foreground"
        >
          {format.used
            ? "No se podrá elegir este formato en nuevos cursos."
            : "Se eliminará el formato y todas sus revisiones sin uso. No se puede deshacer."}
        </p>
        <form
          method="post"
          data-dialog-form
          class="mt-5 flex flex-wrap justify-end gap-2"
        >
          <input type="hidden" name="revisionId" value={format.revisionId} />
          <input type="hidden" name="updatedAt" value={format.updatedAt} />
          <input
            type="hidden"
            name="intent"
            value={format.used ? "deactivate" : "delete"}
          />
          <button
            type="button"
            data-dialog-cancel
            class="min-h-11 rounded-lg border px-4 text-sm font-medium focus-visible:outline-2 focus-visible:outline-ring"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="min-h-11 rounded-lg bg-destructive px-4 text-sm font-semibold text-destructive-foreground focus-visible:outline-2 focus-visible:outline-ring"
          >
            {format.used ? "Sí, desactivar formato" : "Sí, eliminar formato"}
          </button>
        </form>
      </dialog>
      <p
        data-action-error
        role="alert"
        tabindex="-1"
        hidden
        class="mt-4 rounded-lg border border-destructive/40 p-4 text-sm text-destructive"
      ></p>
      {successKey && success[successKey] && (
        <noscript>
          <p
            role="status"
            class="mt-6 rounded-lg border bg-secondary p-4 text-sm"
          >
            {success[successKey]}
          </p>
        </noscript>
      )}
      {pageError && (
        <p
          role="alert"
          class="mt-6 rounded-lg border border-destructive/40 p-4 text-sm text-destructive"
        >
          {pageError}
        </p>
      )}
      <div class="mt-8">
        <section
          aria-labelledby="values-title"
          class="rounded-xl border bg-card p-5 sm:p-7"
        >
          <h2 id="values-title" class="text-xl font-semibold">
            Datos del formato
          </h2>
          <dl class="mt-5 grid gap-x-8 sm:grid-cols-2 xl:grid-cols-3">
            {fields.map((field) => (
              <div class="min-w-0 border-t py-4">
                <dt class="text-sm text-muted-foreground">{field.label}</dt>
                <dd class="mt-1 flex min-h-11 min-w-0 items-center gap-2">
                  <span
                    data-format-value={field.key}
                    class="min-w-0 flex-1 break-words font-semibold tabular-nums [&:has(+details[open])]:hidden"
                  >
                    {field.value} {field.suffix ?? ""}
                  </span>
                  <details
                    hidden={!format.active}
                    open={editing === field.key && Boolean(pageError)}
                    class="group ml-auto shrink-0 [&:not([open])>form]:hidden open:min-w-0 open:flex-1"
                  >
                    <summary
                      aria-label={`Editar ${field.label.toLowerCase()}`}
                      title={`Editar ${field.label.toLowerCase()}`}
                      class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-lg border hover:bg-secondary focus-visible:outline-2 focus-visible:outline-ring group-open:hidden [&::-webkit-details-marker]:hidden"
                    >
                      <Pencil size={18} aria-hidden="true" />
                    </summary>
                    <form
                      method="post"
                      aria-label={`Editar ${field.label.toLowerCase()}`}
                      class="flex min-w-0 items-center gap-1.5 sm:gap-2"
                    >
                      <input type="hidden" name="intent" value={field.intent} />
                      <input type="hidden" name="field" value={field.key} />
                      <input
                        type="hidden"
                        name="revisionId"
                        value={format.revisionId}
                      />
                      <input
                        type="hidden"
                        name="updatedAt"
                        value={format.updatedAt}
                      />
                      <div class="min-w-0 flex-1">
                        <label for={`edit-${field.key}`} class="sr-only">
                          {field.key === "totalHours" ||
                          field.key === "sessionMinutes"
                            ? "Nueva"
                            : "Nuevo"}{" "}
                          {field.label.toLowerCase()}
                        </label>
                        <input
                          id={`edit-${field.key}`}
                          name="value"
                          type="text"
                          required
                          pattern={field.pattern}
                          inputmode={field.mode}
                          value={
                            editing === field.key && pageError
                              ? attemptedValue
                              : field.value
                          }
                          data-persisted-value={field.value}
                          aria-invalid={Boolean(errors[field.key])}
                          aria-describedby={
                            errors[field.key] ? `error-${field.key}` : undefined
                          }
                          data-format-filter={field.key}
                          class="min-h-11 w-full min-w-0 rounded-lg border bg-background px-2 py-2 text-sm focus-visible:outline-2 focus-visible:outline-ring sm:px-3"
                        />
                        {errors[field.key] && editing === field.key && (
                          <p
                            id={`error-${field.key}`}
                            class="mt-1 text-sm text-destructive"
                          >
                            {errors[field.key]}
                          </p>
                        )}
                      </div>
                      <button
                        type="submit"
                        aria-label={`Guardar ${field.label.toLowerCase()}`}
                        title="Guardar"
                        class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground focus-visible:outline-2 focus-visible:outline-ring"
                      >
                        <Check size={18} aria-hidden="true" />
                      </button>
                      <button
                        type="button"
                        data-cancel-edit
                        hidden
                        aria-label={`Cancelar edición de ${field.label.toLowerCase()}`}
                        title="Cancelar"
                        class="min-h-11 min-w-11 shrink-0 items-center justify-center rounded-lg border focus-visible:outline-2 focus-visible:outline-ring"
                      >
                        <X size={18} aria-hidden="true" />
                      </button>
                      <a
                        href={`/app/formatos/${id}`}
                        aria-label={`Cancelar edición de ${field.label.toLowerCase()}`}
                        title="Cancelar"
                        class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-lg border focus-visible:outline-2 focus-visible:outline-ring"
                        data-cancel-fallback
                      >
                        <X size={18} aria-hidden="true" />
                      </a>
                    </form>
                  </details>
                </dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    </>
  )}
  <script>
    import { navigate } from "astro:transitions/client";
    import { sileo } from "sileo";
    document.addEventListener("astro:page-load", () => {
      type FormatResult = {
        name: string;
        active: boolean;
        used: boolean;
        totalHours: number;
        sessionMinutes: number | null;
        studentAmount: string;
        externalAmount: string;
        revisionId: string;
        updatedAt: string;
      };
      type MutationResult = {
        format?: FormatResult;
        deleted?: boolean;
        message?: string;
        errors?: Record<string, string>;
      };
      const mutation = async (form: HTMLFormElement, field?: string) => {
        const response = await fetch(window.location.pathname, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        if (
          response.redirected ||
          !response.headers.get("content-type")?.includes("application/json")
        )
          throw new Error(
            "La sesión cambió. Recarga la página e inténtalo de nuevo.",
          );
        const result = (await response.json()) as MutationResult;
        if (!response.ok)
          throw new Error(
            (field && result.errors?.[field]) ||
              result.message ||
              "No se pudo guardar el cambio. Inténtalo nuevamente.",
          );
        return result;
      };
      const renderFormat = (current: FormatResult) => {
        document
          .querySelectorAll<HTMLInputElement>('input[name="revisionId"]')
          .forEach((control) => (control.value = current.revisionId));
        document
          .querySelectorAll<HTMLInputElement>('input[name="updatedAt"]')
          .forEach((control) => (control.value = current.updatedAt));
        for (const key of [
          "name",
          "totalHours",
          "sessionMinutes",
          "studentAmount",
          "externalAmount",
        ] as const) {
          const value = String(current[key]);
          const label = document.querySelector<HTMLElement>(
            `[data-format-value="${key}"]`,
          );
          if (label)
            label.textContent = `${current[key] === null ? "Sin definir" : value}${key === "totalHours" ? " horas" : key === "sessionMinutes" && current[key] !== null ? " minutos" : key.endsWith("Amount") ? " BOB" : ""}`;
          const control = document.querySelector<HTMLInputElement>(
            `#edit-${key}`,
          );
          if (control) {
            control.value = value;
            control.dataset.persistedValue = value;
          }
        }
        document.querySelector("main h1")!.textContent = current.name;
        document.querySelector<HTMLElement>(
          'nav[aria-label="Ruta de navegación"] [aria-current="page"]',
        )!.textContent = current.name;
        document.querySelector<HTMLElement>(
          "[data-format-status]",
        )!.textContent = current.active ? "Activo" : "Inactivo";
        document
          .querySelectorAll<HTMLDetailsElement>("dd details")
          .forEach((details) => {
            details.open = false;
            details.hidden = !current.active;
          });
        const action = document.querySelector<HTMLElement>(
          "[data-format-action]",
        );
        const actionForm =
          action?.querySelector<HTMLFormElement>("[data-action-form]");
        const trigger = action?.querySelector<HTMLButtonElement>(
          "[data-action-trigger]",
        );
        const fallback = action?.querySelector<HTMLDetailsElement>(
          "[data-action-fallback]",
        );
        if (actionForm) actionForm.hidden = current.active;
        if (trigger) trigger.hidden = !current.active;
        if (fallback) fallback.hidden = true;
        document.title = `${current.name} | SkillBase`;
      };

      // Keep the HTML forms authoritative: filtering only assists input, never replaces server validation.
      const allowed = (kind: string, value: string) => {
        if (kind === "name")
          return !Array.from(value).some(
            (character) =>
              character.charCodeAt(0) < 32 || character.charCodeAt(0) === 127,
          );
        if (kind === "sessionMinutes")
          return (
            value === "" || (/^\d{1,3}$/.test(value) && Number(value) <= 480)
          );
        if (kind === "totalHours")
          return (
            value === "" ||
            (/^(?:0|[1-9]\d{0,9})$/.test(value) && Number(value) <= 2147483647)
          );
        return value === "" || /^(?:0|[1-9]\d{0,9})(?:\.\d{0,2})?$/.test(value);
      };
      document
        .querySelectorAll<HTMLInputElement>("[data-format-filter]")
        .forEach((input) => {
          let previous = input.value;
          const valid = (value: string) =>
            allowed(input.dataset.formatFilter ?? "", value);
          const insert = (text: string) =>
            valid(
              input.value.slice(0, input.selectionStart ?? input.value.length) +
                text +
                input.value.slice(input.selectionEnd ?? input.value.length),
            );
          input.addEventListener("beforeinput", (event) => {
            if (!event.isComposing && event.data && !insert(event.data))
              event.preventDefault();
          });
          input.addEventListener("paste", (event) => {
            if (!insert(event.clipboardData?.getData("text") ?? ""))
              event.preventDefault();
          });
          input.addEventListener("drop", (event) => {
            if (!insert(event.dataTransfer?.getData("text") ?? ""))
              event.preventDefault();
          });
          input.addEventListener("input", () => {
            if (valid(input.value)) previous = input.value;
            else input.value = previous;
          });
          input.addEventListener("compositionend", () => {
            if (valid(input.value)) previous = input.value;
            else input.value = previous;
          });
        });
      document
        .querySelectorAll<HTMLDetailsElement>("dd details")
        .forEach((details) => {
          const cancel =
            details.querySelector<HTMLButtonElement>("[data-cancel-edit]");
          const fallback = details.querySelector<HTMLAnchorElement>(
            "[data-cancel-fallback]",
          );
          if (!cancel || !fallback) return;
          cancel.hidden = false;
          cancel.classList.add("inline-flex");
          fallback.hidden = true;
          const input = details.querySelector<HTMLInputElement>(
            'input[name="value"]',
          );
          details.addEventListener("toggle", () => {
            if (details.open) input?.focus();
          });
          cancel.addEventListener("click", () => {
            if (input)
              input.value = input.dataset.persistedValue ?? input.defaultValue;
            details.open = false;
            details.querySelector<HTMLElement>("summary")?.focus();
          });
          const form = details.querySelector<HTMLFormElement>("form");
          form?.addEventListener("submit", (event) => {
            event.preventDefault();
            const field = form.querySelector<HTMLInputElement>(
              'input[name="field"]',
            )?.value;
            const submit = form.querySelector<HTMLButtonElement>(
              'button[type="submit"]',
            );
            if (!field || !input || !submit || !form.reportValidity()) return;
            submit.disabled = true;
            submit.setAttribute("aria-busy", "true");
            form.querySelector<HTMLElement>(`#error-${field}`)?.remove();
            input.removeAttribute("aria-invalid");
            input.removeAttribute("aria-describedby");
            void (async () => {
              try {
                const result = await mutation(form, field);
                if (!result.format) {
                  const message =
                    "No se pudo guardar el cambio. Inténtalo nuevamente.";
                  const error = document.createElement("p");
                  error.id = `error-${field}`;
                  error.className = "mt-1 text-sm text-destructive";
                  error.textContent = message;
                  input.parentElement?.append(error);
                  input.setAttribute("aria-invalid", "true");
                  input.setAttribute("aria-describedby", error.id);
                  return;
                }
                renderFormat(result.format);
                details.open = false;
                details.querySelector<HTMLElement>("summary")?.focus();
                sileo.success({
                  title:
                    field === "name"
                      ? "Nombre actualizado."
                      : "Nueva revisión guardada. Los borradores usan los valores vigentes.",
                  duration: 6000,
                });
              } catch (failure) {
                const error = document.createElement("p");
                error.id = `error-${field}`;
                error.className = "mt-1 text-sm text-destructive";
                error.textContent =
                  failure instanceof Error
                    ? failure.message
                    : "No se pudo guardar el cambio. Inténtalo nuevamente.";
                input.parentElement?.append(error);
                input.setAttribute("aria-invalid", "true");
                input.setAttribute("aria-describedby", error.id);
              } finally {
                submit.disabled = false;
                submit.removeAttribute("aria-busy");
              }
            })();
          });
        });
      const trigger = document.querySelector<HTMLButtonElement>(
        "[data-action-trigger]",
      );
      const fallback = document.querySelector<HTMLDetailsElement>(
        "[data-action-fallback]",
      );
      const dialog = document.querySelector<HTMLDialogElement>(
        "[data-action-dialog]",
      );
      const error = document.querySelector<HTMLElement>("[data-action-error]");
      const actionForm =
        document.querySelector<HTMLFormElement>("[data-action-form]");
      const dialogForm =
        document.querySelector<HTMLFormElement>("[data-dialog-form]");
      if (fallback && trigger) {
        fallback.hidden = true;
        trigger.hidden = Boolean(actionForm && !actionForm.hidden);
      }
      trigger?.addEventListener("click", () => dialog?.showModal());
      dialog
        ?.querySelector<HTMLButtonElement>("[data-dialog-cancel]")
        ?.addEventListener("click", () => dialog.close());
      dialog?.addEventListener("close", () => trigger?.focus());
      const submitAction = (form: HTMLFormElement) => {
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          const submit = form.querySelector<HTMLButtonElement>(
            'button[type="submit"]',
          );
          if (!submit) return;
          submit.disabled = true;
          submit.setAttribute("aria-busy", "true");
          if (error) error.hidden = true;
          void (async () => {
            try {
              const result = await mutation(form);
              if (result.deleted) {
                dialog?.close();
                await navigate("/app/formatos?success=deleted");
              } else if (result.format) {
                renderFormat(result.format);
                dialog?.close();
                if (form === actionForm) trigger?.focus();
                sileo.success({
                  title: result.format.active
                    ? "Formato activado."
                    : "Formato desactivado.",
                  duration: 6000,
                });
              } else
                throw new Error(
                  "No se pudo guardar el cambio. Inténtalo nuevamente.",
                );
            } catch (failure) {
              if (error) {
                error.textContent =
                  failure instanceof Error
                    ? failure.message
                    : "No se pudo guardar el cambio. Inténtalo nuevamente.";
                error.hidden = false;
              }
              dialog?.close();
              error?.focus();
            } finally {
              submit.disabled = false;
              submit.removeAttribute("aria-busy");
            }
          })();
        });
      };
      if (actionForm) submitAction(actionForm);
      if (dialogForm) submitAction(dialogForm);

      const success = new URLSearchParams(window.location.search).get(
        "success",
      );
      const messages: Record<string, string> = {
        rename: "Nombre actualizado.",
        revise:
          "Nueva revisión guardada. Los borradores usan los valores vigentes.",
        activate: "Formato activado.",
        deactivate: "Formato desactivado.",
      };
      const message = success ? messages[success] : undefined;
      if (message) {
        {
          sileo.success({ title: message, duration: 6000 });
          const url = new URL(window.location.href);
          url.searchParams.delete("success");
          window.history.replaceState(
            window.history.state,
            "",
            `${url.pathname}${url.search}${url.hash}`,
          );
        }
      }
    });
  </script>
</PrivateLayout>
