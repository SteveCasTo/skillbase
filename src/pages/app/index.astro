---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import { requireInternalUser } from "@/server/auth/context";

const user = requireInternalUser(Astro.locals);
---

<PrivateLayout title="Resumen">
  <header>
    <p class="text-sm font-medium text-primary">Panel privado</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
      Hola, {user.name}
    </h1>
    <p class="mt-3 leading-7 text-muted-foreground">
      Tu acceso está activo. Las secciones disponibles dependen de tus roles
      asignados.
    </p>
  </header>
  <section class="mt-9 grid gap-4 sm:grid-cols-2" aria-labelledby="roles-title">
    <article class="rounded-xl border bg-card p-6 shadow-sm">
      <h2 id="roles-title" class="text-lg font-semibold">
        Roles habilitados
      </h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {user.roles.map((role) => (
          <li class="rounded-full bg-secondary px-3 py-1 text-sm font-medium">
            {role === "ADMIN" ? "Administrador" : "Instructor"}
          </li>
        ))}
      </ul>
    </article>
    <article class="rounded-xl border bg-card p-6 shadow-sm">
      <h2 class="text-lg font-semibold">Estado operativo</h2>
      <p class="mt-4 text-sm leading-6 text-muted-foreground">
        {user.roles.includes("ADMIN")
          ? "Administra cursos, grupos e instructores."
          : "Consulta tus cursos asignados y administra tu perfil."}
      </p>
      <a
        href={
          user.roles.includes("ADMIN") ? "/app/instructores" : "/app/mis-cursos"
        }
        class="mt-4 inline-block text-sm font-semibold underline underline-offset-4"
      >
        {user.roles.includes("ADMIN")
          ? "Gestionar instructores"
          : "Ver mis cursos"}
      </a>
    </article>
  </section>
</PrivateLayout>
