---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
---

<PrivateLayout title="Asistencia">
  <header>
    <p class="text-sm font-medium text-primary">Docencia</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
      Asistencia
    </h1>
    <p class="mt-3 max-w-2xl leading-7 text-muted-foreground">
      Esta zona representativa está reservada al rol Instructor.
    </p>
  </header>
  <section
    class="mt-9 rounded-xl border border-dashed bg-card p-7 text-center sm:p-10"
    aria-labelledby="attendance-empty-title"
  >
    <h2 id="attendance-empty-title" class="text-lg font-semibold">
      No hay sesiones asignadas
    </h2>
    <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-muted-foreground">
      La operación de asistencia se implementará en una fase posterior. Esta
      vista valida desde ahora el acceso del instructor.
    </p>
  </section>
</PrivateLayout>
