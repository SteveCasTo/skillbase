---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
---

<PrivateLayout title="Cursos">
  <header>
    <p class="text-sm font-medium text-primary">Administración</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
      Cursos
    </h1>
    <p class="mt-3 max-w-2xl leading-7 text-muted-foreground">
      Esta zona representativa está reservada al rol Administrador.
    </p>
  </header>
  <section
    class="mt-9 rounded-xl border border-dashed bg-card p-7 text-center sm:p-10"
    aria-labelledby="courses-empty-title"
  >
    <h2 id="courses-empty-title" class="text-lg font-semibold">
      Todavía no hay cursos
    </h2>
    <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-muted-foreground">
      La gestión de cursos se implementará en la Fase 2. Por ahora, esta ruta
      evidencia el límite de autorización administrativo.
    </p>
  </section>
</PrivateLayout>
