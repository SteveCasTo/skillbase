---
import { BookOpen, Plus, FileText, Sheet } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import {
  courseListStatus,
  matchesCourseSearch,
} from "@/domain/courses/report-filters";
import SearchToolbar from "@/components/lists/SearchToolbar.astro";
import ListSearchEmpty from "@/components/lists/ListSearchEmpty.astro";
import { courseFilters, matchesListFilter } from "@/components/lists/filters";
import { normalizeRegistrationSearch } from "@/domain/pre-registrations/search";

import { listAdminCourses } from "@/application/courses/manage-courses";
import type { AdminCourseCardDto } from "@/domain/courses/types";
import { courseAcademicPhaseLabels } from "@/domain/courses/academic-phase";
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import CourseBreadcrumbs from "@/components/courses/CourseBreadcrumbs.astro";
import { requireInternalUser } from "@/server/auth/context";
import {
  COURSE_INFRASTRUCTURE_STATUS,
  logCourseInfrastructureError,
} from "@/server/courses/errors";
import { getDatabase } from "@/server/db/client";
import { CourseInfrastructureError } from "@/server/db/repositories/course-infrastructure-error";
import { DrizzleCourseRepository } from "@/server/db/repositories/course-repository";

const user = requireInternalUser(Astro.locals);
let courses: readonly AdminCourseCardDto[] = [];
let loadError = false;
try {
  courses = await listAdminCourses(
    new DrizzleCourseRepository(getDatabase()),
    user,
  );
} catch (error) {
  Astro.response.status = COURSE_INFRASTRUCTURE_STATUS;
  loadError = true;
  if (error instanceof CourseInfrastructureError)
    logCourseInfrastructureError(error, { actorId: user.id });
}
const success = Astro.url.searchParams.get("success");
const successMessage =
  success === "created"
    ? "Curso creado como borrador."
    : success === "updated"
      ? "Cambios guardados correctamente."
      : null;
const statusLabel = {
  DRAFT: "Borrador",
  PUBLISHED: "Publicado",
  ARCHIVED: "Archivado",
} as const;
const levelLabel = {
  BASIC: "Básico",
  INTERMEDIATE: "Medio",
  ADVANCED: "Avanzado",
} as const;
const search = Astro.url.searchParams.get("search") ?? "";
const query = normalizeRegistrationSearch(search);
const status = courseListStatus(Astro.url.searchParams.get("status"));
const reportHref = (format: string) =>
  `/app/cursos/exportar?${new URLSearchParams({ format, search, status })}`;
const entries = courses.map((course) => ({
  course,
  searchable: normalizeRegistrationSearch(`${course.name} ${course.slug}`),
}));
const hasMatches = entries.some(
  ({ course }) =>
    matchesCourseSearch(course, search) &&
    matchesListFilter(course.status, status),
);
---

<PrivateLayout title="Cursos">
  <div class="mb-5">
    <CourseBreadcrumbs
      current="Cursos"
      parents={[{ label: "Inicio", href: "/app" }]}
    />
  </div>
  <header class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Cursos</h1>
      <p class="mt-3 leading-7 text-muted-foreground">
        Gestiona la información editorial, precios y disponibilidad de cada
        curso.
      </p>
    </div>
    <div class="flex shrink-0 flex-wrap items-center gap-2">
      <a
        href={reportHref("PDF")}
        data-course-report="PDF"
        aria-label="Descargar informe de cursos PDF"
        class={buttonVariants({ variant: "outline", className: "min-h-11" })}
      >
        <FileText aria-hidden="true" data-icon="inline-start" /> PDF
      </a>
      <a
        href={reportHref("CSV")}
        data-course-report="CSV"
        aria-label="Descargar informe de cursos CSV"
        class={buttonVariants({ variant: "outline", className: "min-h-11" })}
      >
        <Sheet aria-hidden="true" data-icon="inline-start" /> CSV
      </a>
      <a
        href="/app/cursos/nuevo"
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-primary px-5 text-sm font-semibold text-primary-foreground shadow-xs hover:opacity-90"
      >
        <Plus size={18} aria-hidden="true" /> Nuevo curso
      </a>
    </div>
  </header>

  {successMessage && (
    <noscript>
      <p
        role="status"
        class="mt-7 rounded-lg border bg-secondary px-4 py-3 text-sm text-secondary-foreground"
      >
        {successMessage}
      </p>
    </noscript>
  )}

  <div data-search-list="cursos">
    <SearchToolbar
      id="course-search"
      label="Buscar por nombre de curso"
      {search}
      {status}
      options={courseFilters}
    />
    {loadError ? (
      <section
        class="mt-9 rounded-xl border bg-card p-7 text-center sm:p-10"
        role="alert"
      >
        <h2 class="text-lg font-semibold">No pudimos cargar los cursos</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          Inténtalo nuevamente en unos minutos.
        </p>
        <a
          href={`${Astro.url.pathname}${Astro.url.search}`}
          class="mt-5 inline-flex min-h-11 items-center justify-center rounded-lg border px-4 text-sm font-medium hover:bg-secondary focus-visible:outline-2 focus-visible:outline-ring"
        >
          Reintentar
        </a>
      </section>
    ) : courses.length === 0 ? (
      <section
        class="mt-9 rounded-xl border border-dashed bg-card p-7 text-center sm:p-10"
        aria-labelledby="courses-empty-title"
      >
        <BookOpen
          className="mx-auto text-muted-foreground"
          size={34}
          aria-hidden="true"
        />
        <h2 id="courses-empty-title" class="mt-4 text-lg font-semibold">
          Todavía no hay cursos
        </h2>
        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-muted-foreground">
          Crea el primer borrador para organizar sus fechas, precios y contenido
          antes de publicarlo.
        </p>
        <a
          href="/app/cursos/nuevo"
          class="mt-5 inline-flex min-h-11 items-center justify-center rounded-lg border px-4 text-sm font-medium hover:bg-secondary"
        >
          Crear primer curso
        </a>
      </section>
    ) : (
      <>
        <ListSearchEmpty
          hidden={hasMatches}
          message={
            query
              ? "No hay cursos que coincidan con la búsqueda."
              : `No hay cursos en «${courseFilters.find((option) => option.value === status)?.label}».`
          }
          resetHref="/app/cursos?status=ALL"
        />
        <section
          data-list-results
          hidden={!hasMatches}
          class="mt-8"
          aria-labelledby="courses-list-title"
        >
          <h2 id="courses-list-title" class="sr-only">
            Listado de cursos
          </h2>
          <ul class="grid gap-4 lg:grid-cols-2">
            {entries.map(({ course, searchable }) => (
              <li
                data-list-entry={searchable}
                data-list-status={course.status}
                hidden={
                  !searchable.includes(query) ||
                  !matchesListFilter(course.status, status)
                }
                class="min-w-0"
              >
                <article class="h-full rounded-xl border bg-card shadow-xs transition-colors hover:border-primary/50 hover:bg-secondary/30">
                  <a
                    href={`/app/cursos/${course.id}/editar`}
                    class="flex h-full flex-col rounded-xl p-5 outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 sm:p-6"
                  >
                    <div class="flex items-start justify-between gap-4">
                      <div class="min-w-0">
                        <h3 class="text-lg font-semibold leading-snug [overflow-wrap:anywhere]">
                          {course.name}
                        </h3>
                        <p class="mt-1 truncate font-mono text-xs text-muted-foreground">
                          /{course.slug}
                        </p>
                      </div>
                      <span
                        class:list={[
                          "shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold",
                          course.status === "PUBLISHED"
                            ? "bg-primary text-primary-foreground"
                            : "bg-secondary text-secondary-foreground",
                        ]}
                      >
                        {statusLabel[course.status]}
                      </span>
                      {course.featured && (
                        <span class="text-xs font-semibold text-primary">
                          Destacado
                        </span>
                      )}
                    </div>
                    <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
                      <div>
                        <dt class="text-muted-foreground">Nivel</dt>
                        <dd class="mt-1 font-medium">
                          {levelLabel[course.level]}
                        </dd>
                      </div>
                      <div>
                        <dt class="text-muted-foreground">
                          Formato · duración
                        </dt>
                        <dd class="mt-1 font-medium">
                          {course.totalHours} horas
                        </dd>
                      </div>
                      <div class="col-span-2">
                        <dt class="text-muted-foreground">Fase académica</dt>
                        <dd class="mt-1 font-medium">
                          {courseAcademicPhaseLabels[course.academicPhase]}
                        </dd>
                      </div>
                    </dl>
                  </a>
                </article>
              </li>
            ))}
          </ul>
        </section>
      </>
    )}
  </div>
  <script>
    import { notifications } from "@/lib/notifications";
    import { initializeCourseReports } from "@/components/courses/report-download";
    initializeCourseReports();
    document.addEventListener("astro:page-load", () => {
      initializeCourseReports();
      if (window.location.pathname !== "/app/cursos") return;
      const success = new URLSearchParams(window.location.search).get(
        "success",
      );
      const messages: Record<string, string> = {
        created: "Curso creado como borrador.",
        updated: "Cambios guardados correctamente.",
      };
      const message = success ? messages[success] : undefined;
      if (message) {
        {
          notifications.success({ title: message, duration: 6000 });
          const url = new URL(window.location.href);
          url.searchParams.delete("success");
          window.history.replaceState(
            window.history.state,
            "",
            `${url.pathname}${url.search}${url.hash}`,
          );
        }
      }
    });
  </script>
</PrivateLayout>
