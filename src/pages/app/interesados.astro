---
import { UsersRound } from "lucide-react";
import SearchToolbar from "@/components/lists/SearchToolbar.astro";
import ListSearchEmpty from "@/components/lists/ListSearchEmpty.astro";
import { normalizeRegistrationSearch } from "@/domain/pre-registrations/search";
import type { AdminInterestSummaryDto } from "@/domain/interests/types";
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import CourseBreadcrumbs from "@/components/courses/CourseBreadcrumbs.astro";
import { requireInternalUser } from "@/server/auth/context";
import { loadAdminInterestSummary } from "@/server/interests/http";
import {
  interestCourseFilters as options,
  parseInterestFilter,
  matchesInterestCourseFilter,
} from "@/server/interests/filter";

const actor = requireInternalUser(Astro.locals);
Astro.response.headers.set("Cache-Control", "private, no-store");
let courses: AdminInterestSummaryDto[] = [];
let loadError = false;
const search = Astro.url.searchParams.get("search") ?? "";
const query = normalizeRegistrationSearch(search);
let status: ReturnType<typeof parseInterestFilter> = "WITH";
try {
  status = parseInterestFilter(Astro.url.searchParams);
} catch {
  return new Response("El filtro no es válido.", {
    status: 400,
    headers: { "Cache-Control": "private, no-store" },
  });
}
try {
  courses = await loadAdminInterestSummary(actor);
} catch {
  loadError = true;
  Astro.response.status = 503;
}
const entries = courses.map((course) => ({
  course,
  searchable: normalizeRegistrationSearch(course.name),
  demand: course.activeTotal > 0 ? "WITH" : "WITHOUT",
}));
const matches = (searchable: string, activeTotal: number) =>
  searchable.includes(query) &&
  matchesInterestCourseFilter(activeTotal, status);
const hasMatches = entries.some(({ searchable, course }) =>
  matches(searchable, course.activeTotal),
);
---

<PrivateLayout title="Interesados">
  <div class="mb-5">
    <CourseBreadcrumbs
      current="Interesados"
      parents={[{ label: "Inicio", href: "/app" }]}
    />
  </div>
  <header>
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
      Interesados
    </h1>
    <p class="mt-3 leading-7 text-muted-foreground">
      Consulta la demanda de cada curso y gestiona los registros de interés.
    </p>
  </header>
  <div data-search-list="cursos">
    <SearchToolbar
      id="interest-course-search"
      label="Buscar por nombre de curso"
      {search}
      {status}
      {options}
      filterLabel="Filtrar cursos por interesados"
      defaultStatus="WITH"
    />
    {loadError ? (
      <section
        role="alert"
        class="mt-8 rounded-xl border bg-card p-7 text-center"
      >
        <h2 class="text-lg font-semibold">No pudimos cargar los interesados</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Inténtalo nuevamente en unos minutos.
        </p>
        <a
          href="/app/interesados"
          class="mt-5 inline-flex min-h-11 items-center rounded-lg border px-4 text-sm font-medium hover:bg-secondary"
        >
          Reintentar
        </a>
      </section>
    ) : courses.length === 0 ? (
      <section
        aria-labelledby="interests-empty"
        class="mt-8 rounded-xl border border-dashed bg-card p-7 text-center sm:p-10"
      >
        <UsersRound
          size={34}
          className="mx-auto text-muted-foreground"
          aria-hidden="true"
        />
        <h2 id="interests-empty" class="mt-4 text-lg font-semibold">
          Todavía no hay cursos para consultar
        </h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Los registros de interés aparecerán asociados a su curso.
        </p>
        <a
          href="/app/cursos"
          class="mt-5 inline-flex min-h-11 items-center rounded-lg border px-4 text-sm font-medium hover:bg-secondary"
        >
          Ver cursos
        </a>
      </section>
    ) : (
      <>
        <ListSearchEmpty
          hidden={hasMatches}
          message="No hay cursos publicados que coincidan con la búsqueda y el filtro."
          resetHref="/app/interesados"
        />
        <section
          data-list-results
          hidden={!hasMatches}
          class="mt-8"
          aria-labelledby="interest-courses-title"
        >
          <h2 id="interest-courses-title" class="sr-only">
            Selecciona un curso
          </h2>
          <ul class="grid gap-4 lg:grid-cols-2">
            {entries.map(({ course, searchable, demand }) => (
              <li
                data-list-entry={searchable}
                data-list-status={demand}
                hidden={!matches(searchable, course.activeTotal)}
              >
                <a
                  href={`/app/interesados/${course.courseId}`}
                  class="flex h-full flex-col gap-4 rounded-xl border bg-card p-5 transition-colors hover:bg-secondary/30 focus-visible:outline-2 focus-visible:outline-ring sm:p-6"
                >
                  <h3 class="break-words text-lg font-semibold">
                    {course.name}
                  </h3>
                  <p class="flex flex-wrap items-center justify-between gap-2 text-sm text-muted-foreground">
                    <span>Interesados activos</span>
                    <strong class="text-xl font-semibold tabular-nums text-foreground">
                      {course.activeTotal}
                    </strong>
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </>
    )}
  </div>
</PrivateLayout>
