---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import { requireInternalUser } from "@/server/auth/context";
import ProfilePasswordEntry from "@/components/auth/ProfilePasswordEntry.astro";
import { accountHasPassword } from "@/server/auth/password-presence";
import AuthFormPending from "@/components/auth/AuthFormPending.astro";
import { buttonVariants } from "@/components/ui/button";
import { isGoogleAssociated } from "@/domain/auth/identity";
import { accountIdentity } from "@/server/auth/identity";
import { instructorEditor } from "@/server/instructors/editor";
import InstructorForm from "@/components/instructors/InstructorForm.astro";
const user = requireInternalUser(Astro.locals);
const professionalRequest =
  Astro.url.searchParams.get("edit") === "professional";
const professional = user.roles.includes("INSTRUCTOR")
  ? await instructorEditor(
      {
        request: professionalRequest ? Astro.request : new Request(Astro.url),
        locals: Astro.locals,
        redirect: Astro.redirect,
        response: Astro.response,
      },
      user.id,
      true,
    )
  : null;
if (professional?.response) return professional.response;
if (Astro.request.method === "POST" && !professionalRequest)
  return Astro.redirect("/app/perfil/contrasena", 303);
const hasPassword = await accountHasPassword(
  user,
  accountIdentity(Astro.locals.authUser!),
);
const googleLinked = Astro.locals.authUser
  ? isGoogleAssociated(user, accountIdentity(Astro.locals.authUser))
  : false;
const status = Astro.url.searchParams.get("status");
---

<PrivateLayout title="Mi perfil">
  <header class="min-w-0">
    <h1 class="text-3xl font-semibold tracking-tight">Mi perfil</h1>
    <p class="mt-3 leading-7 text-muted-foreground">
      Administra el acceso a tu cuenta. Tus roles y tu correo los gestiona el
      equipo administrador.
    </p>
  </header>
  <div class="mt-8 grid min-w-0 gap-6 xl:grid-cols-2 xl:items-start">
    {professional?.previous && (
      <section
        class="min-w-0 xl:col-span-2"
        aria-labelledby="professional-title"
      >
        <h2 id="professional-title" class="text-xl font-semibold">
          Perfil profesional
        </h2>
        {professional.error && (
          <p role="alert" class="mt-4 text-destructive">
            {professional.error}
          </p>
        )}
        {Astro.url.searchParams.get("status") === "profile_updated" && (
          <p role="status" class="mt-4">
            Perfil actualizado.
          </p>
        )}
        <InstructorForm
          values={professional.values}
          errors={professional.errors}
          revision={professional.revision}
          baseline={{
            firstName: professional.previous.firstName,
            lastName: professional.previous.lastName,
            email: professional.previous.email,
            phone: professional.previous.phone ?? "",
          }}
          editing
          action="/app/perfil?edit=professional"
        />
      </section>
    )}
    {status === "recovery_sent" && (
      <p
        class="rounded-lg border bg-muted p-4 text-sm xl:col-span-2"
        role="status"
      >
        Si podemos procesar la solicitud para una cuenta habilitada, enviaremos
        un enlace para confirmar tu acceso. Revisa también spam.
      </p>
    )}
    {(status === "password_changed" ||
      status === "linked" ||
      status === "confirmed") && (
      <p
        class="rounded-lg border bg-muted p-4 text-sm xl:col-span-2"
        role="status"
      >
        {status === "password_changed"
          ? "Contraseña actualizada."
          : status === "linked"
            ? "Google está asociado a tu cuenta."
            : "Acceso confirmado. Puedes establecer una contraseña durante los próximos cinco minutos."}
      </p>
    )}
    {Astro.url.searchParams.get("error") && (
      <p
        class="rounded-lg border border-destructive/40 bg-destructive/10 p-4 text-sm xl:col-span-2"
        role="alert"
      >
        No pudimos asociar Google. Utiliza la cuenta con el mismo correo e
        inténtalo nuevamente.
      </p>
    )}
    <section
      class="min-w-0 rounded-xl border bg-card p-5 sm:p-6"
      aria-labelledby="account-title"
    >
      <h2 id="account-title" class="text-lg font-semibold">
        Datos de la cuenta
      </h2>
      <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-2">
        <div>
          <dt class="text-muted-foreground">Nombre</dt>
          <dd class="mt-1 break-words font-medium">{user.name}</dd>
        </div>
        <div>
          <dt class="text-muted-foreground">Correo electrónico</dt>
          <dd class="mt-1 break-all font-medium">{user.email}</dd>
        </div>
        <div>
          <dt class="text-muted-foreground">Roles</dt>
          <dd class="mt-1 font-medium">
            {user.roles
              .map((role) =>
                role === "ADMIN" ? "Administrador" : "Instructor",
              )
              .join(", ")}
          </dd>
        </div>
      </dl>
    </section>
    <ProfilePasswordEntry hasPassword={hasPassword} />
    <section
      class="min-w-0 rounded-xl border bg-card p-5 sm:p-6"
      aria-labelledby="google-title"
    >
      <h2 id="google-title" class="text-lg font-semibold">
        Cuenta de Google
      </h2>
      <p class="mt-2 text-sm leading-6 text-muted-foreground">
        {googleLinked
          ? "Google está asociado a esta misma cuenta."
          : "Puedes asociar Google de forma opcional. El correo verificado debe coincidir exactamente con el correo de tu cuenta."}
      </p>
      {!googleLinked && (
        <form
          class="mt-5"
          method="post"
          action="/auth/link-google"
          data-auth-form
          data-astro-reload
        >
          <button
            class={buttonVariants({
              variant: "outline",
              className: "min-h-11",
            })}
            type="submit"
            data-label="Asociar Google"
          >
            Asociar Google
          </button>
        </form>
      )}
    </section>
  </div>
  <AuthFormPending />
</PrivateLayout>
