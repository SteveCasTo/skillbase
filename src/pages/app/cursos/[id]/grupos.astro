---
import { getAdminCourse } from "@/application/courses/manage-courses";
import {
  cancelGroup,
  changeGroupCapacity,
  changeGroupSchedule,
  createGroup,
  deleteGroup,
  listGroups,
  reactivateGroup,
} from "@/application/groups/manage-groups";
import CourseBreadcrumbs from "@/components/courses/CourseBreadcrumbs.astro";
import CourseTabs from "@/components/courses/CourseTabs.astro";
import GroupManagement from "@/components/courses/GroupManagement.astro";
import { instantToBoliviaCivil } from "@/domain/courses/bolivia-time";
void instantToBoliviaCivil; // Astro checker omits references in returned responses.
import { GroupError } from "@/domain/groups/rules";
import type { Group } from "@/domain/groups/types";
import type { AdminCourseDto } from "@/domain/courses/types";
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import { requireInternalUser } from "@/server/auth/context";
import { requestHasExpectedOrigin } from "@/server/auth/redirects";
import { getDatabase } from "@/server/db/client";
import { DrizzleCourseRepository } from "@/server/db/repositories/course-repository";
import { DrizzleGroupRepository } from "@/server/db/repositories/group-repository";
import { getPublicAuthEnvironment } from "@/server/environment";

const user = requireInternalUser(Astro.locals);
const id = Astro.params.id ?? "";
const path = `/app/cursos/${id}/grupos`;
void path; // Astro's frontmatter checker omits references in returned responses.
const wantsJson =
  Astro.request.headers.get("accept")?.includes("application/json") ?? false;
const repository = new DrizzleGroupRepository(getDatabase());
let course: AdminCourseDto | null = null;
let groups: readonly Group[] = [];
let pageError = "";
let failedIntent = "";
let attemptedTime = "";
let attemptedCapacity = "";
let failedGroupId = "";
let fieldError = "";
let pageErrorCode = "";
let loadError = false;

const logFailure = (operation: string) => {
  // No SQL, request body, error cause or credentials in server logs.
  console.error("group_infrastructure_error", {
    operation,
    actorId: user.id,
    courseId: id,
  });
};
try {
  course = await getAdminCourse(
    new DrizzleCourseRepository(getDatabase()),
    user,
    id,
  );
  if (course) groups = await listGroups(repository, user, id);
  else Astro.response.status = 404;
} catch {
  loadError = true;
  Astro.response.status = 500;
  logFailure("load");
}

const canCreate =
  course !== null &&
  course.status !== "ARCHIVED" &&
  course.weekdaysMask === 31 &&
  course.sessionMinutes !== null;
const groupDto = (group: Group) => ({
  id: group.id,
  revision: group.updatedAt.toISOString(),
  startTime: instantToBoliviaCivil(group.startsAt).slice(11, 16),
  endTime: instantToBoliviaCivil(group.endsAt).slice(11, 16),
  capacity: group.capacity,
  status: group.status,
  published: group.publishedAt !== null,
});
void groupDto;
if (wantsJson && Astro.request.method === "GET")
  return new Response(
    JSON.stringify({
      canCreate,
      groups: groups.map(groupDto),
    }),
    {
      status: loadError ? 503 : course ? 200 : 404,
      headers: {
        "Content-Type": "application/json",
        "Cache-Control": "private, no-store",
      },
    },
  );
const successMessages = {
  created: "Grupo creado.",
  schedule: "Horario actualizado.",
  capacity: "Capacidad actualizada.",
  cancelled: "Grupo cancelado; su historial se conserva.",
  reactivated: "Grupo reactivado.",
  deleted: "Grupo eliminado.",
} as const;
const success = Astro.url.searchParams.get("success");
const successMessage =
  success && success in successMessages
    ? successMessages[success as keyof typeof successMessages]
    : "";

if (course && Astro.request.method === "POST") {
  if (
    !requestHasExpectedOrigin(Astro.request, getPublicAuthEnvironment().siteUrl)
  ) {
    Astro.response.status = 403;
    pageError = "Origen no válido. Recarga la página e inténtalo de nuevo.";
  } else {
    const form = await Astro.request.formData();
    failedIntent = String(form.get("intent") ?? "");
    failedGroupId = String(form.get("groupId") ?? "");
    attemptedTime = String(form.get("startTime") ?? "");
    attemptedCapacity = String(form.get("capacity") ?? "");
    try {
      if (!canCreate && !["cancel", "delete"].includes(failedIntent))
        throw new GroupError(
          "COURSE_UNAVAILABLE",
          "Solo cursos no archivados y planificados admiten grupos.",
        );
      let result: Group | null = null;
      if (failedIntent === "create") {
        result = await createGroup(
          repository,
          user,
          id,
          attemptedTime,
          Number(attemptedCapacity),
        );
      } else if (
        ["schedule", "capacity", "cancel", "reactivate", "delete"].includes(
          failedIntent,
        )
      ) {
        // Mutations address a group by ID; constrain it to the course in this URL.
        if (!groups.some((group) => group.id === failedGroupId))
          throw new GroupError(
            "GROUP_NOT_FOUND",
            "El grupo no existe en este curso.",
          );
        const revision = String(form.get("revision") ?? "");
        if (failedIntent === "schedule")
          result = await changeGroupSchedule(
            repository,
            user,
            failedGroupId,
            attemptedTime,
            revision,
          );
        else if (failedIntent === "capacity")
          result = await changeGroupCapacity(
            repository,
            user,
            failedGroupId,
            Number(attemptedCapacity),
            revision,
          );
        else if (failedIntent === "cancel")
          result = await cancelGroup(repository, user, failedGroupId, revision);
        else if (failedIntent === "reactivate")
          result = await reactivateGroup(
            repository,
            user,
            failedGroupId,
            revision,
          );
        else await deleteGroup(repository, user, failedGroupId, revision);
      } else {
        Astro.response.status = 400;
        throw new Error("invalid_intent");
      }
      void result; // Astro's frontmatter checker omits references in returned responses.
      if (wantsJson)
        return new Response(
          JSON.stringify({
            id: result?.id ?? failedGroupId,
            revision:
              result?.updatedAt.toISOString() ??
              String(form.get("revision") ?? ""),
            group: result ? groupDto(result) : null,
          }),
          {
            headers: {
              "Content-Type": "application/json",
              "Cache-Control": "private, no-store",
            },
          },
        );
      return Astro.redirect(
        `${path}?success=${failedIntent === "cancel" ? "cancelled" : failedIntent === "create" ? "created" : failedIntent === "reactivate" ? "reactivated" : failedIntent === "delete" ? "deleted" : failedIntent}`,
        303,
      );
    } catch (error) {
      if (error instanceof GroupError) {
        pageErrorCode = error.code;
        Astro.response.status =
          error.code === "GROUP_NOT_FOUND"
            ? 404
            : error.code === "VALIDATION_FAILED"
              ? 422
              : 409;
        pageError = error.message;
        if (
          error.code === "VALIDATION_FAILED" ||
          error.code === "SCHEDULE_CONFLICT"
        )
          fieldError = error.message;
      } else if (error instanceof Error && error.message === "invalid_intent") {
        pageError = "La acción solicitada no es válida.";
      } else {
        Astro.response.status = 500;
        pageError = "No se pudo completar la acción. Inténtalo nuevamente.";
        logFailure("mutate");
      }
    }
  }
}
if (wantsJson && Astro.request.method === "POST")
  return new Response(
    JSON.stringify({
      message: pageError,
      code: pageErrorCode,
    }),
    {
      status: Astro.response.status,
      headers: {
        "Content-Type": "application/json",
        "Cache-Control": "private, no-store",
      },
    },
  );

const fieldErrorTarget =
  failedIntent === "capacity" ||
  (failedIntent === "create" && /capacidad/i.test(fieldError))
    ? "capacity"
    : "startTime";
void pageErrorCode; // Astro's frontmatter checker omits references in returned responses.
---

<PrivateLayout title={course ? `Grupos · ${course.name}` : "Grupos del curso"}>
  {loadError ? (
    <section role="alert" class="rounded-xl bg-card p-6">
      <h1 class="text-2xl font-semibold">No pudimos cargar los grupos</h1>
      <p class="mt-2">Inténtalo nuevamente más tarde.</p>
      <a
        href="/app/cursos"
        class="mt-4 inline-flex min-h-11 items-center underline"
      >
        Volver a cursos
      </a>
    </section>
  ) : !course ? (
    <section class="rounded-xl bg-card p-6">
      <h1 class="text-2xl font-semibold">Curso no encontrado</h1>
      <a
        href="/app/cursos"
        class="mt-4 inline-flex min-h-11 items-center underline"
      >
        Volver a cursos
      </a>
    </section>
  ) : (
    <>
      <header class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <CourseBreadcrumbs current="Grupos" />
          <h1 class="mt-5 text-3xl font-semibold tracking-tight sm:text-4xl">
            Grupos
          </h1>
          <p class="mt-2 text-sm text-muted-foreground">{course.name}</p>
        </div>
        {canCreate && (
          <button
            type="button"
            data-new-trigger
            hidden
            class="inline-flex min-h-11 items-center self-start rounded-lg border px-3 text-sm font-semibold hover:bg-secondary focus-visible:outline-2 focus-visible:outline-ring lg:self-auto"
          >
            Nuevo grupo
          </button>
        )}
      </header>
      <CourseTabs id={course.id} active="groups" />
      {successMessage && (
        <noscript>
          <p role="status" class="mt-5 rounded-lg bg-secondary p-4">
            {successMessage}
          </p>
        </noscript>
      )}
      {pageError && (
        <div
          role="alert"
          class="mt-5 rounded-lg border border-destructive/40 p-4 text-sm text-destructive"
        >
          <p>{pageError}</p>
          {Astro.response.status === 409 && (
            <a
              href={path}
              data-group-recover={failedGroupId}
              class="mt-2 min-h-11 underline underline-offset-4"
            >
              Recargar datos actuales
            </a>
          )}
        </div>
      )}
      <p
        data-group-error
        role="alert"
        hidden
        class="mt-5 rounded-lg border border-destructive/40 p-4 text-sm text-destructive"
      ></p>
      <GroupManagement
        course={course}
        groups={groups}
        canCreate={canCreate}
        failedIntent={failedIntent}
        failedGroupId={failedGroupId}
        attemptedTime={attemptedTime}
        attemptedCapacity={attemptedCapacity}
        fieldError={fieldError}
        fieldErrorTarget={fieldErrorTarget}
      />
    </>
  )}
</PrivateLayout>
