---
import {
  archiveCourse,
  getAdminCourse,
  featureCourse,
  publishCourse,
  updateCourse,
  withdrawCourse,
} from "@/application/courses/manage-courses";
import { listFormats } from "@/application/courses/manage-formats";
import type { CourseFormat } from "@/domain/courses/formats";
import CourseBreadcrumbs from "@/components/courses/CourseBreadcrumbs.astro";
import CourseTabs from "@/components/courses/CourseTabs.astro";
import CourseForm from "@/components/courses/CourseForm.astro";
import { CourseDomainError } from "@/domain/courses/errors";
import { instantToBoliviaCivil } from "@/domain/courses/bolivia-time";
import type { AdminCourseDto } from "@/domain/courses/types";
import type { CourseInput } from "@/domain/courses/validation";
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import { requestHasExpectedOrigin } from "@/server/auth/redirects";
import { requireInternalUser } from "@/server/auth/context";
import { courseInputFromFormData } from "@/server/courses/form";
import {
  COURSE_INFRASTRUCTURE_STATUS,
  courseDomainStatus,
  logCourseInfrastructureError,
} from "@/server/courses/errors";
import { getDatabase } from "@/server/db/client";
import { CourseInfrastructureError } from "@/server/db/repositories/course-infrastructure-error";
import { DrizzleCourseRepository } from "@/server/db/repositories/course-repository";
import { DrizzleFormatRepository } from "@/server/db/repositories/format-repository";
import { getPublicAuthEnvironment } from "@/server/environment";
import { traceSlowOperation } from "@/server/observability/slow-operation";
import { listInstructors } from "@/application/instructors/manage-instructors";
import { DrizzleInstructorRepository } from "@/server/db/repositories/instructor-repository";
import type { InstructorProfile } from "@/domain/instructors/profile";
import {
  ArtworkValidationError,
  artworkKeyForCourse,
  artworkStorage,
  verifyArtworkForCourse,
} from "@/server/courses/artwork";

const user = requireInternalUser(Astro.locals);
const id = Astro.params.id ?? "";
const wantsJson = Astro.request.headers
  .get("accept")
  ?.includes("application/json");
const repository = new DrizzleCourseRepository(getDatabase());
let course: AdminCourseDto | null = null;
let loadError = false;
let formats: readonly CourseFormat[] = [];
let instructors: readonly InstructorProfile[] = [];
try {
  instructors = await listInstructors(
    new DrizzleInstructorRepository(getDatabase()),
    user,
  );
  course = await getAdminCourse(repository, user, id);
  if (course)
    formats = await traceSlowOperation("formats.listAdmin", () =>
      listFormats(new DrizzleFormatRepository(getDatabase()), user),
    );
  if (!course) Astro.response.status = 404;
} catch (error) {
  Astro.response.status = COURSE_INFRASTRUCTURE_STATUS;
  loadError = true;
  if (error instanceof CourseInfrastructureError)
    logCourseInfrastructureError(error, { actorId: user.id, courseId: id });
}

const dateInput = (date: Date | null) =>
  date ? instantToBoliviaCivil(date) : "";
const dateOnlyPlan = (item: AdminCourseDto) =>
  item.weekdaysMask === 31 &&
  dateInput(item.startsAt).endsWith("T00:00") &&
  dateInput(item.endsAt).endsWith("T23:59") &&
  (!item.registrationStartAt ||
    dateInput(item.registrationStartAt).endsWith("T00:00")) &&
  (!item.registrationEndAt ||
    dateInput(item.registrationEndAt).endsWith("T00:00"));
const valuesFromCourse = (item: AdminCourseDto): CourseInput => ({
  name: item.name,
  description: item.description,
  level: item.level,
  courseTypeId: item.courseTypeId,
  contentMarkdown: item.contentMarkdown ?? "",
  instructorId: item.instructorId ?? "",
  artwork: item.artwork ?? "",
  schedule: item.schedule,
  ...(item.weekdaysMask === 31 ? { weekdays: "1,2,3,4,5" } : {}),
  conditions: item.conditions,
  startsAt: dateInput(item.startsAt),
  endsAt: dateInput(item.endsAt),
  ...(dateOnlyPlan(item)
    ? {
        registrationStartDate: dateInput(item.registrationStartAt).slice(0, 10),
        registrationEndDate: item.registrationEndAt
          ? dateInput(
              new Date(item.registrationEndAt.getTime() - 86400000),
            ).slice(0, 10)
          : "",
      }
    : {
        registrationStartAt: dateInput(item.registrationStartAt),
        registrationEndAt: dateInput(item.registrationEndAt),
      }),
  minimumGrade: String(item.minimumGrade),
});
// Keep the persisted snapshot even when a failed POST re-renders attempted values.
const baseline = course ? valuesFromCourse(course) : undefined;
let values: CourseInput = course ? valuesFromCourse(course) : {};
let errors: Readonly<Record<string, string>> = {};
let pageError: string | null = null;
let renderedRevision = course?.updatedAt.toISOString() ?? "";
let reconciliationRequired = false;
const successMessages = {
  created: "Borrador creado. Ya puedes añadir una foto.",
  updated: "Cambios guardados correctamente.",
  published: "Curso publicado.",
  withdrawn: "Curso retirado y devuelto a borrador.",
  archived: "Curso archivado.",
  featured: "Curso seleccionado como destacado.",
} as const;
const successKey = Astro.url.searchParams.get("success");
const successMessage =
  successKey && successKey in successMessages
    ? successMessages[successKey as keyof typeof successMessages]
    : null;

if (course && Astro.request.method === "POST") {
  if (
    !requestHasExpectedOrigin(Astro.request, getPublicAuthEnvironment().siteUrl)
  ) {
    Astro.response.status = 403;
    pageError =
      "La solicitud no tiene un origen válido. Recarga la página e inténtalo de nuevo.";
  } else {
    const formData = await Astro.request.formData();
    renderedRevision = String(formData.get("revision") ?? "");
    const intent = formData.get("intent");
    try {
      if (intent === "update") {
        values = courseInputFromFormData(formData);
        const artwork =
          typeof values.artwork === "string" ? values.artwork : "";
        if (
          artwork &&
          artwork !== (course.artwork ?? "") &&
          !artworkKeyForCourse(id, artwork)
        )
          throw new ArtworkValidationError(
            "La imagen seleccionada no es válida.",
          );
        if (artwork && artwork !== (course.artwork ?? ""))
          await verifyArtworkForCourse(id, artwork, artworkStorage());
        course = await updateCourse(repository, user, id, values);
        if (wantsJson)
          return new Response(
            JSON.stringify({
              revision: course.updatedAt.toISOString(),
              name: course.name,
              course: {
                id: course.id,
                status: course.status,
                featured: course.featured,
              },
            }),
            { headers: { "Content-Type": "application/json" } },
          );
        return Astro.redirect(`/app/cursos/${id}/editar?success=updated`, 303);
      } else if (intent === "publish") {
        course = await publishCourse(
          repository,
          user,
          id,
          String(formData.get("revision") ?? ""),
        );
        if (wantsJson)
          return new Response(
            JSON.stringify({
              status: course.status,
              revision: course.updatedAt.toISOString(),
              featured: course.featured,
            }),
            {
              headers: {
                "Content-Type": "application/json",
                "Cache-Control": "private, no-store",
              },
            },
          );
        return Astro.redirect(
          `/app/cursos/${id}/editar?success=published`,
          303,
        );
      } else if (intent === "withdraw") {
        course = await withdrawCourse(
          repository,
          user,
          id,
          String(formData.get("revision") ?? ""),
        );
        if (wantsJson)
          return new Response(
            JSON.stringify({
              status: course.status,
              revision: course.updatedAt.toISOString(),
              featured: course.featured,
            }),
            {
              headers: {
                "Content-Type": "application/json",
                "Cache-Control": "private, no-store",
              },
            },
          );
        return Astro.redirect(
          `/app/cursos/${id}/editar?success=withdrawn`,
          303,
        );
      } else if (intent === "archive") {
        course = await archiveCourse(
          repository,
          user,
          id,
          String(formData.get("revision") ?? ""),
        );
        if (wantsJson)
          return new Response(
            JSON.stringify({
              status: course.status,
              revision: course.updatedAt.toISOString(),
              featured: course.featured,
            }),
            {
              headers: {
                "Content-Type": "application/json",
                "Cache-Control": "private, no-store",
              },
            },
          );
        return Astro.redirect(`/app/cursos/${id}/editar?success=archived`, 303);
      } else if (intent === "feature") {
        course = await featureCourse(
          repository,
          user,
          id,
          String(formData.get("revision") ?? ""),
        );
        if (wantsJson)
          return new Response(
            JSON.stringify({
              status: course.status,
              revision: course.updatedAt.toISOString(),
              featured: course.featured,
            }),
            {
              headers: {
                "Content-Type": "application/json",
                "Cache-Control": "private, no-store",
              },
            },
          );
        return Astro.redirect(`/app/cursos/${id}/editar?success=featured`, 303);
      } else {
        Astro.response.status = 400;
        pageError = "La acción solicitada no es válida.";
      }
      if (course) values = valuesFromCourse(course);
    } catch (error) {
      if (error instanceof CourseDomainError) {
        reconciliationRequired =
          error.code === "STALE_COURSE" || Boolean(error.fieldErrors.revision);
        Astro.response.status = courseDomainStatus(error);
        errors = error.fieldErrors;
        pageError = error.message;
      } else if (error instanceof ArtworkValidationError) {
        Astro.response.status = 400;
        errors = { artwork: error.message };
        pageError = error.message;
      } else if (error instanceof CourseInfrastructureError) {
        Astro.response.status = COURSE_INFRASTRUCTURE_STATUS;
        logCourseInfrastructureError(error, { actorId: user.id, courseId: id });
        pageError = "No se pudo completar la acción. Inténtalo nuevamente.";
      } else {
        Astro.response.status = COURSE_INFRASTRUCTURE_STATUS;
        pageError = "No se pudo completar la acción. Inténtalo nuevamente.";
      }
    }
  }
}
if (wantsJson && Astro.request.method === "GET")
  return new Response(
    JSON.stringify(
      course
        ? {
            id: course.id,
            revision: course.updatedAt.toISOString(),
            artwork: course.artwork,
          }
        : { message: "El curso no existe." },
    ),
    {
      status: Astro.response.status,
      headers: {
        "Content-Type": "application/json",
        "Cache-Control": "private, no-store",
      },
    },
  );
if (wantsJson && Astro.request.method === "POST")
  return new Response(JSON.stringify({ message: pageError, errors }), {
    status: Astro.response.status,
    headers: { "Content-Type": "application/json" },
  });
const statusLabel = {
  DRAFT: "Borrador",
  PUBLISHED: "Publicado",
  ARCHIVED: "Archivado",
} as const;
---

<PrivateLayout title={course ? `Editar ${course.name}` : "Curso no encontrado"}>
  {loadError ? (
    <section class="rounded-xl border bg-card p-8 text-center" role="alert">
      <h1 class="text-2xl font-semibold">No pudimos cargar el curso</h1>
      <p class="mt-2 text-muted-foreground">
        Inténtalo nuevamente en unos minutos.
      </p>
      <a
        href="/app/cursos"
        class="mt-5 inline-flex min-h-11 items-center rounded-lg border px-4 text-sm font-medium"
      >
        Volver a cursos
      </a>
    </section>
  ) : !course ? (
    <section class="rounded-xl border bg-card p-8 text-center">
      <h1 class="text-2xl font-semibold">Curso no encontrado</h1>
      <p class="mt-2 text-muted-foreground">El curso solicitado no existe.</p>
      <a
        href="/app/cursos"
        class="mt-5 inline-flex min-h-11 items-center rounded-lg border px-4 text-sm font-medium"
      >
        Volver a cursos
      </a>
    </section>
  ) : (
    <>
      <header class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <CourseBreadcrumbs current={course.name} />
          <h1 class="mt-5 text-3xl font-semibold tracking-tight sm:text-4xl">
            Editar curso
          </h1>
        </div>
        <div
          class="flex flex-wrap items-center gap-2 lg:justify-end"
          aria-label="Estado y acciones del curso"
        >
          <span
            data-course-status
            tabindex="-1"
            class="rounded-full bg-secondary px-3 py-1.5 text-sm font-semibold text-secondary-foreground"
          >
            {statusLabel[course.status]}
          </span>
          {course.status !== "ARCHIVED" && (
            <>
              {
                <form
                  method="post"
                  class="mutation-form"
                  data-course-mutation-id={course.id}
                  hidden={course.status !== "PUBLISHED" || course.featured}
                >
                  <input type="hidden" name="intent" value="feature" />
                  <input
                    type="hidden"
                    name="revision"
                    value={renderedRevision}
                  />
                  <button
                    type="submit"
                    class="inline-flex min-h-11 items-center rounded-lg border px-3 text-sm font-semibold hover:bg-secondary focus-visible:outline-2 focus-visible:outline-ring"
                  >
                    <svg
                      aria-hidden="true"
                      class="mr-2 size-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="m12 2 3 6.5 7 .9-5.1 5 .9 7.1-5.8-3.3-5.8 3.3.9-7.1-5.1-5 7-.9z" />
                    </svg>
                    Destacar en la cartelera
                  </button>
                </form>
              }
              {
                <span
                  data-course-featured
                  hidden={!course.featured}
                  class="text-sm font-medium"
                >
                  Destacado en la cartelera
                </span>
              }
              <div data-confirm-actions hidden class="flex flex-wrap gap-2">
                {[
                  { intent: "publish", label: "Publicar curso" },
                  { intent: "withdraw", label: "Retirar publicación" },
                ]
                  .concat([{ intent: "archive", label: "Archivar curso" }])
                  .map((action) => (
                    <button
                      type="button"
                      data-confirm-trigger={action.intent}
                      hidden={
                        action.intent === "publish"
                          ? course.status !== "DRAFT"
                          : action.intent === "withdraw"
                            ? course.status !== "PUBLISHED"
                            : false
                      }
                      class="inline-flex min-h-11 items-center rounded-lg border px-3 text-sm font-semibold hover:bg-secondary focus-visible:outline-2 focus-visible:outline-ring"
                    >
                      <svg
                        aria-hidden="true"
                        class="mr-2 size-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path
                          d={
                            action.intent === "publish"
                              ? "M12 19V5m-6 6 6-6 6 6"
                              : action.intent === "withdraw"
                                ? "M12 5v14m-6-6 6 6 6-6"
                                : "M4 4h16v5H4zM5 9v11h14V9m-10 4h6"
                          }
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      {action.label}
                    </button>
                  ))}
              </div>
              <div class="flex flex-wrap gap-2" data-confirm-fallback-actions>
                {(course.status === "DRAFT"
                  ? [
                      {
                        intent: "publish",
                        label: "Publicar curso",
                        confirm: "Confirmar publicación",
                        description:
                          "El curso y sus precios serán visibles para todos.",
                      },
                    ]
                  : [
                      {
                        intent: "withdraw",
                        label: "Retirar publicación",
                        confirm: "Confirmar retiro",
                        description:
                          "El curso dejará de ser público y volverá a borrador.",
                      },
                    ]
                )
                  .concat([
                    {
                      intent: "archive",
                      label: "Archivar curso",
                      confirm: "Confirmar archivo",
                      description: "No podrás editar ni reactivar este curso.",
                    },
                  ])
                  .map((action) => (
                    <details
                      data-confirm-fallback={action.intent}
                      class="relative rounded-lg border bg-card px-3"
                    >
                      <summary class="flex min-h-11 cursor-pointer items-center text-sm font-semibold focus-visible:outline-2 focus-visible:outline-ring">
                        {action.label}
                      </summary>
                      <form
                        method="post"
                        data-course-mutation-id={course.id}
                        data-astro-reload
                        class="absolute right-0 z-10 mt-1 w-[min(18rem,calc(100vw-2rem))] rounded-lg border bg-card p-4 shadow-md mutation-form"
                      >
                        <input
                          type="hidden"
                          name="intent"
                          value={action.intent}
                        />
                        <input
                          type="hidden"
                          name="revision"
                          value={renderedRevision}
                        />
                        <p class="mb-3 text-sm text-muted-foreground">
                          {action.description}
                        </p>
                        <button
                          type="submit"
                          class="min-h-11 rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground"
                        >
                          {action.confirm}
                        </button>
                      </form>
                    </details>
                  ))}
              </div>
            </>
          )}
        </div>
      </header>
      {course.status !== "ARCHIVED" && (
        <dialog
          data-course-dialog
          aria-labelledby="course-dialog-title"
          aria-describedby="course-dialog-description"
          class="m-auto w-[min(28rem,calc(100%-2rem))] rounded-xl border bg-card p-6 text-foreground shadow-xl backdrop:bg-black/60"
        >
          <h2 id="course-dialog-title" class="text-lg font-semibold"></h2>
          <p
            id="course-dialog-description"
            class="mt-3 text-sm text-muted-foreground"
          ></p>
          <form
            method="post"
            data-course-dialog-form
            data-course-mutation-id={course.id}
            class="mt-6 flex flex-wrap justify-end gap-3"
          >
            <input type="hidden" name="intent" />
            <input type="hidden" name="revision" value={renderedRevision} />
            <button
              type="button"
              data-dialog-cancel
              class="min-h-11 rounded-lg border px-4"
            >
              Cancelar
            </button>
            <button
              type="submit"
              class="min-h-11 rounded-lg bg-destructive px-4 font-semibold text-destructive-foreground"
            ></button>
          </form>
        </dialog>
      )}
      <CourseTabs id={course.id} active="course" />
      {successMessage && (
        <noscript>
          <p
            role="status"
            class="mt-7 rounded-lg border bg-secondary px-4 py-3 text-sm text-secondary-foreground"
          >
            {successMessage}
          </p>
        </noscript>
      )}
      {pageError && (
        <p
          role="alert"
          class="mt-7 rounded-lg border border-destructive/40 bg-card px-4 py-3 text-sm text-destructive"
        >
          {pageError}
        </p>
      )}
      {reconciliationRequired && (
        <div class="mt-3 text-sm">
          <p>
            Conservamos la revisión anterior. Reenviar no reemplazará los
            cambios de otra persona. Carga los valores actuales para revisarlos;
            esta acción descarta el intento mostrado.
          </p>
          <a
            href={`/app/cursos/${course.id}/editar`}
            data-astro-reload
            class="mt-2 inline-flex min-h-11 items-center rounded-lg border px-4 font-semibold focus-visible:outline-2 focus-visible:outline-ring"
          >
            Cargar valores actuales
          </a>
        </div>
      )}
      <p
        data-save-error
        role="alert"
        hidden
        class="mt-7 rounded-lg border border-destructive/40 bg-card px-4 py-3 text-sm text-destructive"
      ></p>
      <button
        type="button"
        data-editorial-retry
        hidden
        class="mt-3 min-h-11 rounded-lg border px-4 text-sm font-semibold"
      >
        Reintentar acción
      </button>
      <div class="mt-8">
        <CourseForm
          values={values}
          formats={formats}
          instructors={instructors}
          errors={errors}
          disabled={course.status === "ARCHIVED"}
          submitLabel="Guardar cambios"
          intent="update"
          revision={renderedRevision}
          courseId={course.id}
          {baseline}
          pinnedFormat={
            course.status === "PUBLISHED"
              ? {
                  totalHours: course.totalHours,
                  sessionMinutes: course.sessionMinutes,
                }
              : undefined
          }
        />
      </div>
      <script>
        import { notifications } from "@/lib/notifications";
        import {
          acquireCourseMutation,
          synchronizeCourseRevision,
        } from "@/components/courses/course-mutation-lock";
        import { isEditorialResult } from "@/domain/courses/mutation-result";
        document.addEventListener("astro:page-load", () => {
          if (
            !/^\/app\/cursos\/[^/]+\/editar\/?$/.test(window.location.pathname)
          )
            return;
          const success = new URLSearchParams(window.location.search).get(
            "success",
          );
          const messages: Record<string, string> = {
            created: "Borrador creado. Ya puedes añadir una foto.",
            updated: "Cambios guardados correctamente.",
            published: "Curso publicado.",
            withdrawn: "Curso retirado y devuelto a borrador.",
            archived: "Curso archivado.",
            featured: "Curso seleccionado como destacado.",
          };
          const message = success ? messages[success] : undefined;
          if (message) {
            notifications.success({ title: message, duration: 6000 });
            const url = new URL(window.location.href);
            url.searchParams.delete("success");
            window.history.replaceState(
              window.history.state,
              "",
              `${url.pathname}${url.search}${url.hash}`,
            );
          }
          const dialog = document.querySelector<HTMLDialogElement>(
            "[data-course-dialog]",
          );
          const actions = document.querySelector<HTMLElement>(
            "[data-confirm-actions]",
          );
          const dialogForm = dialog?.querySelector<HTMLFormElement>(
            "[data-course-dialog-form]",
          );
          const error =
            document.querySelector<HTMLElement>("[data-save-error]");
          let trigger: HTMLButtonElement | null = null;
          let restoreAfterMutation = false;
          let pending = false;
          const mutationPath = window.location.pathname;
          const originalEditor =
            document.querySelector<HTMLFormElement>(".course-form");
          let failedForm: HTMLFormElement | null = null;
          let failedIntent = "";
          const retry = document.querySelector<HTMLButtonElement>(
            "[data-editorial-retry]",
          );
          retry?.addEventListener("click", () => {
            if (!pending && failedForm) {
              failedForm.querySelector<HTMLInputElement>(
                'input[name="intent"]',
              )!.value = failedIntent;
              failedForm.requestSubmit();
            }
          });
          const renderEditorial = (result: {
            status: string;
            revision: string;
            featured: boolean;
          }) => {
            if (!originalEditor?.isConnected) return;
            document.querySelector<HTMLElement>(
              "[data-course-status]",
            )!.textContent =
              result.status === "PUBLISHED"
                ? "Publicado"
                : result.status === "ARCHIVED"
                  ? "Archivado"
                  : "Borrador";
            synchronizeCourseRevision(
              originalEditor.dataset.courseId!,
              result.revision,
            );
            actions
              ?.querySelectorAll<HTMLButtonElement>("[data-confirm-trigger]")
              .forEach((button) => {
                button.hidden =
                  result.status === "ARCHIVED" ||
                  (button.dataset.confirmTrigger === "publish" &&
                    result.status !== "DRAFT") ||
                  (button.dataset.confirmTrigger === "withdraw" &&
                    result.status !== "PUBLISHED");
              });
            const feature = document.querySelector<HTMLFormElement>(
              ".mutation-form:not([data-astro-reload])",
            );
            if (feature)
              feature.hidden = result.status !== "PUBLISHED" || result.featured;
            const featured = document.querySelector<HTMLElement>(
              "[data-course-featured]",
            );
            if (featured) featured.hidden = !result.featured;
            if (result.status === "ARCHIVED") {
              const form = document.querySelector<HTMLFormElement>(
                "form[data-course-id]",
              );
              if (form) {
                form.inert = true;
                form.dataset.archived = "true";
                form
                  .querySelectorAll<
                    HTMLInputElement | HTMLButtonElement | HTMLTextAreaElement
                  >("input, button, textarea")
                  .forEach((control) => (control.disabled = true));
              }
            }
          };
          if (dialog && actions && dialogForm) {
            document
              .querySelectorAll<HTMLElement>("[data-confirm-fallback-actions]")
              .forEach((element) => (element.hidden = true));
            actions.hidden = false;
            const descriptions: Record<string, string> = {
              publish: "El curso y sus precios serán visibles para todos.",
              withdraw: "El curso dejará de ser público y volverá a borrador.",
              archive: "No podrás editar ni reactivar este curso.",
            };
            const labels: Record<string, string> = {
              publish: "Confirmar publicación",
              withdraw: "Confirmar retiro",
              archive: "Confirmar archivo",
            };
            actions
              .querySelectorAll<HTMLButtonElement>("[data-confirm-trigger]")
              .forEach((button) =>
                button.addEventListener("click", () => {
                  if (pending) return;
                  restoreAfterMutation = false;
                  trigger = button;
                  const intent = button.dataset.confirmTrigger ?? "";
                  dialogForm.querySelector<HTMLInputElement>(
                    'input[name="intent"]',
                  )!.value = intent;
                  dialog.querySelector<HTMLElement>(
                    "#course-dialog-title",
                  )!.textContent = button.textContent;
                  dialog.querySelector<HTMLElement>(
                    "#course-dialog-description",
                  )!.textContent = descriptions[intent] ?? "";
                  dialogForm.querySelector<HTMLButtonElement>(
                    'button[type="submit"]',
                  )!.textContent = labels[intent] ?? "";
                  dialog.showModal();
                }),
              );
            dialog
              .querySelector<HTMLButtonElement>("[data-dialog-cancel]")
              ?.addEventListener("click", () => dialog.close());
            dialog.addEventListener("close", () => {
              if (!restoreAfterMutation) trigger?.focus();
            });
            dialogForm.addEventListener("submit", (event) => {
              event.preventDefault();
              const button = dialogForm.querySelector<HTMLButtonElement>(
                'button[type="submit"]',
              )!;
              if (pending) return;
              const release = acquireCourseMutation(dialogForm);
              if (!release) return;
              pending = true;
              if (retry) retry.hidden = true;
              button.disabled = true;
              button.setAttribute("aria-busy", "true");
              if (error) error.hidden = true;
              const intent = dialogForm.querySelector<HTMLInputElement>(
                'input[name="intent"]',
              )!.value;
              const acceptedTrigger = trigger;
              restoreAfterMutation = true;
              dialog.close();
              void notifications
                .promise(
                  async () => {
                    try {
                      const response = await fetch(mutationPath, {
                        method: "POST",
                        headers: { Accept: "application/json" },
                        body: new FormData(dialogForm),
                      });
                      if (
                        response.redirected ||
                        !response.headers
                          .get("content-type")
                          ?.includes("application/json")
                      )
                        throw new Error(
                          "La sesión cambió. Recarga la página e inténtalo de nuevo.",
                        );
                      const result: unknown = await response.json();
                      if (
                        !response.ok ||
                        !result ||
                        typeof result !== "object" ||
                        !("revision" in result) ||
                        !isEditorialResult(result, intent)
                      )
                        throw new Error(
                          result &&
                            typeof result === "object" &&
                            "message" in result &&
                            typeof result.message === "string"
                            ? result.message
                            : "No se pudo completar la acción.",
                        );
                      if (
                        !("status" in result) ||
                        typeof result.status !== "string" ||
                        !("featured" in result) ||
                        typeof result.featured !== "boolean"
                      )
                        throw new Error(
                          "Respuesta no válida. Inténtalo nuevamente.",
                        );
                      renderEditorial({
                        status: result.status,
                        revision: result.revision,
                        featured: result.featured,
                      });
                    } catch (failure) {
                      failedForm = dialogForm;
                      failedIntent = intent;
                      if (retry) retry.hidden = false;
                      dialog.close();
                      if (error) {
                        error.textContent =
                          failure instanceof Error
                            ? failure.message
                            : "No se pudo completar la acción.";
                        error.hidden = false;
                        error.setAttribute("tabindex", "-1");
                        error.focus();
                      }
                      throw failure;
                    } finally {
                      pending = false;
                      release();
                      if (
                        originalEditor?.isConnected &&
                        document.activeElement === document.body
                      ) {
                        const target =
                          acceptedTrigger?.isConnected &&
                          !acceptedTrigger.hidden &&
                          !acceptedTrigger.disabled
                            ? acceptedTrigger
                            : (actions?.querySelector<HTMLButtonElement>(
                                "[data-confirm-trigger]:not([hidden]):not(:disabled)",
                              ) ??
                              document.querySelector<HTMLElement>(
                                "[data-course-status]",
                              ));
                        target?.focus();
                      }
                      button.removeAttribute("aria-busy");
                    }
                  },
                  {
                    loading: { title: "Guardando…" },
                    success: {
                      title:
                        messages[
                          intent === "publish"
                            ? "published"
                            : intent === "withdraw"
                              ? "withdrawn"
                              : "archived"
                        ] ?? "Cambio guardado.",
                    },
                    error: (failure) => ({
                      title:
                        failure instanceof Error
                          ? failure.message
                          : "No se pudo completar la acción.",
                    }),
                  },
                )
                .catch(() => {});
            });
          }
          document
            .querySelectorAll<HTMLFormElement>(
              ".mutation-form:not([data-astro-reload])",
            )
            .forEach((form) =>
              form.addEventListener("submit", (event) => {
                event.preventDefault();
                const button = form.querySelector<HTMLButtonElement>(
                  'button[type="submit"]',
                );
                if (!button || pending) return;
                const release = acquireCourseMutation(form);
                if (!release) return;
                pending = true;
                if (retry) retry.hidden = true;
                if (error) error.hidden = true;
                button.disabled = true;
                void notifications
                  .promise(
                    async () => {
                      try {
                        const response = await fetch(mutationPath, {
                          method: "POST",
                          headers: { Accept: "application/json" },
                          body: new FormData(form),
                        });
                        if (
                          response.redirected ||
                          !response.headers
                            .get("content-type")
                            ?.includes("application/json")
                        )
                          throw new Error(
                            "La sesión cambió. Recarga la página e inténtalo de nuevo.",
                          );
                        const result: unknown = await response.json();
                        if (
                          !response.ok ||
                          !result ||
                          typeof result !== "object" ||
                          !isEditorialResult(result, "feature")
                        )
                          throw new Error(
                            result &&
                              typeof result === "object" &&
                              "message" in result &&
                              typeof result.message === "string"
                              ? result.message
                              : "No se pudo completar la acción.",
                          );
                        if (
                          !("status" in result) ||
                          typeof result.status !== "string" ||
                          !("featured" in result) ||
                          typeof result.featured !== "boolean" ||
                          typeof result.revision !== "string"
                        )
                          throw new Error(
                            "Respuesta no válida. Inténtalo nuevamente.",
                          );
                        renderEditorial({
                          status: result.status,
                          revision: result.revision,
                          featured: result.featured,
                        });
                      } catch (failure) {
                        failedForm = form;
                        failedIntent = "feature";
                        if (retry) retry.hidden = false;
                        if (error) {
                          error.textContent =
                            failure instanceof Error
                              ? failure.message
                              : "No se pudo completar la acción.";
                          error.hidden = false;
                        }
                        throw failure;
                      } finally {
                        pending = false;
                        release();
                      }
                    },
                    {
                      loading: { title: "Guardando…" },
                      success: { title: "Curso seleccionado como destacado." },
                      error: (failure) => ({
                        title:
                          failure instanceof Error
                            ? failure.message
                            : "No se pudo completar la acción.",
                      }),
                    },
                  )
                  .catch(() => {});
              }),
            );
        });
      </script>
    </>
  )}
</PrivateLayout>
