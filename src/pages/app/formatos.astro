---
import { Plus } from "lucide-react";
import { listFormats } from "@/application/courses/manage-formats";
import type { CourseFormat } from "@/domain/courses/formats";
import CourseBreadcrumbs from "@/components/courses/CourseBreadcrumbs.astro";
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import { requireInternalUser } from "@/server/auth/context";
import { getDatabase } from "@/server/db/client";
import { DrizzleFormatRepository } from "@/server/db/repositories/format-repository";
import { CourseInfrastructureError } from "@/server/db/repositories/course-infrastructure-error";
import { logCourseInfrastructureError } from "@/server/courses/errors";

const user = requireInternalUser(Astro.locals);
let formats: readonly CourseFormat[] = [];
let loadError = false;
try {
  formats = await listFormats(new DrizzleFormatRepository(getDatabase()), user);
} catch (error) {
  Astro.response.status = 500;
  loadError = true;
  if (error instanceof CourseInfrastructureError)
    logCourseInfrastructureError(error, { actorId: user.id });
}
const successMessages: Record<string, string> = {
  deleted: "Formato eliminado.",
  created: "Formato creado.",
};
const success = Astro.url.searchParams.get("success");
---

<PrivateLayout title="Formatos de curso">
  <header>
    <CourseBreadcrumbs current="Formatos" />
    <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Formatos de curso
        </h1>
        <p class="mt-3 leading-7 text-muted-foreground">
          Gestiona la duración y los precios de los cursos.
        </p>
      </div>
      <a
        href="/app/formatos/nuevo"
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-primary px-5 text-sm font-semibold text-primary-foreground hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        <Plus size={18} aria-hidden="true" /> Nuevo formato
      </a>
    </div>
  </header>
  {success && successMessages[success] && (
    <noscript>
      <p
        role="status"
        class="mt-6 rounded-lg border bg-secondary px-4 py-3 text-sm"
      >
        {successMessages[success]}
      </p>
    </noscript>
  )}
  {loadError ? (
    <p role="alert" class="mt-8 rounded-xl border p-6 text-destructive">
      No se pudieron cargar los formatos. Inténtalo nuevamente.
    </p>
  ) : formats.length === 0 ? (
    <section class="mt-8 rounded-xl border border-dashed bg-card p-7">
      <h2 class="text-lg font-semibold">Aún no hay formatos</h2>
      <p class="mt-2 text-muted-foreground">
        Crea el primero para asignar duración y precios a los cursos.
      </p>
      <a
        href="/app/formatos/nuevo"
        class="mt-4 inline-flex min-h-11 items-center font-semibold underline underline-offset-4"
      >
        Crear primer formato
      </a>
    </section>
  ) : (
    <section class="mt-8" aria-label="Formatos existentes">
      <ul class="grid gap-4 lg:grid-cols-2">
        {formats.map((format) => (
          <li>
            <a
              href={`/app/formatos/${format.id}`}
              aria-labelledby={`format-${format.id}-name`}
              class="block h-full rounded-xl border bg-card p-5 shadow-xs transition-colors hover:border-primary/50 hover:bg-secondary/30 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 sm:p-6"
            >
              <article>
                <div class="flex items-start justify-between gap-4">
                  <h2
                    id={`format-${format.id}-name`}
                    class="text-lg font-semibold"
                  >
                    {format.name}
                  </h2>
                  <span class="shrink-0 rounded-full bg-secondary px-3 py-1 text-xs font-semibold text-secondary-foreground">
                    {format.active ? "Activo" : "Inactivo"}
                  </span>
                </div>
                <p class="mt-3 text-sm text-muted-foreground">
                  {format.totalHours} horas · Revisión {format.revisionNumber}
                </p>
                <p class="mt-2 text-sm tabular-nums">
                  Estudiante {format.studentAmount} BOB · Externo{" "}
                  {format.externalAmount} BOB
                </p>
              </article>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  <script>
    import { sileo } from "sileo";

    const success = new URLSearchParams(window.location.search).get("success");
    const messages: Record<string, string> = {
      deleted: "Formato eliminado.",
      created: "Formato creado.",
    };
    const message = success ? messages[success] : undefined;
    if (message) {
      window.addEventListener(
        "load",
        () => {
          sileo.success({ title: message, duration: 6000 });
          const url = new URL(window.location.href);
          url.searchParams.delete("success");
          window.history.replaceState(
            window.history.state,
            "",
            `${url.pathname}${url.search}${url.hash}`,
          );
        },
        { once: true },
      );
    }
  </script>
</PrivateLayout>
