---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import InstructorRoster from "@/components/pre-registrations/InstructorRoster.astro";
import RegistrationPageError from "@/components/pre-registrations/RegistrationPageError.astro";
import { getAssignedCourse } from "@/application/instructors/assigned-courses";
import { getInstructorRoster } from "@/application/pre-registrations/manage-registrations";
import { DrizzleAssignedCourseRepository } from "@/server/db/repositories/assigned-course-repository";
import { createRegistrationRepository } from "@/server/db/repositories/registration-repository";
import { getDatabase } from "@/server/db/client";
import { requireInternalUser } from "@/server/auth/context";
import { RegistrationError } from "@/domain/pre-registrations/errors";
import { validateRegistrationId } from "@/domain/pre-registrations/validation";
import { registrationFailure } from "@/server/pre-registrations/http";
import type { InstructorRosterEntryDto } from "@/domain/pre-registrations/types";
if (Astro.request.method !== "GET")
  return new Response(null, { status: 405, headers: { Allow: "GET" } });
Astro.response.headers.set("Cache-Control", "private, no-store");
const actor = requireInternalUser(Astro.locals);
let assigned: Awaited<ReturnType<typeof getAssignedCourse>> = null;
let entries: readonly InstructorRosterEntryDto[] = [];
let available = false;
let message = "";
try {
  const courseId = validateRegistrationId(Astro.params.id, "courseId");
  const groupId = validateRegistrationId(Astro.params.groupId, "groupId");
  assigned = await getAssignedCourse(
    new DrizzleAssignedCourseRepository(getDatabase()),
    actor,
    courseId,
  );
  if (!assigned || !assigned.groups.some((group) => group.id === groupId))
    throw new RegistrationError("NOT_FOUND", "Grupo no disponible.");
  available = new Date() >= assigned.course.startsAt;
  // No roster query/serialization before start. Repository rechecks ownership and start.
  if (available)
    entries = await getInstructorRoster(
      createRegistrationRepository(),
      actor,
      courseId,
      groupId,
    );
} catch (error) {
  const failure = registrationFailure(error);
  Astro.response.status = failure.status;
  message = failure.payload.message;
  entries = [];
}
---

<PrivateLayout title="Participantes del grupo">
  <a
    href={`/app/mis-cursos/${Astro.params.id}`}
    class="text-sm underline underline-offset-4"
  >
    Volver al curso
  </a>
  <h1 class="mt-5 break-words text-3xl font-semibold">
    {assigned?.course.name ?? "Grupo no disponible"}
  </h1>
  {message ? (
    <RegistrationPageError {message} />
  ) : (
    <div class="mt-8">
      <InstructorRoster {entries} {available} />
    </div>
  )}
</PrivateLayout>
