---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import {
  listAssignedCourses,
  type AssignedCourse,
} from "@/application/instructors/assigned-courses";
import { requireInternalUser } from "@/server/auth/context";
import { getDatabase } from "@/server/db/client";
import { DrizzleAssignedCourseRepository } from "@/server/db/repositories/assigned-course-repository";
if (Astro.request.method !== "GET")
  return new Response(null, { status: 405, headers: { Allow: "GET" } });
let courses: readonly AssignedCourse[] = [];
let error = false;
try {
  courses = await listAssignedCourses(
    new DrizzleAssignedCourseRepository(getDatabase()),
    requireInternalUser(Astro.locals),
  );
} catch {
  error = true;
  Astro.response.status = 503;
}
---

<PrivateLayout title="Mis cursos">
  <h1 class="text-3xl font-semibold tracking-tight">Mis cursos</h1>
  <p class="mt-3 text-muted-foreground">
    Consulta el calendario y los grupos de los cursos que tienes asignados.
  </p>
  {error ? (
    <p role="alert" class="mt-8 text-destructive">
      No se pudieron cargar tus cursos. Recarga para intentarlo nuevamente.
    </p>
  ) : courses.length === 0 ? (
    <p class="mt-8" role="status">
      Todavía no tienes cursos asignados.
    </p>
  ) : (
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {courses.map((course) => (
        <li>
          <a
            href={`/app/mis-cursos/${course.id}`}
            class="flex h-full flex-col gap-3 rounded-xl border bg-card p-6 outline-none hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring"
          >
            <h2 class="break-words text-xl font-semibold">{course.name}</h2>
            <p class="text-sm text-muted-foreground">{course.description}</p>
          </a>
        </li>
      ))}
    </ul>
  )}
</PrivateLayout>
