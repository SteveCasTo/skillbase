---
import { listCertificateCourses } from "@/application/certificates/list-certificate-courses";
import {
  certificateCourseFilters,
  parseCertificateCourseFilter,
  matchesCertificateCourseFilter,
} from "@/domain/certificates/course-filters";
import ListStatusFilter from "@/components/lists/ListStatusFilter";
import type { AdminCourseDto } from "@/domain/courses/types";
import { instantToBoliviaCivil } from "@/domain/courses/bolivia-time";
import { normalizeRegistrationSearch } from "@/domain/pre-registrations/search";
import type { ClosedAcademicGroup } from "@/application/academic-closure/closure-repository";
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import CourseBreadcrumbs from "@/components/courses/CourseBreadcrumbs.astro";
import RegistrationPageError from "@/components/pre-registrations/RegistrationPageError.astro";
import { buttonVariants } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { requireInternalUser } from "@/server/auth/context";
import { getDatabase } from "@/server/db/client";
import { DrizzleClosureRepository } from "@/server/db/repositories/academic-closure-repository";
import { DrizzleCourseRepository } from "@/server/db/repositories/course-repository";
import {
  certificateMethodNotAllowed,
  setCertificateHeaders,
} from "@/components/certificates/route";
setCertificateHeaders(Astro);
void certificateMethodNotAllowed;
if (Astro.request.method !== "GET") return certificateMethodNotAllowed("GET");
const actor = requireInternalUser(Astro.locals);
const search = Astro.url.searchParams.get("search") ?? "";
const query = normalizeRegistrationSearch(search);
let status: ReturnType<typeof parseCertificateCourseFilter> = "ACTIVE";
try {
  status = parseCertificateCourseFilter(Astro.url.searchParams.get("status"));
} catch {
  return new Response("Selecciona Activos, Archivados o Todos.", {
    status: 400,
    headers: Astro.response.headers,
  });
}
let courses: {
  id: string;
  name: string;
  status: AdminCourseDto["status"];
  groups: readonly ClosedAcademicGroup[];
}[] = [];
let error = false;
try {
  const database = getDatabase();
  courses = await listCertificateCourses(
    new DrizzleCourseRepository(database),
    new DrizzleClosureRepository(database),
    actor,
  );
} catch {
  error = true;
  Astro.response.status = 503;
}
const entries = courses.map((course) => ({
  course,
  searchable: normalizeRegistrationSearch(course.name),
}));
const matches = entries.filter(
  ({ course, searchable }) =>
    searchable.includes(query) &&
    matchesCertificateCourseFilter(course.status, status),
);
const hasMatches = matches.length > 0;
---

<PrivateLayout title="Certificados">
  <CourseBreadcrumbs
    current="Certificados"
    parents={[{ label: "Inicio", href: "/app" }]}
  />
  <header class="mt-5">
    <h1 class="text-3xl font-semibold tracking-tight">Certificados</h1>
    <p class="mt-2 text-sm text-muted-foreground">
      Solo grupos con cierre académico vigente. Activos muestra cursos no
      archivados.
    </p>
  </header>
  {!error && (
    <form
      data-certificate-course-search
      method="get"
      class="mt-8 flex min-w-0 flex-col gap-2"
      role="search"
      aria-label="Buscar cursos"
    >
      <label for="certificate-course-search" class="text-sm font-medium">
        Buscar cursos
      </label>
      <div class="flex min-w-0 flex-wrap items-center gap-3">
        <Input
          id="certificate-course-search"
          name="search"
          type="search"
          autoComplete="off"
          defaultValue={search}
          className="min-h-11 min-w-0 flex-1 basis-48"
        />
        <input type="hidden" name="status" value={status} data-list-status />
        <ListStatusFilter
          client:load
          value={status}
          options={certificateCourseFilters}
          label="Estado del curso"
        />
      </div>
      <noscript>
        <div class="flex flex-wrap gap-3">
          {certificateCourseFilters.map((option) => (
            <a
              href={`?${new URLSearchParams({ search, status: option.value })}`}
              class="underline underline-offset-4"
            >
              {option.label}
            </a>
          ))}
        </div>
        <button
          type="submit"
          class={buttonVariants({
            variant: "outline",
            className: "min-h-11 self-end",
          })}
        >
          Buscar
        </button>
      </noscript>
    </form>
  )}
  {error ? (
    <RegistrationPageError
      message="No se pudieron cargar los grupos cerrados. Intenta de nuevo."
      retryHref={Astro.url.pathname + Astro.url.search}
    />
  ) : (
    <>
      <p
        data-certificate-course-count
        role="status"
        class="mt-6 text-sm text-muted-foreground"
      >
        {matches.length} {matches.length === 1 ? "curso" : "cursos"}
      </p>
      <p
        data-certificate-course-search-empty
        role="status"
        hidden={hasMatches}
        class="mt-8 text-muted-foreground"
      >
        No hay cursos con cierre académico vigente que coincidan con la búsqueda
        y el estado seleccionado.
        <a href="?status=ALL" class="underline underline-offset-4">
          Ver todos
        </a>
      </p>
      <ul
        data-certificate-course-search-results
        hidden={!hasMatches}
        class="mt-8 flex min-w-0 flex-col gap-6"
      >
        {entries.map(({ course, searchable }) => (
          <li
            data-certificate-course-search-entry={searchable}
            data-certificate-course-status={course.status}
            hidden={
              !searchable.includes(query) ||
              !matchesCertificateCourseFilter(course.status, status)
            }
            class="min-w-0"
          >
            <h2 class="break-words text-xl font-semibold">{course.name}</h2>
            <ul class="mt-3 grid min-w-0 gap-3 sm:grid-cols-2 xl:grid-cols-3">
              {course.groups.map((group) => (
                <li class="min-w-0">
                  <a
                    href={`/app/cursos/${course.id}/grupos/${group.id}/certificados`}
                    class="flex min-h-16 items-center rounded-xl border bg-card p-4 text-sm font-medium hover:bg-secondary focus-visible:outline-2 focus-visible:outline-ring"
                  >
                    Grupo ·{" "}
                    {instantToBoliviaCivil(group.startsAt).slice(11, 16)} a{" "}
                    {instantToBoliviaCivil(group.endsAt).slice(11, 16)}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </>
  )}
</PrivateLayout>

<script>
  import { normalizeRegistrationSearch } from "@/domain/pre-registrations/search";
  import {
    parseCertificateCourseFilter,
    matchesCertificateCourseFilter,
  } from "@/domain/certificates/course-filters";
  import type { AdminCourseDto } from "@/domain/courses/types";

  let dispose: (() => void) | undefined;
  const init = () => {
    dispose?.();
    const form = document.querySelector<HTMLFormElement>(
      "[data-certificate-course-search]",
    );
    const input = form?.querySelector<HTMLInputElement>('input[name="search"]');
    const statusInput =
      form?.querySelector<HTMLInputElement>("[data-list-status]");
    const countLabel = document.querySelector<HTMLElement>(
      "[data-certificate-course-count]",
    );
    const results = document.querySelector<HTMLElement>(
      "[data-certificate-course-search-results]",
    );
    const empty = document.querySelector<HTMLElement>(
      "[data-certificate-course-search-empty]",
    );
    if (!form || !input || !statusInput || !results || !empty) return;

    const entries = [
      ...results.querySelectorAll<HTMLElement>(
        "[data-certificate-course-search-entry]",
      ),
    ];
    const controller = new AbortController();
    const apply = (updateUrl: boolean) => {
      const query = normalizeRegistrationSearch(input.value);
      const status = parseCertificateCourseFilter(statusInput.value);
      let count = 0;
      for (const entry of entries) {
        entry.hidden =
          !entry.dataset.certificateCourseSearchEntry?.includes(query) ||
          !matchesCertificateCourseFilter(
            entry.dataset.certificateCourseStatus as AdminCourseDto["status"],
            status,
          );
        if (!entry.hidden) count++;
      }
      results.hidden = count === 0;
      empty.hidden = count > 0;
      if (countLabel)
        countLabel.textContent = `${count} ${count === 1 ? "curso" : "cursos"}`;
      if (updateUrl) {
        const url = new URL(window.location.href);
        if (query) url.searchParams.set("search", input.value);
        else url.searchParams.delete("search");
        url.searchParams.set("status", status);
        url.searchParams.delete("page");
        window.history.replaceState(window.history.state, "", url);
      }
    };
    input.addEventListener("input", () => apply(true), {
      signal: controller.signal,
    });
    statusInput.addEventListener("change", () => apply(true), {
      signal: controller.signal,
    });
    form.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();
        apply(true);
      },
      { signal: controller.signal },
    );
    window.addEventListener(
      "popstate",
      () => {
        input.value =
          new URL(window.location.href).searchParams.get("search") ?? "";
        statusInput.value = parseCertificateCourseFilter(
          new URL(window.location.href).searchParams.get("status"),
        );
        statusInput.dispatchEvent(new Event("list-status-sync"));
        apply(false);
      },
      { signal: controller.signal },
    );
    apply(false);
    dispose = () => controller.abort();
  };

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => {
    dispose?.();
    dispose = undefined;
  });
  init();
</script>
