---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import ParticipantEditForm from "@/components/pre-registrations/ParticipantEditForm.astro";
import RegistrationPageError from "@/components/pre-registrations/RegistrationPageError.astro";
import { requireInternalUser } from "@/server/auth/context";
import { getRegistrationDetail } from "@/application/pre-registrations/manage-registrations";
import { createRegistrationRepository } from "@/server/db/repositories/registration-repository";
import {
  handleRegistrationPost,
  registrationFailure,
  registrationJson as jsonResponse,
  singleQuery,
  wantsRegistrationJson,
} from "@/server/pre-registrations/http";
import { getPublicAuthEnvironment } from "@/server/environment";
import { RegistrationError } from "@/domain/pre-registrations/errors";
import { validateRegistrationId } from "@/domain/pre-registrations/validation";
import type {
  ParticipantDto,
  ParticipantData,
} from "@/domain/pre-registrations/types";
void jsonResponse; // Astro checker omits imported references in returned responses.
const actor = requireInternalUser(Astro.locals);
Astro.response.headers.set("Cache-Control", "private, no-store");
const repository = createRegistrationRepository();
const id = Astro.params.id ?? "";
let participant: ParticipantDto | null = null;
let values: Record<string, string> = {};
let message = "";
let errors: Readonly<Record<string, string>> = {};
let registrationId = "";
try {
  if (!["GET", "POST"].includes(Astro.request.method))
    return new Response(null, { status: 405, headers: { Allow: "GET, POST" } });
  validateRegistrationId(id, "participantId");
  registrationId = singleQuery(Astro.url.searchParams, "registrationId");
  const detail = await getRegistrationDetail(repository, actor, registrationId);
  if (!detail || detail.registration.participant.id !== id)
    throw new RegistrationError(
      "NOT_FOUND",
      "Abre la ficha desde una preinscripción de esta persona.",
    );
  participant = detail.registration.participant;
  if (Astro.request.method === "POST") {
    const result = await handleRegistrationPost({
      request: Astro.request,
      actor,
      repository,
      operation: "participant",
      participantId: id,
      siteUrl: getPublicAuthEnvironment().siteUrl,
    });
    if (wantsRegistrationJson(Astro.request))
      return jsonResponse(result.payload, result.status);
    if (result.payload.ok)
      return Astro.redirect(
        `/app/participantes/${id}?registrationId=${registrationId}&success=updated`,
        303,
      );
    values = result.values;
    message = result.payload.message;
    errors = result.payload.issues;
    Astro.response.status = result.status;
  }
} catch (error) {
  const failure = registrationFailure(error);
  Astro.response.status = failure.status;
  message = failure.payload.message;
  participant = null;
  if (wantsRegistrationJson(Astro.request))
    return jsonResponse(failure.payload, failure.status);
}
const attemptedValues: ParticipantData | undefined =
  values.firstName !== undefined
    ? {
        ci: values.ci ?? "",
        firstName: values.firstName ?? "",
        lastName: values.lastName ?? "",
        email: values.email ?? "",
        phone: values.phone || null,
      }
    : undefined;
---

<PrivateLayout title="Ficha global">
  <a
    href={
      registrationId
        ? `/app/preinscripciones/${registrationId}`
        : "/app/participantes"
    }
    class="text-sm underline underline-offset-4"
  >
    Volver
  </a>
  <h1 class="mt-5 text-3xl font-semibold">Ficha global de participante</h1>
  {participant ? (
    <div class="mt-8">
      <ParticipantEditForm
        id="participant-edit"
        lastSubmitted={Object.keys(values).length ? values : undefined}
        participant={{
          ...participant,
          revision: values.revision ?? participant.revision,
        }}
        {...(attemptedValues ? { values: attemptedValues } : {})}
        action={`/app/participantes/${id}?registrationId=${registrationId}`}
        requestKey={values.requestKey || crypto.randomUUID()}
        {errors}
        {...(message ? { message } : {})}
      />
      {Astro.url.searchParams.has("success") && (
        <p role="status" class="mt-4 text-sm">
          Ficha global actualizada.
        </p>
      )}
    </div>
  ) : (
    <RegistrationPageError {message} />
  )}
</PrivateLayout>
<script>
  import { initializeRegistrationHttp } from "@/components/pre-registrations/http-client";
  initializeRegistrationHttp();
  document.addEventListener("astro:page-load", initializeRegistrationHttp);
</script>
