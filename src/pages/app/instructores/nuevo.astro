---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import PrivateBreadcrumbs from "@/components/courses/CourseBreadcrumbs.astro";
import InstructorForm from "@/components/instructors/InstructorForm.astro";
import { instructorEditor } from "@/server/instructors/editor";
const editor = await instructorEditor(Astro);
if (editor.response) return editor.response;
---

<PrivateLayout title="Nuevo instructor">
  <PrivateBreadcrumbs
    current="Nuevo instructor"
    parents={[
      { label: "Resumen", href: "/app" },
      { label: "Instructores", href: "/app/instructores" },
    ]}
  />
  <h1 class="mt-5 text-3xl font-semibold tracking-tight">Crear instructor</h1>
  <p class="mt-3 text-muted-foreground">
    Registra su perfil y contraseña de acceso.
  </p>
  <InstructorForm
    values={editor.values}
    errors={editor.errors}
    error={editor.error}
  />
</PrivateLayout>
