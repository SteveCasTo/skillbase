---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import PrivateBreadcrumbs from "@/components/courses/CourseBreadcrumbs.astro";
import { buttonVariants } from "@/components/ui/button";
import SearchToolbar from "@/components/lists/SearchToolbar.astro";
import ListSearchEmpty from "@/components/lists/ListSearchEmpty.astro";
import {
  accountFilters,
  matchesListFilter,
  selectedListFilter,
} from "@/components/lists/filters";
import { normalizeRegistrationSearch } from "@/domain/pre-registrations/search";
import { listInstructors } from "@/application/instructors/manage-instructors";
import { requireInternalUser } from "@/server/auth/context";
import { getDatabase } from "@/server/db/client";
import { DrizzleInstructorRepository } from "@/server/db/repositories/instructor-repository";
import {
  instructorFullName,
  type InstructorProfile,
} from "@/domain/instructors/profile";
let instructors: readonly InstructorProfile[] = [];
let error = false;
const search = Astro.url.searchParams.get("search") ?? "";
const query = normalizeRegistrationSearch(search);
const status = selectedListFilter(
  Astro.url.searchParams.get("status"),
  accountFilters,
);
try {
  instructors = await listInstructors(
    new DrizzleInstructorRepository(getDatabase()),
    requireInternalUser(Astro.locals),
  );
} catch {
  error = true;
  Astro.response.status = 503;
}
const entries = instructors.map((instructor) => ({
  instructor,
  searchable: normalizeRegistrationSearch(
    `${instructorFullName(instructor)} ${instructor.email}`,
  ),
}));
const hasMatches = entries.some(
  ({ instructor, searchable }) =>
    searchable.includes(query) && matchesListFilter(instructor.status, status),
);
---

<PrivateLayout title="Instructores">
  <div class="mb-5">
    <PrivateBreadcrumbs
      current="Instructores"
      parents={[{ label: "Inicio", href: "/app" }]}
    />
  </div>
  {Astro.url.searchParams.get("success") === "deleted" && (
    <noscript>
      <p role="status" class="mb-6">
        Instructor eliminado.
      </p>
    </noscript>
  )}
  <header class="flex flex-wrap items-start justify-between gap-5">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">Instructores</h1>
      <p class="mt-3 text-muted-foreground">
        Perfiles del equipo y acceso a sus cursos asignados.
      </p>
    </div>
    <a
      href="/app/instructores/nuevo"
      class={buttonVariants({ className: "min-h-11" })}
    >
      Crear instructor
    </a>
  </header>
  <div data-search-list="instructores">
    <SearchToolbar
      id="instructor-search"
      label="Buscar por nombre o correo"
      {search}
      {status}
      options={accountFilters}
    />
    {error ? (
      <p role="alert" class="mt-8 text-destructive">
        No se pudieron cargar los instructores. Recarga para intentarlo
        nuevamente.
      </p>
    ) : instructors.length === 0 ? (
      <section class="mt-8 rounded-xl border p-6">
        <h2 class="text-lg font-semibold">Todavía no hay instructores</h2>
        <p class="mt-2 text-muted-foreground">
          Crea el primer perfil para asignarlo a un curso.
        </p>
      </section>
    ) : (
      <>
        <ListSearchEmpty
          hidden={hasMatches}
          message={
            query
              ? "No hay instructores que coincidan. Prueba otro nombre o correo."
              : `No hay instructores en «${accountFilters.find((option) => option.value === status)?.label}».`
          }
          resetHref="/app/instructores?status=ALL"
        />
        <ul
          data-list-results
          hidden={!hasMatches}
          class="mt-8 grid min-w-0 gap-4 sm:grid-cols-2 xl:grid-cols-3"
        >
          {entries.map(({ instructor, searchable }) => (
            <li
              data-list-entry={searchable}
              data-list-status={instructor.status}
              hidden={
                !searchable.includes(query) ||
                !matchesListFilter(instructor.status, status)
              }
              class="flex min-w-0 flex-col gap-2"
            >
              <a
                href={`/app/instructores/${instructor.id}/editar`}
                class="flex h-full min-w-0 flex-col gap-3 rounded-xl border bg-card p-6 outline-none hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring"
              >
                <h2 class="break-words text-xl font-semibold">
                  {instructorFullName(instructor)}
                </h2>
                <p class="break-all text-sm text-muted-foreground">
                  {instructor.email}
                </p>
                <p class="text-sm">
                  {instructor.status === "ACTIVE"
                    ? "Cuenta activa"
                    : instructor.status === "DISABLED"
                      ? "Cuenta desactivada"
                      : "Acceso no habilitado"}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</PrivateLayout>
