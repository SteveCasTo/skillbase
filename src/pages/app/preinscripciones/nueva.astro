---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import RegistrationForm from "@/components/pre-registrations/RegistrationForm.astro";
import ParticipantSearch from "@/components/pre-registrations/ParticipantSearch.astro";
import RegistrationPageError from "@/components/pre-registrations/RegistrationPageError.astro";
import { requireInternalUser } from "@/server/auth/context";
import { createRegistrationRepository } from "@/server/db/repositories/registration-repository";
import { getRegistrationForm } from "@/application/pre-registrations/manage-registrations";
import {
  loadRegistrationChoices,
  lookupRegistrationPeople,
} from "@/server/pre-registrations/loaders";
import {
  handleRegistrationPost,
  registrationFailure,
  registrationJson as jsonResponse,
  singleQuery,
  wantsRegistrationJson,
} from "@/server/pre-registrations/http";
import { getPublicAuthEnvironment } from "@/server/environment";
import type {
  RegistrationFormDto,
  ParticipantDto,
} from "@/domain/pre-registrations/types";
import type { AdminInterestRegistrationDto } from "@/domain/interests/types";
import { RegistrationError } from "@/domain/pre-registrations/errors";
import { validateRegistrationId } from "@/domain/pre-registrations/validation";
void jsonResponse; // Astro checker omits imported references in returned responses.
const actor = requireInternalUser(Astro.locals);
Astro.response.headers.set("Cache-Control", "private, no-store");
const now = new Date();
const repository = createRegistrationRepository();
let values: Record<string, string> = {};
let errors: Readonly<Record<string, string>> = {};
let message = "";
let form: RegistrationFormDto | null = null;
let choices: readonly RegistrationFormDto[] = [];
let participants: readonly ParticipantDto[] = [];
let interests: readonly AdminInterestRegistrationDto[] = [];
let participant: ParticipantDto | undefined;
let courseId = "";
let search = "";
try {
  if (!["GET", "POST"].includes(Astro.request.method))
    return new Response(null, { status: 405, headers: { Allow: "GET, POST" } });
  if (Astro.request.method === "POST") {
    const result = await handleRegistrationPost({
      request: Astro.request,
      actor,
      repository,
      operation: "create",
      siteUrl: getPublicAuthEnvironment().siteUrl,
      now,
    });
    if (wantsRegistrationJson(Astro.request))
      return jsonResponse(result.payload, result.status);
    if (result.payload.ok && result.payload.value.kind === "created")
      return Astro.redirect(
        result.payload.value.location + "?success=created",
        303,
      );
    if (!result.payload.ok) {
      values = result.values;
      message = result.payload.message;
      errors = result.payload.issues;
      Astro.response.status = result.status;
    }
  }
  courseId = values.courseId || singleQuery(Astro.url.searchParams, "courseId");
  const sourceInterestId =
    values.sourceInterestId ??
    singleQuery(Astro.url.searchParams, "sourceInterestId");
  if (courseId) {
    form = await getRegistrationForm(
      repository,
      actor,
      courseId,
      sourceInterestId || undefined,
    );
    if (!form) throw new RegistrationError("NOT_FOUND", "Curso no encontrado.");
    search = singleQuery(Astro.url.searchParams, "search");
    if (search.length >= 2)
      ({ participants, interests } = await lookupRegistrationPeople(
        actor,
        search,
        courseId,
      ));
    const participantId = singleQuery(Astro.url.searchParams, "participantId");
    if (participantId) {
      validateRegistrationId(participantId, "participantId");
      participant = participants.find((row) => row.id === participantId);
      if (!participant)
        throw new RegistrationError(
          "NOT_FOUND",
          "Busca la ficha vigente por CI o nombre.",
        );
    }
  } else
    choices = (await loadRegistrationChoices(actor)).filter(
      (row) => row.course.status === "PUBLISHED" && row.course.instructorActive,
    );
} catch (error) {
  const failure = registrationFailure(error);
  Astro.response.status = failure.status;
  message = failure.payload.message;
}
const action = "/app/preinscripciones/nueva";
const hrefs = Object.fromEntries([
  ...participants.map((row) => [
    row.id,
    `${action}?${new URLSearchParams({ courseId, search, participantId: row.id })}`,
  ]),
  ...interests.map((row) => [
    row.id,
    `${action}?${new URLSearchParams({ courseId, sourceInterestId: row.id })}`,
  ]),
]);
---

<PrivateLayout title="Registrar preinscripción">
  <nav
    aria-label="Ruta de navegación"
    class="flex flex-wrap items-center gap-2 text-sm"
  >
    <a href="/app/preinscripciones" class="underline underline-offset-4">
      Preinscripciones
    </a>
    {form && (
      <>
        <span aria-hidden="true">/</span>
        <a
          href={`/app/preinscripciones?courseId=${form.course.id}`}
          class="break-words underline underline-offset-4"
        >
          {form.course.name}
        </a>
      </>
    )}
    <span aria-hidden="true">/</span>
    <span aria-current="page">Nueva</span>
  </nav>
  {form && (
    <a
      href="/app/preinscripciones/nueva"
      class="mt-3 inline-flex min-h-11 items-center text-sm underline underline-offset-4"
    >
      Cambiar curso
    </a>
  )}
  <h1 class="mt-5 text-3xl font-semibold tracking-tight">
    Registrar preinscripción
  </h1>
  {form ? (
    <div class="mt-8 flex min-w-0 flex-col gap-8">
      <div data-registration-lookup data-lookup-course={courseId}>
        <ParticipantSearch
          id="registration-person-search"
          {courseId}
          {participants}
          {interests}
          action={Astro.url.pathname}
          query={search}
          chooseHrefs={hrefs}
          targetFormId="registration-create"
        />
      </div>
      <RegistrationForm
        id="registration-create"
        {form}
        {action}
        serverNow={now.toISOString()}
        requestKey={values.requestKey || crypto.randomUUID()}
        {values}
        {errors}
        {...(participant ? { participant, participantReadonly: true } : {})}
        {...(message ? { message } : {})}
      />
    </div>
  ) : message ? (
    <RegistrationPageError {message} retryHref="/app/preinscripciones/nueva" />
  ) : (
    <section class="mt-8">
      <h2 class="text-xl font-semibold">Curso</h2>
      {choices.length === 0 ? (
        <p class="mt-4 text-muted-foreground">
          No hay cursos disponibles para preinscripción con grupos activos y
          cupo. Revisa la fecha de registro, el instructor y los grupos del
          curso.
        </p>
      ) : (
        <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {choices.map((choice) => (
            <li class="min-w-0">
              <a
                href={`${action}?courseId=${choice.course.id}`}
                class="flex h-full min-w-0 flex-col gap-3 rounded-xl border p-5 transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring"
              >
                <span class="break-words font-semibold">
                  {choice.course.name}
                </span>
                <span class="text-sm text-muted-foreground">
                  {
                    choice.groups.filter(
                      (group) =>
                        group.status === "PLANNED" &&
                        group.occupied < group.capacity,
                    ).length
                  }{" "}
                  grupos con cupo
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  )}
</PrivateLayout>
<script>
  import { initializeRegistrationHttp } from "@/components/pre-registrations/http-client";
  initializeRegistrationHttp();
  document.addEventListener("astro:page-load", initializeRegistrationHttp);
</script>
