---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import RegistrationDetailPanel from "@/components/pre-registrations/RegistrationDetailPanel.astro";
import RegistrationPageError from "@/components/pre-registrations/RegistrationPageError.astro";
import { requireInternalUser } from "@/server/auth/context";
import {
  getRegistrationDetail,
  getRegistrationForm,
} from "@/application/pre-registrations/manage-registrations";
import { createRegistrationRepository } from "@/server/db/repositories/registration-repository";
import {
  handleRegistrationPost,
  registrationFailure,
  registrationJson as jsonResponse,
  singleQuery,
  wantsRegistrationJson,
  type RegistrationOperation,
} from "@/server/pre-registrations/http";
import { getPublicAuthEnvironment } from "@/server/environment";
import type {
  RegistrationDetailDto,
  RegistrationFormDto,
} from "@/domain/pre-registrations/types";
import { RegistrationError } from "@/domain/pre-registrations/errors";
void jsonResponse; // Astro checker omits imported references in returned responses.
const actor = requireInternalUser(Astro.locals);
Astro.response.headers.set("Cache-Control", "private, no-store");
const repository = createRegistrationRepository();
const id = Astro.params.id ?? "";
const now = new Date();
const fragment =
  Astro.request.method === "GET" &&
  Astro.request.headers.get("X-Registration-Fragment") === "1";
let detail: RegistrationDetailDto | null = null;
let form: RegistrationFormDto | null = null;
let values: Record<string, string> = {};
let errors: Readonly<Record<string, string>> = {};
let message = "";
let failedOperation: RegistrationOperation | undefined;
try {
  if (!["GET", "POST"].includes(Astro.request.method))
    return new Response(null, { status: 405, headers: { Allow: "GET, POST" } });
  if (Astro.request.method === "POST") {
    const operation = singleQuery(Astro.url.searchParams, "operation");
    if (!["payment", "refund", "transfer", "cancel"].includes(operation))
      throw new RegistrationError(
        "VALIDATION_FAILED",
        "Selecciona una operación válida.",
      );
    failedOperation = operation as RegistrationOperation;
    const result = await handleRegistrationPost({
      request: Astro.request,
      actor,
      repository,
      operation: failedOperation,
      registrationId: id,
      siteUrl: getPublicAuthEnvironment().siteUrl,
      now,
    });
    if (wantsRegistrationJson(Astro.request))
      return jsonResponse(result.payload, result.status);
    if (result.payload.ok)
      return Astro.redirect(`/app/preinscripciones/${id}?success=updated`, 303);
    values = result.values;
    errors = result.payload.issues;
    message = result.payload.message;
    Astro.response.status = result.status;
  }
  detail = await getRegistrationDetail(repository, actor, id);
  if (!detail)
    throw new RegistrationError("NOT_FOUND", "Preinscripción no encontrada.");
  form = await getRegistrationForm(
    repository,
    actor,
    detail.registration.courseId,
  );
  if (!form) throw new RegistrationError("NOT_FOUND", "Curso no encontrado.");
} catch (error) {
  const failure = registrationFailure(error);
  Astro.response.status = failure.status;
  message = failure.payload.message;
  detail = null;
  if (fragment || wantsRegistrationJson(Astro.request))
    return jsonResponse(failure.payload, failure.status);
}
---

{fragment && detail && form ? (
  <RegistrationDetailPanel {detail} {form} serverNow={now.toISOString()} />
) : (
  <PrivateLayout title="Detalle de preinscripción">
    <a
      href="/app/preinscripciones"
      class="text-sm underline underline-offset-4"
    >
      Preinscripciones
    </a>
    {detail && form ? (
      <>
        <header class="mt-5 flex flex-wrap items-start justify-between gap-5">
          <div>
            <h1
              data-registration-person-name
              class="break-words text-3xl font-semibold tracking-tight"
            >
              {detail.registration.participant.firstName}{" "}
              {detail.registration.participant.lastName}
            </h1>
            <p
              data-registration-course-group
              data-course-name={form.course.name}
              class="mt-3 break-words text-muted-foreground"
            >
              {detail.registration.courseName ?? form.course.name} ·{" "}
              {detail.registration.groupName ?? "Grupo asignado"}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              CI: {detail.registration.participant.ci}
            </p>
          </div>
          <a
            href={`/app/participantes/${detail.registration.participant.id}?registrationId=${id}`}
            class="inline-flex min-h-11 items-center underline underline-offset-4"
          >
            Editar ficha global
          </a>
        </header>
        {Astro.url.searchParams.has("success") && (
          <p role="status" class="mt-5 text-sm">
            Operación registrada. El estado y los importes están actualizados.
          </p>
        )}
        <RegistrationDetailPanel
          {detail}
          {form}
          serverNow={now.toISOString()}
          {failedOperation}
          {values}
          {errors}
          {...(message ? { message } : {})}
        />
        <p
          role="alert"
          data-registration-page-error
          class="mt-5 text-sm text-destructive empty:hidden"
        ></p>
      </>
    ) : (
      <>
        <h1 class="mt-5 text-3xl font-semibold">
          Preinscripción no disponible
        </h1>
        <RegistrationPageError {message} retryHref={Astro.url.pathname} />
      </>
    )}
  </PrivateLayout>
)}
<script>
  import { initializeRegistrationHttp } from "@/components/pre-registrations/http-client";
  initializeRegistrationHttp();
  document.addEventListener("astro:page-load", initializeRegistrationHttp);
</script>
