---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import CourseBreadcrumbs from "@/components/courses/CourseBreadcrumbs.astro";
import SettingsFields from "@/components/certificates/SettingsFields.astro";
import RegistrationPageError from "@/components/pre-registrations/RegistrationPageError.astro";
import { requireInternalUser } from "@/server/auth/context";
import { loadCertificateSettings } from "@/server/certificates/loaders";
import {
  certificateMutation,
  certificateMethodNotAllowed,
  emptyFeedback,
  setCertificateHeaders,
} from "@/components/certificates/route";
setCertificateHeaders(Astro);
void certificateMethodNotAllowed;
if (!["GET", "POST"].includes(Astro.request.method))
  return certificateMethodNotAllowed();
const actor = requireInternalUser(Astro.locals);
if (!actor.roles.includes("ADMIN"))
  return Astro.redirect("/unauthorized?reason=forbidden", 303);
if (Astro.request.method === "GET")
  return Astro.redirect("/app/configuracion#firmantes", 303);
let load = await loadCertificateSettings({ actor });
let feedback = emptyFeedback();
if (Astro.request.method === "POST" && load.available) {
  const result = await certificateMutation(
    Astro,
    "settings",
    load.data.configuration,
  );
  if (result instanceof Response) return result;
  feedback = result;
  if (result.success)
    return Astro.redirect(
      "/app/configuracion?success=certificates#firmantes",
      303,
    );
}
if (!load.available) Astro.response.status = load.status;
---

<PrivateLayout title="Configuración de certificados">
  <CourseBreadcrumbs
    current="Certificados"
    parents={[
      { label: "Inicio", href: "/app" },
      { label: "Configuración", href: "/app/configuracion" },
    ]}
  />
  <header class="mt-5 flex flex-col gap-3">
    <h1 class="text-3xl font-semibold tracking-tight">
      Configuración de certificados
    </h1>
  </header>
  {load.available ? (
    <div class="mt-8">
      {feedback.message && !feedback.values.field && (
        <p role="alert" class="mb-4 text-sm text-destructive">
          {feedback.message}
        </p>
      )}
      <SettingsFields
        configuration={load.data.configuration}
        revision={load.data.revision}
        {feedback}
      />
    </div>
  ) : (
    <RegistrationPageError
      message={load.unavailableReason}
      retryHref="/app/configuracion/certificados"
    />
  )}
</PrivateLayout>
