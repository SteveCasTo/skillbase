---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import PrivateBreadcrumbs from "@/components/courses/CourseBreadcrumbs.astro";
import AdminAccountForm from "@/components/admin-accounts/AdminAccountForm.astro";
import { adminAccountPage } from "@/server/admin-accounts/page";
const editor = await adminAccountPage(Astro);
if (editor.response) return editor.response;
---

<PrivateLayout title="Nuevo administrador">
  <PrivateBreadcrumbs
    current="Nuevo administrador"
    parents={[
      { label: "Resumen", href: "/app" },
      { label: "Administradores", href: "/app/administradores" },
    ]}
  />
  <h1 class="mt-5 text-3xl font-semibold tracking-tight">
    Crear administrador
  </h1>
  <p class="mt-3 text-muted-foreground">
    Registra su nombre, correo y contraseña de acceso.
  </p>
  <AdminAccountForm
    values={editor.values}
    issues={editor.issues}
    error={editor.error}
  />
</PrivateLayout>
