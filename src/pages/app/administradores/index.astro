---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import PrivateBreadcrumbs from "@/components/courses/CourseBreadcrumbs.astro";
import AdminAccountList from "@/components/admin-accounts/AdminAccountList.astro";
import { buttonVariants } from "@/components/ui/button";
import { requireInternalUser } from "@/server/auth/context";
import { requireRoles } from "@/application/auth/authorize";
import {
  adminAccountFailure,
  adminAccountHeaders,
} from "@/server/admin-accounts/http";
import { loadAdminAccounts } from "@/server/admin-accounts/loaders";
import type { AdminAccountDto } from "@/domain/admin-accounts/types";
const actor = requireInternalUser(Astro.locals);
requireRoles(actor, ["ADMIN"]);
for (const [key, value] of Object.entries(adminAccountHeaders))
  Astro.response.headers.set(key, value);
let accounts: readonly AdminAccountDto[] = [];
let error: string | null = null;
try {
  accounts = await loadAdminAccounts(actor);
} catch (cause) {
  const failure = adminAccountFailure(cause);
  if (failure.status === 403) return Astro.redirect("/login", 303);
  Astro.response.status = failure.status;
  error =
    "No se pudieron cargar las cuentas. Recarga para intentarlo nuevamente.";
}
---

<PrivateLayout title="Administradores">
  <PrivateBreadcrumbs
    current="Administradores"
    parents={[{ label: "Resumen", href: "/app" }]}
  />
  {Astro.url.searchParams.get("success") === "deleted" && (
    <noscript>
      <p role="status" class="mt-5">
        Cuenta eliminada.
      </p>
    </noscript>
  )}
  <header class="mt-5 flex flex-wrap items-start justify-between gap-5">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">Administradores</h1>
      <p class="mt-3 text-muted-foreground">
        Cuentas con acceso administrativo.
      </p>
    </div>
    <a
      href="/app/administradores/nuevo"
      class={buttonVariants({ className: "min-h-11" })}
    >
      Crear administrador
    </a>
  </header>
  {error ? (
    <div class="mt-8 flex flex-col gap-3">
      <p role="alert" class="text-destructive">
        {error}
      </p>
      <a
        href="/app/administradores"
        data-astro-reload
        class="self-start underline underline-offset-4"
      >
        Reintentar
      </a>
    </div>
  ) : accounts.length ? (
    <AdminAccountList {accounts} />
  ) : (
    <section class="mt-8 flex flex-col gap-2">
      <h2 class="text-lg font-semibold">No hay cuentas disponibles</h2>
      <p class="text-muted-foreground">
        Crea una cuenta para darle acceso al equipo.
      </p>
    </section>
  )}
</PrivateLayout>
