---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import CourseTabs from "@/components/courses/CourseTabs.astro";
import RegistrationPageError from "@/components/pre-registrations/RegistrationPageError.astro";
import { buttonVariants } from "@/components/ui/button";
import { EvaluationResult } from "./EvaluationResult";
import { EvaluationHistory } from "./EvaluationHistory";
import EvaluationBreadcrumbs from "./EvaluationBreadcrumbs.astro";
import SchemeSummary from "./SchemeSummary.astro";
import { EvaluationWorkspace } from "./EvaluationWorkspace";
import {
  evaluationPrefix,
  evaluationTypeLabels,
  gradeLabel,
} from "./presentation";
import { membershipLabels } from "@/components/pre-registrations/presentation";
import type { EvaluationRouteData } from "./route";

type Props = EvaluationRouteData;
const {
  load,
  courseId,
  groupId,
  instructorRoute,
  issues,
  message,
  requestKey,
  attemptedComponents,
  attemptedRevision,
  attemptedGrade,
  success,
} = Astro.props;
const data = load.available ? load.data : null;
const prefix = evaluationPrefix(instructorRoute);
const group = data?.groups.find((group) => group.id === groupId);
const rows = attemptedComponents ?? data?.scheme.components ?? [];
const fields = rows.length
  ? rows
  : [{ id: crypto.randomUUID(), name: "", type: "THEORY", weight: "" }];
const fallbackComponentRows = Array.from(
  { length: Math.ceil((data?.scheme.components.length ?? 0) / 4) },
  (_, index) => data!.scheme.components.slice(index * 4, index * 4 + 4),
);
const fallbackColumns = [
  "",
  "lg:grid-cols-1",
  "lg:grid-cols-2",
  "lg:grid-cols-3",
  "lg:grid-cols-4",
][Math.min(data?.scheme.components.length ?? 0, 4)];
---

<PrivateLayout title="Evaluaciones">
  <EvaluationBreadcrumbs
    {courseId}
    {instructorRoute}
    courseName={data?.courseName ?? "Curso"}
    {...(groupId ? { groupId, groupLabel: group?.label ?? "Grupo" } : {})}
  />
  <header class="flex flex-wrap items-center gap-x-4 gap-y-3">
    <h1 class="text-2xl font-semibold tracking-tight">Evaluaciones</h1>
    {group && data && (
      <p class="min-w-0 break-words text-sm text-muted-foreground">
        Grupo {group.label} · Esquema:{" "}
        {data.scheme.modality
          ? evaluationTypeLabels[data.scheme.modality]
          : "Sin definir"}
        {data.scheme.components.length > 0 &&
          ` · ${data.scheme.components.length} ${data.scheme.components.length === 1 ? "componente" : "componentes"}`}
      </p>
    )}
    {groupId && data && (
      <a
        href={`${prefix}/${courseId}/grupos/${groupId}/cierre`}
        class={buttonVariants({
          variant: "outline",
          className: "min-h-11 sm:ml-auto",
        })}
      >
        Cierre académico
      </a>
    )}
  </header>
  {!groupId && !instructorRoute && data && (
    <CourseTabs id={courseId} active="evaluations" />
  )}
  {data ? (
    <div class="mt-5 flex min-w-0 flex-col gap-6">
      {success && (
        <p role="status" class="text-sm">
          {groupId ? "Nota guardada." : "Esquema guardado."}
        </p>
      )}
      {!groupId && (
        <section
          aria-labelledby="evaluation-groups-title"
          class="flex flex-col gap-3"
        >
          <h2 id="evaluation-groups-title" class="text-xl font-semibold">
            Evaluar por grupo
          </h2>
          {data.groups.length ? (
            <ul class="flex flex-wrap gap-3">
              {data.groups.map((group) => (
                <li>
                  <a
                    href={`${prefix}/${courseId}/grupos/${group.id}/evaluaciones`}
                    class={buttonVariants({
                      variant: "outline",
                      className: "min-h-11 max-w-full whitespace-normal",
                    })}
                  >
                    {group.label}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-muted-foreground">
              El curso todavía no tiene grupos.
            </p>
          )}
        </section>
      )}
      <EvaluationWorkspace
        client:only="react"
        initialData={data}
        {instructorRoute}
        path={Astro.url.pathname}
        {attemptedComponents}
        {attemptedRevision}
        {attemptedGrade}
        {issues}
        {message}
      >
        <div slot="fallback" class="flex min-w-0 flex-col gap-8">
          {groupId ? (
            <>
              <section
                aria-labelledby="fallback-grades-title"
                class="flex min-w-0 flex-col gap-4"
              >
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <h2 id="fallback-grades-title" class="text-xl font-semibold">
                    Notas de participantes
                  </h2>
                  {data.hasAttendanceOverrides &&
                    !data.academicGroups?.some(
                      (g) => g.groupId === groupId && g.closed,
                    ) && (
                      <form method="post" action={Astro.url.pathname}>
                        <input
                          type="hidden"
                          name="action"
                          value="reset-attendance"
                        />
                        <input
                          type="hidden"
                          name="requestKey"
                          value={requestKey}
                        />
                        <input
                          type="hidden"
                          name="schemeRevision"
                          value={data.scheme.revision}
                        />
                        <button
                          type="submit"
                          class={buttonVariants({
                            variant: "outline",
                            className: "min-h-11 max-w-full whitespace-normal",
                          })}
                        >
                          Restablecer cálculo automático
                        </button>
                      </form>
                    )}
                </div>
                {!data.scheme.components.length ? (
                  <p class="text-sm text-muted-foreground">
                    Define el esquema del curso antes de registrar notas.
                  </p>
                ) : !data.participants.length ? (
                  <p class="text-sm text-muted-foreground">
                    Este grupo todavía no tiene participantes para evaluar.
                  </p>
                ) : (
                  <ul class="min-w-0 divide-y rounded-xl border bg-card">
                    {data.participants.map((participant) => (
                      <li class="min-w-0">
                        <article class="grid min-w-0 gap-3 p-4 xl:grid-cols-[minmax(10rem,1fr)_minmax(0,3fr)_9rem_5.75rem] xl:grid-rows-[auto_minmax(2.75rem,auto)_auto_auto] xl:gap-x-3 xl:gap-y-1">
                          <header class="grid gap-3 xl:contents">
                            <div class="min-w-0 xl:col-start-1 xl:row-start-2 xl:self-center">
                              <h3 class="break-words font-semibold">
                                {participant.firstName}{" "}
                                {participant.paternalSurname}{" "}
                                {participant.maternalSurname}
                              </h3>
                              {participant.membershipStatus !== "INSCRITO" && (
                                <p class="mt-2 text-sm text-muted-foreground">
                                  {
                                    membershipLabels[
                                      participant.membershipStatus
                                    ]
                                  }{" "}
                                </p>
                              )}
                            </div>
                            {participant.result.status === "COMPLETE" && (
                              <div class="xl:col-start-3 xl:row-start-2 xl:self-center">
                                <EvaluationResult result={participant.result} />
                              </div>
                            )}
                          </header>
                          <div class="grid min-w-0 gap-4 xl:contents">
                            {fallbackComponentRows.map((row) => (
                              <div
                                class:list={[
                                  "grid min-w-0 gap-x-3 gap-y-1 sm:grid-cols-2 xl:col-start-2 xl:row-span-4 xl:grid-rows-subgrid",
                                  fallbackColumns,
                                ]}
                              >
                                {row.map((component) => {
                                  const grade = participant.grades.find(
                                    (grade) =>
                                      grade.componentId === component.id,
                                  );
                                  const attempted =
                                    attemptedGrade?.registrationId ===
                                      participant.registrationId &&
                                    attemptedGrade.componentId === component.id
                                      ? attemptedGrade
                                      : null;
                                  const id = `fallback-${participant.registrationId}-${component.id}`;
                                  return participant.canGrade ? (
                                    <form
                                      method="post"
                                      action={Astro.url.pathname}
                                      aria-label={`${component.name} · ${participant.firstName} ${participant.paternalSurname} ${participant.maternalSurname}`}
                                      class="row-span-4 grid min-w-0 grid-rows-subgrid gap-y-1"
                                    >
                                      <input
                                        type="hidden"
                                        name="registrationId"
                                        value={participant.registrationId}
                                      />
                                      <input
                                        type="hidden"
                                        name="componentId"
                                        value={component.id}
                                      />
                                      <input
                                        type="hidden"
                                        name="schemeRevision"
                                        value={
                                          attempted?.schemeRevision ??
                                          data.scheme.revision
                                        }
                                      />
                                      <input
                                        type="hidden"
                                        name="gradeRevision"
                                        value={
                                          attempted?.gradeRevision ??
                                          grade?.revision ??
                                          0
                                        }
                                      />
                                      <input
                                        type="hidden"
                                        name="requestKey"
                                        value={
                                          attempted?.requestKey ??
                                          crypto.randomUUID()
                                        }
                                      />
                                      <label
                                        for={id}
                                        class="row-start-1 text-xs font-medium text-muted-foreground"
                                      >
                                        {component.name}
                                        <span class="sr-only">
                                          {" "}
                                          · {participant.firstName}{" "}
                                          {participant.paternalSurname}{" "}
                                          {participant.maternalSurname}
                                        </span>
                                      </label>
                                      <input
                                        id={id}
                                        name="score"
                                        inputmode="decimal"
                                        pattern="(?:100(?:\.0{1,2})?|(?:0|[1-9][0-9]?)(?:\.[0-9]{1,2})?)"
                                        title={
                                          component.type === "ATTENDANCE"
                                            ? undefined
                                            : "Introduce una nota de 0 a 100 con punto decimal y hasta dos decimales."
                                        }
                                        disabled={grade?.canEdit === false}
                                        required
                                        value={
                                          attempted?.score ?? grade?.score ?? ""
                                        }
                                        class="row-start-2 min-h-11 w-20 min-w-0 max-w-full rounded-md border bg-background px-2 text-sm tabular-nums focus-visible:outline-2 focus-visible:outline-ring"
                                        aria-invalid={Boolean(
                                          attempted && issues.score,
                                        )}
                                        aria-describedby={
                                          attempted && message
                                            ? `${id}-error`
                                            : component.type !== "ATTENDANCE" &&
                                                grade?.score == null
                                              ? `${id}-help`
                                              : undefined
                                        }
                                      />
                                      {component.type !== "ATTENDANCE" &&
                                        grade?.score == null &&
                                        !(attempted && message) && (
                                          <p
                                            id={`${id}-help`}
                                            class="row-start-3 text-sm text-muted-foreground"
                                          >
                                            Pendiente
                                          </p>
                                        )}
                                      {attempted && message && (
                                        <p
                                          id={`${id}-error`}
                                          role="alert"
                                          class="row-start-3 text-sm text-destructive"
                                        >
                                          {issues.score ?? message}
                                        </p>
                                      )}
                                      <button
                                        type="submit"
                                        disabled={grade?.canEdit === false}
                                        class={buttonVariants({
                                          variant: "outline",
                                          className: "row-start-4 min-h-11",
                                        })}
                                      >
                                        Guardar nota
                                      </button>
                                    </form>
                                  ) : (
                                    <div class="row-span-4 grid min-w-0 grid-rows-subgrid gap-y-1">
                                      <p class="row-start-1 text-xs font-medium text-muted-foreground">
                                        {component.name}
                                      </p>
                                      <p class="row-start-2 flex min-h-11 items-center text-sm tabular-nums">
                                        {grade?.score === null ||
                                        grade?.score === undefined
                                          ? "Pendiente"
                                          : gradeLabel(grade.score)}
                                      </p>
                                    </div>
                                  );
                                })}
                              </div>
                            ))}
                          </div>
                        </article>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
              <EvaluationHistory {data} />
            </>
          ) : data.scheme.canEdit && !data.scheme.frozenAt ? (
            <section
              aria-labelledby="fallback-scheme-title"
              class="flex min-w-0 flex-col gap-4"
            >
              <h2 id="fallback-scheme-title" class="text-xl font-semibold">
                Componentes del curso
              </h2>
              <p class="text-sm text-muted-foreground">
                Los pesos deben sumar 100%. Puedes usar hasta dos decimales.
              </p>
              <form
                method="post"
                action={Astro.url.pathname}
                class="flex min-w-0 flex-col gap-5"
              >
                <input
                  type="hidden"
                  name="schemeRevision"
                  value={attemptedRevision ?? data.scheme.revision}
                />
                <input type="hidden" name="requestKey" value={requestKey} />
                {fields.map((component, index) => (
                  <fieldset class="grid min-w-0 gap-4 rounded-xl border bg-card p-5 sm:grid-cols-2">
                    <legend class="px-1 text-sm font-semibold">
                      Componente {index + 1}
                    </legend>
                    <input
                      type="hidden"
                      name={`componentId.${index}`}
                      value={component.id}
                    />
                    <div class="flex min-w-0 flex-col gap-2">
                      <label
                        for={`name-${component.id}`}
                        class="text-sm font-medium"
                      >
                        Nombre
                      </label>
                      <input
                        id={`name-${component.id}`}
                        name={`componentName.${index}`}
                        value={component.name}
                        maxlength={100}
                        class="min-h-11 rounded-md border bg-background px-3 focus-visible:outline-2 focus-visible:outline-ring"
                      />
                      {issues[`components.${index}.name`] && (
                        <p role="alert" class="text-sm text-destructive">
                          {issues[`components.${index}.name`]}
                        </p>
                      )}
                    </div>
                    <div class="flex min-w-0 flex-col gap-2">
                      <label
                        for={`type-${component.id}`}
                        class="text-sm font-medium"
                      >
                        Tipo
                      </label>
                      <select
                        id={`type-${component.id}`}
                        name={`componentType.${index}`}
                        class="min-h-11 rounded-md border bg-background px-3 focus-visible:outline-2 focus-visible:outline-ring"
                      >
                        <option
                          value="THEORY"
                          selected={component.type === "THEORY"}
                        >
                          Teórica
                        </option>
                        <option
                          value="PRACTICAL"
                          selected={component.type === "PRACTICAL"}
                        >
                          Práctica
                        </option>
                        <option
                          value="ATTENDANCE"
                          selected={component.type === "ATTENDANCE"}
                        >
                          Asistencia
                        </option>
                      </select>
                    </div>
                    <div class="flex min-w-0 flex-col gap-2">
                      <label
                        for={`weight-${component.id}`}
                        class="text-sm font-medium"
                      >
                        Peso (%)
                      </label>
                      <input
                        id={`weight-${component.id}`}
                        name={`componentWeight.${index}`}
                        inputmode="decimal"
                        value={component.weight}
                        class="min-h-11 rounded-md border bg-background px-3 focus-visible:outline-2 focus-visible:outline-ring"
                      />
                      {issues[`components.${index}.weight`] && (
                        <p role="alert" class="text-sm text-destructive">
                          {issues[`components.${index}.weight`]}
                        </p>
                      )}
                    </div>
                    <button
                      type="submit"
                      name="editingAction"
                      value={`remove:${component.id}`}
                      class={buttonVariants({
                        variant: "ghost",
                        className: "min-h-11 self-end",
                      })}
                    >
                      Quitar componente
                    </button>
                  </fieldset>
                ))}
                {message && (
                  <p role="alert" class="text-sm text-destructive">
                    {message}
                  </p>
                )}
                <div class="flex flex-wrap justify-between gap-3">
                  <button
                    type="submit"
                    name="editingAction"
                    value="add"
                    class={buttonVariants({
                      variant: "outline",
                      className: "min-h-11",
                    })}
                  >
                    Añadir componente
                  </button>
                  <button
                    type="submit"
                    class={buttonVariants({ className: "min-h-11" })}
                  >
                    Guardar esquema
                  </button>
                </div>
              </form>
            </section>
          ) : (
            <SchemeSummary scheme={data.scheme} />
          )}
        </div>
      </EvaluationWorkspace>
    </div>
  ) : (
    <RegistrationPageError
      message={
        !load.available
          ? load.unavailableReason
          : "No se pudo cargar la evaluación."
      }
      retryHref={Astro.url.pathname}
    />
  )}
</PrivateLayout>
