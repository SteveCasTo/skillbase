---
import { buttonVariants } from "@/components/ui/button";
interface Props {
  hasPassword: boolean;
}
const { hasPassword } = Astro.props;
---

<section
  class="min-w-0 rounded-xl border bg-card p-5 sm:p-6"
  aria-labelledby="password-title"
>
  <h2 id="password-title" class="text-lg font-semibold">
    Contraseña
  </h2>
  <a
    class={buttonVariants({ variant: "outline", className: "mt-5 min-h-11" })}
    href="/app/perfil/contrasena"
  >
    {hasPassword ? "Cambiar contraseña" : "Crear contraseña"}
  </a>
</section>
