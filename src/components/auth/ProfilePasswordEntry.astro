---
import { buttonVariants } from "@/components/ui/button";
interface Props {
  hasPassword: boolean;
}
const { hasPassword } = Astro.props;
---

<section
  class="flex min-w-0 flex-col rounded-xl border bg-card p-5 sm:p-6"
  aria-labelledby="password-title"
>
  <h2 id="password-title" class="text-lg font-semibold">
    Contraseña
  </h2>
  <div class="flex min-h-28 flex-1 items-center justify-center pt-5">
    <a
      class={buttonVariants({
        variant: "outline",
        className: "min-h-11 max-w-full whitespace-normal text-center",
      })}
      href="/app/perfil/contrasena"
    >
      {hasPassword ? "Cambiar contraseña" : "Crear contraseña"}
    </a>
  </div>
</section>
