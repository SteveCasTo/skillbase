---
import InlineEditField from "@/components/pre-registrations/InlineEditField.astro";
import { Input } from "@/components/ui/input";
import AdminAccountLifecycle from "./AdminAccountLifecycle";
import type { AdminAccountDto } from "@/domain/admin-accounts/types";
import { adminAccountStatus } from "./presentation";
interface Props {
  account: AdminAccountDto;
  actorId: string;
  values: Readonly<Record<string, string>>;
  issues: Readonly<Record<string, string>>;
  error: string | null;
  submittedName: boolean;
}
const { account, actorId, values, issues, error, submittedName } = Astro.props;
const endpoint = `/app/administradores/${account.id}`;
---

<section
  class="mt-5 flex min-w-0 flex-col gap-6"
  data-admin-account-details
  data-account-id={account.id}
  data-actor-id={actorId}
>
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex min-w-0 flex-col gap-3">
      <h1
        class="break-words text-3xl font-semibold tracking-tight"
        data-account-name
      >
        {account.name}
      </h1>
      <p class="text-sm text-muted-foreground">{adminAccountStatus(account)}</p>
    </div>
    <AdminAccountLifecycle
      initialAccount={account}
      {actorId}
      {endpoint}
      initialError={submittedName ? null : error}
      client:load
    />
  </header>
  <div class="grid min-w-0 gap-x-8 gap-y-6 sm:grid-cols-2">
    {account.exclusiveAdmin && !account.deletionPending ? (
      <form
        method="post"
        action={`${endpoint}?operation=name`}
        data-admin-name
        data-baseline={JSON.stringify({ name: account.name })}
        data-last-submitted={submittedName ? "name" : undefined}
        aria-label="Editar nombre"
        data-astro-reload
      >
        <input type="hidden" name="revision" value={account.revision} />
        <InlineEditField label="Nombre" value={account.name}>
          <label for="name" class="text-sm font-medium">
            Nombre
          </label>
          <Input
            id="name"
            name="name"
            autoComplete="name"
            required
            maxLength={250}
            defaultValue={values.name ?? account.name}
            aria-invalid={Boolean(issues.name)}
            aria-describedby="name-error"
            className="min-h-11"
          />
          <p
            id="name-error"
            data-field-error="name"
            class="text-sm text-destructive empty:hidden"
          >
            {issues.name}
          </p>
          <p
            data-form-error
            role="alert"
            tabindex="-1"
            class="text-sm text-destructive empty:hidden"
          >
            {submittedName && !issues.name ? error : ""}
          </p>
          <a
            hidden={!submittedName || !error}
            data-admin-refresh
            href={endpoint}
            data-astro-reload
            class="text-sm underline underline-offset-4"
          >
            Recargar cuenta
          </a>
        </InlineEditField>
      </form>
    ) : (
      <dl class="flex min-w-0 flex-col gap-1">
        <dt class="text-sm text-muted-foreground">Nombre</dt>
        <dd class="flex min-h-11 items-center break-words font-medium">
          {account.name}
        </dd>
      </dl>
    )}
    <dl class="flex min-w-0 flex-col gap-1">
      <dt class="text-sm text-muted-foreground">Correo electrónico</dt>
      <dd class="flex min-h-11 min-w-0 items-center break-all font-medium">
        {account.email}
      </dd>
    </dl>
  </div>
  {!account.exclusiveAdmin && (
    <p class="text-sm text-muted-foreground">
      Esta cuenta también tiene rol de instructor. Su perfil y permisos
      profesionales se conservan.
    </p>
  )}
  {submittedName &&
    error &&
    (!account.exclusiveAdmin || account.deletionPending) && (
      <p role="alert" class="text-sm text-destructive">
        {error}
      </p>
    )}
</section>
<script src="./name-client.ts"></script>
