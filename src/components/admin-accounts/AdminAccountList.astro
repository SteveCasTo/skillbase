---
import SearchToolbar from "@/components/lists/SearchToolbar.astro";
import ListSearchEmpty from "@/components/lists/ListSearchEmpty.astro";
import {
  accountFilters,
  matchesListFilter,
  selectedListFilter,
} from "@/components/lists/filters";
import { normalizeRegistrationSearch } from "@/domain/pre-registrations/search";
import type { AdminAccountDto } from "@/domain/admin-accounts/types";
import { adminAccountStatus } from "./presentation";
interface Props {
  accounts: readonly AdminAccountDto[];
}
const { accounts } = Astro.props;
const search = Astro.url.searchParams.get("search") ?? "";
const query = normalizeRegistrationSearch(search);
const status = selectedListFilter(
  Astro.url.searchParams.get("status"),
  accountFilters,
);
const entries = accounts.map((account) => ({
  account,
  searchable: normalizeRegistrationSearch(`${account.name} ${account.email}`),
}));
const hasMatches = entries.some(
  ({ account, searchable }) =>
    searchable.includes(query) && matchesListFilter(account.status, status),
);
---

<section
  class="min-w-0"
  data-search-list="administradores"
  data-admin-account-list
  aria-label="Cuentas de administradores"
>
  <SearchToolbar
    id="admin-search"
    label="Buscar por nombre o correo"
    {search}
    {status}
    options={accountFilters}
  />
  <ListSearchEmpty
    hidden={hasMatches}
    message={
      query
        ? "No hay cuentas que coincidan. Prueba otro nombre o correo."
        : `No hay administradores en «${accountFilters.find((option) => option.value === status)?.label}».`
    }
    resetHref="/app/administradores?status=ALL"
  />
  <ul
    data-list-results
    hidden={!hasMatches}
    class="mt-8 grid min-w-0 gap-4 sm:grid-cols-2 xl:grid-cols-3"
  >
    {entries.map(({ account, searchable }) => (
      <li
        class="min-w-0"
        data-admin-card
        data-list-entry={searchable}
        data-list-status={account.status}
        hidden={
          !searchable.includes(query) ||
          !matchesListFilter(account.status, status)
        }
      >
        <a
          href={`/app/administradores/${account.id}`}
          class="flex h-full min-w-0 flex-col gap-3 rounded-xl border bg-card p-6 text-card-foreground outline-none hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring"
        >
          <h2 class="break-words text-xl font-semibold">{account.name}</h2>
          <p class="break-all text-sm text-muted-foreground">{account.email}</p>
          <p class="text-sm">{adminAccountStatus(account)}</p>
        </a>
      </li>
    ))}
  </ul>
</section>
