---
interface Props {
  value?: string;
  error?: string;
}
const { value = "", error = "" } = Astro.props;
const id = "credential-code";
---

<form
  method="get"
  action="/certificados/verificar"
  data-code-verification
  class="flex min-w-0 flex-col gap-3"
  aria-label="Verificar certificado"
>
  <label for={id} class="text-sm font-semibold">
    Código del certificado
  </label>
  <input
    id={id}
    name="codigo"
    type="text"
    required
    minlength={32}
    maxlength={32}
    pattern="[A-Za-z0-9_-]{32}"
    value={value}
    autocomplete="off"
    spellcheck="false"
    aria-invalid={Boolean(error)}
    aria-describedby={`${id}-error`}
    class="min-h-11 w-full min-w-0 rounded-lg border bg-background px-3 font-mono text-sm text-foreground focus-visible:outline-2 focus-visible:outline-ring"
  />
  <p
    id={`${id}-error`}
    role="status"
    aria-live="polite"
    hidden={!error}
    class="text-sm text-destructive"
  >
    {error}
  </p>
  <button
    type="submit"
    class:list={[
      "inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 text-sm font-semibold text-[var(--deep)] disabled:cursor-wait disabled:opacity-60",
      "focus-visible:outline-2 focus-visible:outline-ring",
    ]}
  >
    Verificar certificado
  </button>
</form>
