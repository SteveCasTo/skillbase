---
import { FileText, FileUp, X } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
interface Props {
  officialHash: string;
  state: "issued" | "revoked" | "replaced";
}
const { officialHash, state } = Astro.props;
---

<section
  class="local-verification flex min-w-0 flex-col gap-5"
  aria-labelledby="local-file-title"
  data-local-verification
  data-official-hash={officialHash}
  data-certificate-state={state}
>
  <h2 id="local-file-title" class="text-xl font-semibold">
    Comprobar tu archivo
  </h2>
  <div data-local-controls hidden>
    <label for="local-pdf" data-local-dropzone class="local-dropzone">
      <input
        id="local-pdf"
        type="file"
        accept="application/pdf,.pdf"
        aria-labelledby="local-pdf-label"
        aria-describedby="local-pdf-help local-result"
        class="sr-only"
      />
      <span class="flex size-14 items-center justify-center rounded-xl bg-secondary text-secondary-foreground">
        <FileUp size={28} aria-hidden="true" />
      </span>
      <span class="flex min-w-0 flex-col gap-2">
        <span class="text-lg font-semibold" data-drop-prompt>
          Arrastra tu PDF aquí
        </span>
        <span id="local-pdf-help" class="text-sm text-muted-foreground">
          PDF · máximo 10 MiB
        </span>
      </span>
      <span
        id="local-pdf-label"
        class:list={[
          buttonVariants({ variant: "outline" }),
          "h-auto min-h-11 max-w-full whitespace-normal text-center",
        ]}
      >
        Seleccionar PDF firmado
      </span>
    </label>
    <div
      data-local-selection
      hidden
      class="local-selection mt-3 flex min-w-0 items-center gap-3 rounded-lg border bg-card p-3"
    >
      <FileText size={24} className="shrink-0" aria-hidden="true" />
      <span
        data-file-name
        class="min-w-0 flex-1 text-sm font-medium [overflow-wrap:anywhere]"
      ></span>
      <button
        type="button"
        data-local-reset
        aria-label="Quitar archivo"
        class:list={[buttonVariants({ variant: "ghost" }), "size-11"]}
      >
        <X aria-hidden="true" />
      </button>
    </div>
  </div>
  <p
    id="local-result"
    role="status"
    aria-label="Resultado de comparación local"
    aria-live="polite"
    aria-atomic="true"
    class="local-result text-sm leading-6 [overflow-wrap:anywhere]"
  ></p>
  <output
    data-local-hash
    hidden
    class="break-all font-mono text-xs"
    aria-label="SHA-256 del archivo seleccionado"
  ></output>
  <noscript>
    <p class="text-sm">
      Activa JavaScript para comparar el archivo localmente. El estado del
      registro mostrado arriba no requiere JavaScript.
    </p>
  </noscript>
</section>
<script>
  import { hashComparison, localPdfSha256, localPdfError } from "./local-hash";
  const root = document.querySelector<HTMLElement>("[data-local-verification]");
  const input = root?.querySelector<HTMLInputElement>("#local-pdf");
  const result = root?.querySelector<HTMLElement>("#local-result");
  const output = root?.querySelector<HTMLOutputElement>("[data-local-hash]");
  const controls = root?.querySelector<HTMLElement>("[data-local-controls]");
  const dropzone = root?.querySelector<HTMLElement>("[data-local-dropzone]");
  const selection = root?.querySelector<HTMLElement>("[data-local-selection]");
  const filename = root?.querySelector<HTMLElement>("[data-file-name]");
  const prompt = root?.querySelector<HTMLElement>("[data-drop-prompt]");
  if (
    root &&
    input &&
    result &&
    output &&
    controls &&
    dropzone &&
    selection &&
    filename &&
    prompt
  ) {
    let latest = 0;
    if (window.crypto?.subtle) controls.hidden = false;
    else
      result.textContent =
        "La comparación local requiere un navegador compatible y una conexión segura.";
    const clear = () => {
      latest += 1;
      input.value = "";
      filename.textContent = "";
      selection.hidden = true;
      prompt.textContent = "Arrastra tu PDF aquí";
      dropzone.removeAttribute("data-invalid");
      dropzone.removeAttribute("data-selected");
      input.removeAttribute("aria-invalid");
      result.textContent = "";
      output.textContent = "";
      output.hidden = true;
      root.removeAttribute("aria-busy");
    };
    root.querySelector("[data-local-reset]")?.addEventListener("click", () => {
      clear();
      input.focus();
    });
    let dragDepth = 0;
    const resetDrag = () => {
      dragDepth = 0;
      dropzone.removeAttribute("data-dragging");
    };
    dropzone.addEventListener("dragenter", (event) => {
      event.preventDefault();
      dragDepth += 1;
      dropzone.setAttribute("data-dragging", "");
    });
    dropzone.addEventListener("dragover", (event) => {
      event.preventDefault();
      if (event.dataTransfer) event.dataTransfer.dropEffect = "copy";
    });
    dropzone.addEventListener("dragleave", () => {
      dragDepth -= 1;
      if (dragDepth <= 0) resetDrag();
    });
    dropzone.addEventListener("drop", (event) => {
      event.preventDefault();
      resetDrag();
      const files = event.dataTransfer?.files;
      if (!files?.length) return;
      // Select exactly one file, as with the native single-file picker.
      const transfer = new DataTransfer();
      transfer.items.add(files[0]!);
      input.files = transfer.files;
      input.dispatchEvent(new Event("change", { bubbles: true }));
    });
    input.addEventListener("change", async () => {
      const token = ++latest;
      const file = input.files?.[0];
      filename.textContent = file?.name ?? "";
      selection.hidden = !file;
      prompt.textContent = file
        ? "Arrastra otro PDF para cambiarlo"
        : "Arrastra tu PDF aquí";
      dropzone.toggleAttribute("data-selected", Boolean(file));
      dropzone.removeAttribute("data-invalid");
      input.removeAttribute("aria-invalid");
      output.hidden = true;
      output.textContent = "";
      result.textContent = "";
      if (!file) {
        root.removeAttribute("aria-busy");
        return;
      }
      const validation = localPdfError(file);
      if (validation) {
        result.textContent = validation;
        dropzone.setAttribute("data-invalid", "");
        input.setAttribute("aria-invalid", "true");
        root.removeAttribute("aria-busy");
        return;
      }
      root.setAttribute("aria-busy", "true");
      result.textContent = "Comprobando tu archivo…";
      try {
        const hash = await localPdfSha256(file);
        if (token !== latest) return;
        output.textContent = hash;
        output.hidden = false;
        result.textContent = hashComparison(
          hash,
          root.dataset.officialHash ?? "",
          root.dataset.certificateState ?? "",
        );
      } catch (error) {
        if (token !== latest) return;
        result.textContent =
          error instanceof Error
            ? error.message
            : "No se pudo leer el archivo. Selecciónalo de nuevo.";
        dropzone.setAttribute("data-invalid", "");
        input.setAttribute("aria-invalid", "true");
      } finally {
        if (token === latest) root.removeAttribute("aria-busy");
      }
    });
  }
</script>
<style>
  .local-dropzone {
    display: flex;
    min-width: 0;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
    padding: clamp(1.5rem, 4vw, 3rem) 1.25rem;
    text-align: center;
    transition:
      background-color 150ms,
      border-color 150ms;
  }
  .local-dropzone:hover,
  .local-dropzone[data-dragging] {
    border-color: var(--ring);
    background: var(--secondary);
  }
  .local-dropzone:focus-within {
    outline: 3px solid var(--ring);
    outline-offset: 4px;
  }
  .local-dropzone[data-invalid] {
    border-color: var(--destructive);
  }
  .local-dropzone[data-selected] {
    border-style: solid;
  }
  .local-selection[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .local-dropzone {
      transition: none;
    }
  }
  h2 {
    font-family: var(--font-sans);
  }
</style>
