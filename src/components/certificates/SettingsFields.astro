---
import type { CertificateConfiguration } from "@/domain/certificates/types";
import type { CertificateFeedback } from "./route";
import InlineEditField from "@/components/pre-registrations/InlineEditField.astro";
import { Input } from "@/components/ui/input";
import {
  certificateSettingsFields,
  certificateSettingsValue,
} from "@/application/certificates/update-settings-field";
interface Props {
  configuration: CertificateConfiguration;
  revision: number;
  feedback: CertificateFeedback;
}
const { configuration, revision, feedback } = Astro.props;
const positions = [
  { key: "departmentHead", title: "Jefatura del Departamento" },
  { key: "director", title: "Dirección académica" },
  { key: "dean", title: "Decanato" },
  { key: "approvalInstructor", title: "Instructor del grupo" },
] as const;
const labels = {
  name: "Nombre completo",
  role: "Cargo",
  affiliation: "Afiliación",
};
---

<div class="certificate-settings grid min-w-0 gap-4 md:grid-cols-2 xl:grid-cols-3">
  {positions.map(({ key, title }) => (
    <section
      class:list={[
        "grid min-w-0 content-start gap-4 rounded-xl border bg-card p-5 text-card-foreground",
        key === "approvalInstructor" &&
          "md:col-span-2 md:grid-cols-2 xl:col-span-3 xl:grid-cols-3",
      ]}
      aria-labelledby={`${key}-heading`}
    >
      <header
        class:list={[
          "flex min-w-0 flex-col gap-2 border-b pb-3",
          key === "approvalInstructor" &&
            "md:col-span-2 xl:col-span-1 xl:border-b-0 xl:pb-0",
        ]}
      >
        <h3 id={`${key}-heading`} class="font-semibold text-balance">
          {title}
        </h3>
        {key === "approvalInstructor" && (
          <p class="text-sm text-muted-foreground">
            Nombre del instructor al cierre de cada grupo.
          </p>
        )}
      </header>
      {certificateSettingsFields
        .filter((name) => name.startsWith(`${key}.`))
        .map((name) => {
          const property = name.split(".")[1] as keyof typeof labels;
          const label = `${labels[property]} · ${title}`;
          const value = certificateSettingsValue(configuration, name);
          const attempted = feedback.values.field === name;
          return (
            <form
              method="post"
              action="/app/configuracion/certificados"
              data-certificate-settings-field
              data-edit-field={name}
              data-baseline={JSON.stringify({ ["value"]: value })}
              class="min-w-0"
            >
              <input
                type="hidden"
                name="revision"
                value={
                  attempted ? (feedback.values.revision ?? revision) : revision
                }
              />
              <input type="hidden" name="field" value={name} />
              <InlineEditField
                label={labels[property]}
                value={value || "Pendiente"}
              >
                <label for={name}>{label}</label>
                <Input
                  id={name}
                  name="value"
                  defaultValue={
                    attempted ? (feedback.values.value ?? value) : value
                  }
                  required={property !== "name"}
                  maxLength={500}
                  aria-invalid={attempted && Boolean(feedback.issues[name])}
                  aria-describedby={`${name}-error`}
                  className="min-h-11"
                />
                <p
                  id={`${name}-error`}
                  data-field-error={name}
                  role="alert"
                  class="text-sm text-destructive empty:hidden"
                >
                  {attempted ? feedback.issues[name] : ""}
                </p>
                <p
                  data-form-error
                  role="alert"
                  class="text-sm text-destructive empty:hidden"
                >
                  {attempted && !feedback.issues[name] ? feedback.message : ""}
                </p>
              </InlineEditField>
              <a
                href="/app/configuracion#firmantes"
                data-settings-refresh
                hidden={!(attempted && feedback.message)}
                class="text-sm underline underline-offset-4"
              >
                Recargar valores vigentes
              </a>
            </form>
          );
        })}
    </section>
  ))}
</div>
<style>
  .certificate-settings :global([data-inline-display] > div:last-child) {
    width: auto;
  }
</style>
<script src="./settings-field-client.ts"></script>
