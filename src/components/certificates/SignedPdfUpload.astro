---
import { FileText, FileUp, LoaderCircle, ShieldCheck, X } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
interface Props {
  path: string;
  revision: number;
  requestKey: string;
  signed: boolean;
}
const { path, revision, requestKey, signed } = Astro.props;
---

<form
  method="post"
  action={`${path}/cargar`}
  enctype="multipart/form-data"
  data-signed-pdf-form
  class="signed-upload grid min-w-0 gap-6 lg:grid-cols-[minmax(0,1.4fr)_minmax(15rem,1fr)] lg:items-center"
>
  <input type="hidden" name="revision" value={revision} />
  <input type="hidden" name="requestKey" value={requestKey} />
  <input type="hidden" name="purpose" value="SIGNED" />
  <div class="min-w-0">
    <div
      data-dropzone
      class="group relative flex min-h-60 min-w-0 flex-col items-center justify-center gap-4 rounded-xl border border-dashed border-muted-foreground/40 bg-card px-5 py-8 text-center transition-colors hover:border-primary hover:bg-secondary/50 focus-within:border-primary focus-within:ring-2 focus-within:ring-ring motion-reduce:transition-none data-[dragging=true]:border-primary data-[dragging=true]:bg-secondary data-[invalid=true]:border-destructive sm:px-8"
    >
      <span
        class="flex size-14 items-center justify-center rounded-xl bg-secondary text-foreground"
        aria-hidden="true"
      >
        <FileUp data-empty-icon size={28} />
        <FileText data-selected-icon size={28} className="hidden" />
      </span>
      <div class="flex min-w-0 flex-col gap-2">
        <label
          for="signed-pdf"
          class="cursor-pointer text-base font-semibold after:absolute after:inset-0 after:rounded-xl"
        >
          {signed ? "Añade el nuevo PDF firmado" : "Añade el PDF firmado"}
        </label>
        <p data-picker-prompt class="text-sm leading-6 text-muted-foreground">
          Arrástralo aquí o selecciona un archivo
        </p>
        <p class="text-xs leading-5 text-muted-foreground">
          PDF · hasta 10 MiB · sin contraseña
        </p>
      </div>
      <input
        id="signed-pdf"
        name="file"
        type="file"
        required
        accept="application/pdf,.pdf"
        aria-describedby="signed-pdf-error signed-pdf-selection"
        class="relative z-10 max-w-full text-sm file:mr-3 file:rounded-md file:border file:border-input file:bg-background file:px-3 file:py-2 file:text-foreground focus-visible:outline-2 focus-visible:outline-ring"
      />
    </div>
    <div
      data-file-details
      hidden
      class="mt-3 flex min-w-0 items-center gap-3 rounded-lg bg-muted/60 px-4 py-3"
    >
      <FileText size={20} className="shrink-0" aria-hidden="true" />
      <p
        id="signed-pdf-selection"
        class="flex min-w-0 flex-1 flex-col gap-1 text-sm"
        aria-live="polite"
      >
        <span data-file-name class="break-all font-medium"></span>
        <span data-file-size class="text-xs text-muted-foreground"></span>
      </p>
      <button
        type="button"
        data-remove-file
        aria-label="Quitar archivo"
        class={buttonVariants({
          variant: "ghost",
          size: "icon",
          className: "relative min-h-11 min-w-11 shrink-0",
        })}
      >
        <X size={18} aria-hidden="true" />
      </button>
    </div>
    <p
      id="signed-pdf-error"
      data-file-error
      role="alert"
      class="mt-3 text-sm leading-6 text-destructive empty:hidden"
    ></p>
  </div>
  <div class="flex min-w-0 flex-col items-start gap-4">
    <div class="flex items-center gap-2">
      <ShieldCheck
        size={20}
        className="shrink-0 text-muted-foreground"
        aria-hidden="true"
      />
      <h2 class="text-lg font-semibold">
        {signed ? "Actualizar documento firmado" : "Guardar documento firmado"}
      </h2>
    </div>
    <p class="max-w-prose text-sm leading-6 text-muted-foreground">
      {signed
        ? "El nuevo archivo sustituirá al actual y conservará el identificador público de la credencial."
        : "Selecciona el certificado con las firmas completadas. Se publicará al guardar el documento."}
    </p>
    <p class="max-w-prose text-sm leading-6 text-muted-foreground">
      Al {signed ? "sustituir" : "guardar"}, confirmas como administrador que es
      el PDF firmado de este certificado.
    </p>
    <button
      type="submit"
      name="intent"
      value="save-signed-pdf"
      data-upload-submit
      class={buttonVariants({
        className: "min-h-11 max-w-full whitespace-normal text-center",
      })}
    >
      <LoaderCircle
        data-upload-spinner
        size={18}
        className="hidden motion-safe:animate-spin"
        aria-hidden="true"
      />
      <span data-upload-label>
        {signed ? "Sustituir PDF firmado" : "Guardar PDF firmado"}
      </span>
    </button>
    <p
      data-upload-status
      role="status"
      class="text-sm leading-6 empty:hidden"
    ></p>
    <p
      data-upload-error
      role="alert"
      tabindex="-1"
      class="text-sm leading-6 text-destructive empty:hidden focus-visible:outline-2 focus-visible:outline-ring"
    ></p>
  </div>
</form>

<style>
  .signed-upload [data-upload-submit] {
    display: none;
  }
  .signed-upload:not([data-enhanced]):has(input[type="file"]:valid)
    [data-upload-submit],
  .signed-upload[data-valid="true"] [data-upload-submit] {
    display: inline-flex;
  }
  .signed-upload[data-enhanced] input[type="file"] {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .signed-upload[aria-busy="true"] [data-dropzone] {
    pointer-events: none;
    opacity: 0.65;
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";
  import { localPdfError } from "./local-hash";
  let controller: AbortController | undefined;
  function enhanceSignedUploads() {
    controller?.abort();
    controller = new AbortController();
    const signal = controller.signal;
    document
      .querySelectorAll<HTMLFormElement>("[data-signed-pdf-form]")
      .forEach((form) => {
        const file =
          form.querySelector<HTMLInputElement>('input[type="file"]')!;
        const zone = form.querySelector<HTMLElement>("[data-dropzone]")!;
        const submit = form.querySelector<HTMLButtonElement>(
          "[data-upload-submit]",
        )!;
        const remove =
          form.querySelector<HTMLButtonElement>("[data-remove-file]")!;
        const details = form.querySelector<HTMLElement>("[data-file-details]")!;
        const fileError = form.querySelector<HTMLElement>("[data-file-error]")!;
        const error = form.querySelector<HTMLElement>("[data-upload-error]")!;
        const status = form.querySelector<HTMLElement>("[data-upload-status]")!;
        const label = form.querySelector<HTMLElement>("[data-upload-label]")!;
        const idleLabel = label.textContent!;
        let generation = 0;
        let pending = false;
        let dragDepth = 0;
        form.dataset.enhanced = "true";
        async function selected() {
          const current = ++generation;
          const selectedFile = file.files?.[0];
          form.dataset.valid = "false";
          submit.disabled = true;
          error.textContent = "";
          fileError.textContent = "";
          file.setCustomValidity("");
          details.hidden = !selectedFile;
          zone.dataset.invalid = "false";
          file.setAttribute("aria-invalid", "false");
          form.querySelector<HTMLElement>("[data-file-name]")!.textContent =
            selectedFile?.name ?? "";
          form.querySelector<HTMLElement>("[data-file-size]")!.textContent =
            selectedFile
              ? selectedFile.size < 1024
                ? `${selectedFile.size} B`
                : `${new Intl.NumberFormat("es-BO", { maximumFractionDigits: 2 }).format(selectedFile.size / (selectedFile.size < 1024 * 1024 ? 1024 : 1024 * 1024))} ${selectedFile.size < 1024 * 1024 ? "KiB" : "MiB"}`
              : "";
          form.querySelector<HTMLElement>("[data-picker-prompt]")!.textContent =
            selectedFile
              ? "Selecciona o arrastra otro archivo para cambiarlo"
              : "Arrástralo aquí o selecciona un archivo";
          form
            .querySelector<HTMLElement>("[data-empty-icon]")!
            .classList.toggle("hidden", Boolean(selectedFile));
          form
            .querySelector<HTMLElement>("[data-selected-icon]")!
            .classList.toggle("hidden", !selectedFile);
          if (!selectedFile) {
            status.textContent = "";
            return;
          }
          let problem = localPdfError(selectedFile);
          if (!problem) {
            status.textContent = "Comprobando PDF…";
            try {
              const { PDFDocument } = await import("pdf-lib");
              const bytes = new Uint8Array(await selectedFile.arrayBuffer());
              const header = new TextDecoder().decode(bytes.subarray(0, 8));
              const trailer = new TextDecoder().decode(
                bytes.subarray(Math.max(0, bytes.length - 1024)),
              );
              if (
                !/^%PDF-(?:1\.[0-9]|2\.0)/u.test(header) ||
                !/%%EOF\s*$/u.test(trailer)
              )
                throw new Error("PDF");
              const pdf = await PDFDocument.load(bytes, {
                ignoreEncryption: false,
                updateMetadata: false,
              });
              if (!pdf.getPageCount()) throw new Error("Empty PDF");
            } catch {
              problem =
                "El PDF está vacío, dañado o protegido. Selecciona un PDF legible sin contraseña.";
            }
          }
          if (current !== generation || signal.aborted) return;
          fileError.textContent = problem;
          file.setCustomValidity(problem);
          file.setAttribute("aria-invalid", problem ? "true" : "false");
          zone.dataset.invalid = String(Boolean(problem));
          form.dataset.valid = String(!problem);
          submit.disabled = Boolean(problem);
          status.textContent = problem ? "" : "PDF listo para guardar.";
        }
        file.addEventListener(
          "change",
          () => {
            void selected();
          },
          { signal },
        );
        remove.addEventListener(
          "click",
          () => {
            if (pending) return;
            file.value = "";
            void selected();
            file.focus();
          },
          { signal },
        );
        zone.addEventListener(
          "dragenter",
          (event) => {
            event.preventDefault();
            if (!pending) {
              dragDepth++;
              zone.dataset.dragging = "true";
            }
          },
          { signal },
        );
        zone.addEventListener(
          "dragover",
          (event) => {
            event.preventDefault();
            if (event.dataTransfer)
              event.dataTransfer.dropEffect = pending ? "none" : "copy";
          },
          { signal },
        );
        zone.addEventListener(
          "dragleave",
          () => {
            if (--dragDepth <= 0) zone.dataset.dragging = "false";
          },
          { signal },
        );
        zone.addEventListener(
          "drop",
          (event) => {
            event.preventDefault();
            dragDepth = 0;
            zone.dataset.dragging = "false";
            if (pending || !event.dataTransfer) return;
            if (event.dataTransfer.files.length !== 1) {
              file.value = "";
              void selected();
              fileError.textContent = "Selecciona un solo PDF firmado.";
              zone.dataset.invalid = "true";
              file.setAttribute("aria-invalid", "true");
              file.setCustomValidity("Selecciona un solo PDF firmado.");
              return;
            }
            file.files = event.dataTransfer.files;
            void selected();
          },
          { signal },
        );
        form.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();
            if (
              pending ||
              form.dataset.valid !== "true" ||
              !form.reportValidity()
            )
              return;
            const body = new FormData(form, submit);
            pending = true;
            submit.disabled = true;
            remove.disabled = true;
            file.disabled = true;
            form.setAttribute("aria-busy", "true");
            form
              .querySelector<HTMLElement>("[data-upload-spinner]")!
              .classList.remove("hidden");
            label.textContent = "Guardando PDF firmado…";
            status.textContent = "Guardando y publicando el documento…";
            error.textContent = "";
            try {
              const response = await fetch(form.action, {
                method: "POST",
                credentials: "same-origin",
                headers: { Accept: "application/json" },
                body,
              });
              const result: unknown = await response.json();
              if (
                response.ok &&
                result &&
                typeof result === "object" &&
                "ok" in result &&
                result.ok === true
              ) {
                status.textContent = "PDF firmado guardado.";
                await navigate(`${location.pathname}?signed=saved`, {
                  history: "replace",
                });
                return;
              }
              error.textContent =
                result &&
                typeof result === "object" &&
                "message" in result &&
                typeof result.message === "string"
                  ? result.message
                  : "No se pudo guardar el documento. Reintenta.";
              if (response.status === 409) {
                const key = form.querySelector<HTMLInputElement>(
                  '[name="requestKey"]',
                )!;
                key.value = crypto.randomUUID();
              }
              error.focus();
            } catch {
              error.textContent =
                "No se pudo guardar el documento. Conservamos el archivo; reintenta la misma solicitud.";
              error.focus();
            } finally {
              pending = false;
              submit.disabled = false;
              remove.disabled = false;
              file.disabled = false;
              form.removeAttribute("aria-busy");
              form
                .querySelector<HTMLElement>("[data-upload-spinner]")!
                .classList.add("hidden");
              label.textContent = idleLabel;
              if (error.textContent) status.textContent = "";
            }
          },
          { signal },
        );
        void selected();
      });
  }
  document.addEventListener("astro:before-swap", () => controller?.abort());
  document.addEventListener("astro:page-load", enhanceSignedUploads);
  enhanceSignedUploads();
</script>
