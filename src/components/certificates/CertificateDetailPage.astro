---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import DownloadFeedback from "@/components/DownloadFeedback.astro";
import CourseBreadcrumbs from "@/components/courses/CourseBreadcrumbs.astro";
import RegistrationPageError from "@/components/pre-registrations/RegistrationPageError.astro";
import { buttonVariants } from "@/components/ui/button";
import type { CertificateDetailProps } from "./detail-route";
import {
  certificateStateLabel,
  certificateTypeLabel,
  civilDateLabel,
} from "./presentation";
import FormFeedback from "./FormFeedback.astro";
import SignedPdfUpload from "./SignedPdfUpload.astro";
import RevokeCertificate from "./RevokeCertificate";
type Props = CertificateDetailProps;
const { load, feedback, instructorRoute, path, requestKey } = Astro.props;
const record = load.available ? load.data : null;
const title = record ? certificateTypeLabel[record.type] : "Certificado";
const groupPath = record
  ? `${instructorRoute ? "/app/mis-cursos" : "/app/cursos"}/${record.courseId}/grupos/${record.groupId}/certificados`
  : "/app/certificados";
const signed = record?.hasSignedPdf;
const editable = record && record.state !== "revoked" && !record.obsolete;
const showUpload =
  !instructorRoute && editable && (signed || record?.hasUnsignedPdf);
const showPrepared =
  Astro.url.searchParams.get("prepared") === "updated" && !signed;
const showSaved = Astro.url.searchParams.get("signed") === "saved" && signed;
const showDocument =
  showUpload || showPrepared || showSaved || Boolean(feedback.message);
---

<PrivateLayout {title}>
  <DownloadFeedback />
  <CourseBreadcrumbs
    current="Certificado"
    parents={[
      { label: "Inicio", href: "/app" },
      { label: "Certificados", href: groupPath },
    ]}
  />
  {record ? (
    <article class="mt-5 flex min-w-0 flex-col gap-7">
      <header class="flex flex-wrap items-start justify-between gap-4">
        <div class="flex min-w-0 flex-1 basis-80 flex-col gap-2">
          <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
          <div class="flex min-w-0 flex-wrap items-baseline gap-x-4 gap-y-2">
            <p class="min-w-0 break-words text-lg text-muted-foreground">
              {record.data.recipientName}
            </p>
            <span class="text-sm font-medium">
              {certificateStateLabel[record.state]}
            </span>
          </div>
        </div>
        {signed ? (
          <a
            data-astro-reload
            href={`${path}/firmado.pdf`}
            data-feedback-download
            data-certificate-download
            class={buttonVariants({ className: "min-h-11 shrink-0" })}
          >
            Descargar firmado
          </a>
        ) : (
          ["pending", "generated"].includes(record.state) &&
          (instructorRoute ? (
            <a
              data-astro-reload
              href={`${path}/generado.pdf`}
              data-feedback-download
              data-certificate-download
              class={buttonVariants({ className: "min-h-11 shrink-0" })}
            >
              Descargar para firmar
            </a>
          ) : (
            <form
              method="post"
              action={`${path}/generado.pdf`}
              data-prepare-download
              class="shrink-0"
            >
              <input type="hidden" name="revision" value={record.revision} />
              <input
                type="hidden"
                name="requestKey"
                value={crypto.randomUUID()}
              />
              <button
                type="submit"
                class={buttonVariants({ className: "min-h-11" })}
              >
                Descargar para firmar
              </button>
            </form>
          ))
        )}
      </header>
      <dl class="grid gap-x-8 gap-y-5 sm:grid-cols-2 xl:grid-cols-4">
        <div>
          <dt class="text-sm text-muted-foreground">Fechas nominales</dt>
          <dd class="mt-1 text-sm">
            {civilDateLabel(record.data.startsOn)} al{" "}
            {civilDateLabel(record.data.endsOn)}
          </dd>
        </div>
        <div>
          <dt class="text-sm text-muted-foreground">Duración</dt>
          <dd class="mt-1 font-medium">
            {record.data.academicHours} horas académicas
          </dd>
        </div>
        <div>
          <dt class="text-sm text-muted-foreground">Grupo</dt>
          <dd class="mt-1 font-medium">{record.data.groupNumber}</dd>
        </div>
        <div>
          <dt class="text-sm text-muted-foreground">Horario nominal</dt>
          <dd class="mt-1 font-medium">
            {record.data.groupStartsAt} a {record.data.groupEndsAt}
          </dd>
        </div>
      </dl>
      {!signed && record.obsolete && (
        <p role="status" class="text-sm">
          El cierre cambió. La descarga preparará el PDF desde el cierre oficial
          vigente. Si el grupo está abierto, ciérralo antes de continuar.
        </p>
      )}
      {showDocument && (
        <section
          aria-label="Documento"
          class="flex min-w-0 flex-col gap-5 border-t pt-6"
        >
          {showPrepared && (
            <p role="status" class="text-sm leading-6">
              El PDF se actualizó con los datos vigentes. Tramita las firmas
              sobre esta nueva descarga antes de guardarlo.
            </p>
          )}
          {showSaved && (
            <p role="status" class="text-sm">
              PDF firmado guardado.
            </p>
          )}
          <FormFeedback {feedback} />
          {showUpload && (
            <SignedPdfUpload
              {path}
              revision={record.revision}
              {requestKey}
              signed={Boolean(signed)}
            />
          )}
        </section>
      )}
      {signed && (
        <section
          aria-label="Credencial pública"
          class="flex min-w-0 flex-col gap-3 border-t pt-6"
        >
          <dl class="min-w-0">
            <dt class="text-sm text-muted-foreground">
              SHA-256 del PDF firmado
            </dt>
            <dd class="mt-2 break-all font-mono text-xs leading-6">
              {record.signedSha256}
            </dd>
          </dl>
          {(!instructorRoute || record.state !== "issued") && (
            <div class="flex flex-wrap items-center gap-3">
              <a
                href={`/certificados/${record.publicCredentialId}`}
                class={buttonVariants({
                  variant: "outline",
                  className: "min-h-11 self-start",
                })}
              >
                Consultar estado público
              </a>
              {!instructorRoute && record.state === "issued" && (
                <RevokeCertificate
                  client:load
                  {path}
                  requestKey={crypto.randomUUID()}
                  revision={record.revision}
                  initialReason={feedback.values.reason}
                  initialError={feedback.success ? "" : feedback.message}
                />
              )}
            </div>
          )}
          {instructorRoute && record.state === "issued" && (
            <>
              <label for="credential-share" class="text-sm font-medium">
                Datos para compartir o añadir a LinkedIn
              </label>
              <textarea
                id="credential-share"
                readonly
                rows={5}
                class="w-full rounded-lg border bg-card p-4 text-sm leading-6 focus-visible:outline-2 focus-visible:outline-ring"
              >{`${record.data.courseName}\n${record.data.organization}\nTitular: ${record.data.recipientName}\nFinalización: ${civilDateLabel(record.data.endsOn)}\nID: ${record.publicCredentialId}\nURL: ${record.data.verificationUrl}`}</textarea>
              <div class="flex flex-wrap gap-3">
                <a
                  href={`/certificados/${record.publicCredentialId}`}
                  class={buttonVariants({
                    variant: "outline",
                    className: "min-h-11 whitespace-normal text-center",
                  })}
                >
                  Consultar estado público
                </a>
                <button
                  type="button"
                  data-copy-credential
                  class={buttonVariants({
                    variant: "outline",
                    className: "min-h-11 self-start",
                  })}
                >
                  Copiar datos de credencial
                </button>
              </div>
              <p
                data-copy-status
                role="status"
                class="text-sm empty:hidden"
              ></p>
            </>
          )}
        </section>
      )}
    </article>
  ) : (
    <RegistrationPageError
      message={
        !load.available ? load.unavailableReason : "Certificado no disponible."
      }
      retryHref={path}
    />
  )}
</PrivateLayout>
<script>
  import { navigate } from "astro:transitions/client";
  import { notifications } from "@/lib/notifications";
  import { downloadCertificatePdf } from "./download-pdf";
  let downloadController: AbortController | undefined;
  function enablePreparedDownload() {
    downloadController?.abort();
    downloadController = new AbortController();
    const signal = downloadController.signal;
    document
      .querySelectorAll<HTMLFormElement>("[data-prepare-download]")
      .forEach((form) => {
        let pending = false;
        form.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();
            if (pending) return;
            pending = true;
            const button = form.querySelector<HTMLButtonElement>(
              'button[type="submit"]',
            )!;
            const hadFocus = button === document.activeElement;
            button.disabled = true;
            button.setAttribute("aria-busy", "true");
            form.setAttribute("aria-busy", "true");
            try {
              await notifications.promise(
                async () => {
                  const body = new URLSearchParams(
                    [...new FormData(form)].map(([name, value]) => [
                      name,
                      String(value),
                    ]),
                  );
                  const response = await fetch(form.action, {
                    method: "POST",
                    credentials: "same-origin",
                    signal,
                    body,
                  });
                  await downloadCertificatePdf(response, signal);
                  const revision = response.headers.get(
                    "X-Certificate-Revision",
                  );
                  if (
                    revision !==
                    form.querySelector<HTMLInputElement>('[name="revision"]')
                      ?.value
                  ) {
                    await navigate(`${location.pathname}?prepared=updated`, {
                      history: "replace",
                    });
                  } else {
                    form.querySelector<HTMLInputElement>(
                      '[name="requestKey"]',
                    )!.value = crypto.randomUUID();
                  }
                },
                {
                  loading: { title: "Preparando descarga…" },
                  success: { title: "PDF listo." },
                  error: (failure: unknown) => ({
                    title: signal.aborted
                      ? "Descarga cancelada."
                      : failure instanceof Error &&
                          !(failure instanceof TypeError)
                        ? failure.message
                        : "No se pudo preparar la descarga. Reintenta.",
                  }),
                },
              );
            } catch {
              // The same promise toast reports the failure; preserve the form for retry.
            } finally {
              pending = false;
              button.disabled = false;
              button.removeAttribute("aria-busy");
              form.removeAttribute("aria-busy");
              if (
                hadFocus &&
                button.isConnected &&
                document.activeElement === document.body
              )
                button.focus({ preventScroll: true });
            }
          },
          { signal },
        );
      });
  }
  function enableCredentialCopy() {
    const button = document.querySelector<HTMLButtonElement>(
      "[data-copy-credential]",
    );
    const text =
      document.querySelector<HTMLTextAreaElement>("#credential-share");
    const status = document.querySelector<HTMLElement>("[data-copy-status]");
    if (!button || !text || !status) return;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(text.value);
        status.textContent = "Datos copiados.";
      } catch {
        text.focus();
        text.select();
        status.textContent =
          "Seleccionamos los datos. Cópialos con el teclado.";
      }
    });
  }
  document.addEventListener("astro:page-load", enableCredentialCopy);
  document.addEventListener("astro:before-swap", () =>
    downloadController?.abort(),
  );
  document.addEventListener("astro:page-load", enablePreparedDownload);
  enablePreparedDownload();
</script>
