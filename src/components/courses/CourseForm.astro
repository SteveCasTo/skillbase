---
import type { CourseInput } from "@/domain/courses/validation";
import type { CourseFormat } from "@/domain/courses/formats";
import CourseSelect from "./CourseSelect";
import CourseImageEditor from "./CourseImageEditor";
import CourseDateTimePicker from "./CourseDateTimePicker";
import CourseSchedulePicker from "./CourseSchedulePicker";
import CourseMarkdownEditor from "./CourseMarkdownEditor";

interface Props {
  values: CourseInput;
  formats: readonly CourseFormat[];
  errors?: Readonly<Record<string, string>>;
  disabled?: boolean;
  submitLabel: string;
  intent?: "update";
  revision?: string;
  courseId?: string;
  /** Persisted course values, distinct from the attempted values after a failed POST. */
  baseline?: CourseInput | undefined;
}

const {
  values,
  formats,
  errors = {},
  disabled = false,
  submitLabel,
  intent,
  revision,
  courseId,
  baseline,
} = Astro.props;
const control =
  "mt-2 min-h-11 w-full rounded-lg border bg-background px-3 py-2 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-60";
const area = `${control} min-h-28 resize-y`;
const errorId = (name: string) => (errors[name] ? `${name}-error` : undefined);
const trackedFields = [
  "name",
  "description",
  "level",
  "courseTypeId",
  "instructorName",
  "contentMarkdown",
  "schedule",
  "conditions",
  "startsAt",
  "endsAt",
  "registrationStartAt",
  "registrationEndAt",
  "minimumGrade",
  "artwork",
] as const;
const initialValues = Object.fromEntries(
  trackedFields.map((name) => [name, baseline?.[name] ?? ""]),
);
---

<form
  method="post"
  class="course-form flex flex-col gap-8"
  data-course-id={courseId}
  data-baseline={baseline ? JSON.stringify(initialValues) : undefined}
  novalidate
>
  {intent && <input type="hidden" name="intent" value={intent} />}
  {revision && <input type="hidden" name="revision" value={revision} />}
  <input type="hidden" name="artwork" value={values.artwork ?? ""} />
  {courseId && !disabled && (
    <CourseImageEditor
      client:only="react"
      courseId={courseId}
      currentArtwork={values.artwork ?? null}
    />
  )}
  {!courseId && !disabled && <CourseImageEditor client:only="react" />}
  {!courseId && (
    <p
      class="artwork-create-error hidden text-sm text-destructive"
      role="alert"
      aria-live="assertive"
    ></p>
  )}
  {!courseId && (
    <div
      class="draft-recovery hidden rounded-lg border bg-secondary p-4 text-sm"
      role="status"
      aria-live="polite"
    >
      <p>
        El borrador ya se creó, pero la foto no quedó guardada. Puedes
        reintentar o abrir el borrador para subirla desde allí.
      </p>
      <div class="mt-3 flex flex-wrap gap-3">
        <button
          type="button"
          class="retry-artwork min-h-11 rounded-lg border px-4 font-medium"
        >
          Reintentar foto
        </button>
        <a
          class="draft-link inline-flex min-h-11 items-center rounded-lg border px-4 font-medium"
          href="/app/cursos"
        >
          Abrir borrador
        </a>
      </div>
    </div>
  )}
  {errors.artwork && (
    <p id="artwork-error" role="alert" class="text-sm text-destructive">
      {errors.artwork}
    </p>
  )}
  <fieldset disabled={disabled} class="flex flex-col gap-8 disabled:opacity-70">
    <section
      class="rounded-xl border bg-card p-5 shadow-xs sm:p-7"
      aria-labelledby="general-title"
    >
      <h2 id="general-title" class="text-xl font-semibold">
        Información general
      </h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        <label class="sm:col-span-2">
          {" "}
          <span class="text-sm font-medium">Nombre</span>
          <input
            class={control}
            name="name"
            value={values.name ?? ""}
            required
            aria-invalid={Boolean(errors.name)}
            aria-describedby={errorId("name")}
          />
          {errors.name && (
            <span id="name-error" class="mt-1 block text-sm text-destructive">
              {errors.name}
            </span>
          )}
        </label>
        <label class="sm:col-span-2">
          {" "}
          <span class="text-sm font-medium">Descripción</span>
          <textarea
            class={area}
            name="description"
            required
            aria-invalid={Boolean(errors.description)}
            aria-describedby={errorId("description")}
          >{values.description ?? ""}</textarea>
          {errors.description && (
            <span
              id="description-error"
              class="mt-1 block text-sm text-destructive"
            >
              {errors.description}
            </span>
          )}
        </label>
        <CourseSelect
          client:only="react"
          name="level"
          label="Nivel"
          value={values.level ?? ""}
          error={errors.level ?? ""}
          disabled={disabled}
          placeholder="Selecciona un nivel"
          options={[
            { value: "BASIC", label: "Básico" },
            { value: "INTERMEDIATE", label: "Medio" },
            { value: "ADVANCED", label: "Avanzado" },
          ]}
        />
        <CourseSelect
          client:only="react"
          name="courseTypeId"
          label="Formato de curso"
          value={values.courseTypeId ?? ""}
          error={errors.courseTypeId ?? ""}
          disabled={disabled || formats.length === 0}
          placeholder="Selecciona un formato"
          options={formats
            .filter(
              (format) => format.active || format.id === values.courseTypeId,
            )
            .map((format) => ({
              value: format.id,
              label: `${format.name} · ${format.totalHours} h · ${format.studentAmount} / ${format.externalAmount} BOB`,
              disabled: !format.active,
            }))}
        />
        <label class="sm:col-span-2">
          <span class="text-sm font-medium">Instructor (opcional)</span>
          <input
            class={control}
            name="instructorName"
            value={values.instructorName ?? ""}
            aria-invalid={Boolean(errors.instructorName)}
            aria-describedby={errorId("instructorName")}
          />
          {errors.instructorName && (
            <span id="instructorName-error" class="text-sm text-destructive">
              {errors.instructorName}
            </span>
          )}
        </label>
        <div class="min-w-0 sm:col-span-2">
          <label for="contentMarkdown" class="text-sm font-medium">
            Contenido del curso (Markdown, opcional)
          </label>
          <CourseMarkdownEditor
            client:load
            value={values.contentMarkdown ?? ""}
            error={errors.contentMarkdown ?? ""}
            disabled={disabled}
            describedBy="contentMarkdown-help"
          />
          <noscript>
            <textarea
              class={area}
              id="contentMarkdown"
              name="contentMarkdown"
              rows="9"
              disabled={disabled}
            >{values.contentMarkdown ?? ""}</textarea>
          </noscript>
          <span class="mt-1 block text-xs text-muted-foreground">
            <span id="contentMarkdown-help">
              Usa encabezados con ## y listas con -; el texto se publicará junto
              al curso.
            </span>
          </span>
        </div>
        <CourseSchedulePicker
          client:only="react"
          value={values.schedule ?? ""}
          error={errors.schedule ?? ""}
          disabled={disabled}
        />
        <noscript>
          <label class="sm:col-span-2">
            Horario informativo
            <input
              class={control}
              name="schedule"
              value={values.schedule ?? ""}
              required
              disabled={disabled}
            />
          </label>
        </noscript>
        <label class="sm:col-span-2">
          <span class="text-sm font-medium">Condiciones</span>
          <textarea
            class={area}
            name="conditions"
            required
            aria-invalid={Boolean(errors.conditions)}
            aria-describedby={errorId("conditions")}
          >{values.conditions ?? ""}</textarea>
          {errors.conditions && (
            <span
              id="conditions-error"
              class="mt-1 block text-sm text-destructive"
            >
              {errors.conditions}
            </span>
          )}
        </label>
      </div>
    </section>

    <section
      class="rounded-xl border bg-card p-4 shadow-xs sm:p-7"
      aria-labelledby="dates-title"
    >
      <h2 id="dates-title" class="text-xl font-semibold">
        Fechas y preinscripción
      </h2>
      <div class="mt-6 grid gap-5 lg:grid-cols-2">
        {[
          { name: "startsAt", label: "Inicio del curso" },
          { name: "endsAt", label: "Finalización del curso" },
          { name: "registrationStartAt", label: "Apertura de preinscripción" },
          { name: "registrationEndAt", label: "Cierre de preinscripción" },
        ].map(({ name, label }) => (
          <CourseDateTimePicker
            client:load
            name={name}
            label={label}
            value={values[name] ?? ""}
            required={name === "startsAt" || name === "endsAt"}
            disabled={disabled}
            error={errors[name] ?? ""}
          />
        ))}
        <noscript>
          {[
            { name: "startsAt", label: "Inicio del curso" },
            { name: "endsAt", label: "Finalización del curso" },
            {
              name: "registrationStartAt",
              label: "Apertura de preinscripción",
            },
            { name: "registrationEndAt", label: "Cierre de preinscripción" },
          ].map(({ name, label }) => (
            <label class="text-sm font-medium">
              {label} (AAAA-MM-DDTHH:mm)
              <input
                class={control}
                name={name}
                value={values[name] ?? ""}
                required={name === "startsAt" || name === "endsAt"}
                disabled={disabled}
              />
            </label>
          ))}
        </noscript>
      </div>
    </section>

    <section
      class="rounded-xl border bg-card p-5 shadow-xs sm:p-7"
      aria-labelledby="prices-title"
    >
      <h2 id="prices-title" class="text-xl font-semibold">
        Aprobación
      </h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-3">
        <label>
          <span class="text-sm font-medium">Nota mínima (0–100)</span>
          <input
            class={control}
            name="minimumGrade"
            type="number"
            min="0"
            max="100"
            step="1"
            value={values.minimumGrade ?? ""}
            required
            aria-invalid={Boolean(errors.minimumGrade)}
            aria-describedby={errorId("minimumGrade")}
          />
          {errors.minimumGrade && (
            <span
              id="minimumGrade-error"
              class="mt-1 block text-sm text-destructive"
            >
              {errors.minimumGrade}
            </span>
          )}
        </label>
      </div>
    </section>
  </fieldset>
  <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
    <a
      href="/app/cursos"
      class="inline-flex min-h-11 items-center justify-center rounded-lg border px-5 text-sm font-medium hover:bg-secondary"
    >
      Cancelar
    </a>
    <button
      type="submit"
      disabled={disabled}
      class="submit-button inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 text-sm font-semibold text-primary-foreground shadow-xs hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
    >
      <span class="submit-label">{submitLabel}</span>
      <span class="submit-pending hidden">Guardando…</span>
    </button>
  </div>
</form>

<script>
  import { createCourseWithArtwork } from "./createCourseWithArtwork";
  let preparedImage: File | null = null;
  let imageSelected = false;
  window.addEventListener("course-artwork-selection", (event) => {
    imageSelected = (event as CustomEvent<boolean>).detail;
  });
  window.addEventListener("course-artwork-prepared", (event) => {
    preparedImage = (event as CustomEvent<File | null>).detail;
  });
  window.addEventListener("course-artwork-uploaded", (event) => {
    const detail = (event as CustomEvent<{ courseId: string; key: string }>)
      .detail;
    const form = document.querySelector<HTMLFormElement>(
      `.course-form[data-course-id="${detail.courseId}"]`,
    );
    const artwork = form?.querySelector<HTMLInputElement>(
      'input[name="artwork"]',
    );
    if (artwork) {
      artwork.value = detail.key;
      artwork.dispatchEvent(new Event("change", { bubbles: true }));
    }
  });
  document.querySelectorAll<HTMLFormElement>(".course-form").forEach((form) => {
    const button = form.querySelector<HTMLButtonElement>(".submit-button");
    const baseline: Record<string, string> | null = form.dataset.baseline
      ? JSON.parse(form.dataset.baseline)
      : null;
    if (baseline && button && !button.disabled) {
      // The SSR button stays usable without JavaScript. Once JS runs, wait for
      // all form-associated islands before comparing against persisted values.
      button.disabled = true;
      let ready = false;
      const fields = Object.keys(baseline);
      const sync = () => {
        const current = new FormData(form);
        if (!ready && !fields.every((name) => current.has(name))) return;
        ready = true;
        button.disabled = fields.every((name) => {
          const values = current.getAll(name);
          return (
            values.length === 1 &&
            values[0] === (baseline[name] ?? "").replace(/\r\n?/g, "\n")
          );
        });
      };
      // FormData reads the controls' current values directly, including hidden
      // fields updated by React islands, so reconcile each change immediately.
      form.addEventListener("input", sync);
      form.addEventListener("change", sync);
      form.addEventListener("course-form-change", sync);
      const observer = new MutationObserver(() => {
        sync();
      });
      observer.observe(form, { childList: true, subtree: true });
      sync();
      // Reconcile after all islands hydrate, even if their first form controls
      // appeared before their final values were committed.
      window.addEventListener(
        "load",
        () => {
          sync();
          observer.disconnect();
        },
        { once: true },
      );
      window.addEventListener("pageshow", sync);
    }
    form.addEventListener("submit", (event) => {
      if (!form.reportValidity()) {
        event.preventDefault();
        return;
      }
      if (!form.dataset.courseId && imageSelected) {
        event.preventDefault();
        const error = form.querySelector<HTMLElement>(".artwork-create-error");
        const recovery = form.querySelector<HTMLElement>(".draft-recovery");
        const retry = form.querySelector<HTMLButtonElement>(".retry-artwork");
        const link = form.querySelector<HTMLAnchorElement>(".draft-link");
        if (!error || !recovery || !retry || !link) return;
        if (!preparedImage) {
          error.textContent =
            "Confirma el recorte con “Usar este recorte” antes de crear el borrador.";
          error.classList.remove("hidden");
          error.scrollIntoView({ block: "center" });
          return;
        }
        const fields = new FormData(form);
        const image = preparedImage;
        if (button) {
          button.disabled = true;
          button.querySelector(".submit-label")?.classList.add("hidden");
          button.querySelector(".submit-pending")?.classList.remove("hidden");
        }
        error.classList.add("hidden");
        let draftExists = false;
        const showError = (caught: unknown) => {
          error.textContent =
            caught instanceof Error
              ? caught.message
              : "No se pudo guardar. Inténtalo nuevamente.";
          error.classList.remove("hidden");
          error.scrollIntoView({ block: "center" });
          if (draftExists) recovery.classList.remove("hidden");
          if (!draftExists && button) {
            button.disabled = false;
            button.querySelector(".submit-label")?.classList.remove("hidden");
            button.querySelector(".submit-pending")?.classList.add("hidden");
          }
        };
        void createCourseWithArtwork(fields, image, (url, attach) => {
          draftExists = true;
          link.href = url;
          retry.onclick = () => {
            retry.disabled = true;
            error.classList.add("hidden");
            void attach()
              .catch(showError)
              .finally(() => {
                retry.disabled = false;
              });
          };
        }).catch(showError);
        return;
      }
      if (!button) return;
      button.disabled = true;
      button.querySelector(".submit-label")?.classList.add("hidden");
      button.querySelector(".submit-pending")?.classList.remove("hidden");
    });
  });
</script>
