---
import type { CourseInput } from "@/domain/courses/validation";
import type { CourseFormat } from "@/domain/courses/formats";
import type { InstructorProfile } from "@/domain/instructors/profile";
import CourseSelect from "./CourseSelect";
import CourseImageEditor from "./CourseImageEditor";
import CourseDateTimePicker from "./CourseDateTimePicker";
import CourseDatePicker from "./CourseDatePicker";
import CourseSchedulePicker from "./CourseSchedulePicker";
import CourseWeekdayPlanner from "./CourseWeekdayPlanner";
import CourseMarkdownEditor from "./CourseMarkdownEditor";
import { GROUP_SCHEDULE } from "@/domain/courses/weekday-schedule";
import { publicArtworkUrl } from "@/server/courses/artwork";

interface Props {
  values: CourseInput;
  formats: readonly CourseFormat[];
  instructors?: readonly InstructorProfile[];
  errors?: Readonly<Record<string, string>>;
  disabled?: boolean;
  submitLabel: string;
  requestKey?: string;
  intent?: "update";
  revision?: string;
  courseId?: string;
  /** Persisted course values, distinct from the attempted values after a failed POST. */
  baseline?: CourseInput | undefined;
  pinnedFormat?:
    { totalHours: number; sessionMinutes: number | null } | undefined;
}

const {
  values,
  formats,
  instructors = [],
  errors = {},
  disabled = false,
  submitLabel,
  requestKey,
  intent,
  revision,
  courseId,
  baseline,
  pinnedFormat,
} = Astro.props;
const control =
  "mt-2 min-h-11 w-full rounded-lg border bg-background px-3 py-2 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-60";
const area = `${control} min-h-28 resize-y`;
const errorId = (name: string) => (errors[name] ? `${name}-error` : undefined);
const legacy = Boolean(courseId && !baseline?.weekdays);
const historicalHourlyPlan = Boolean(
  courseId && baseline?.weekdays && !baseline.startsAt?.endsWith("T00:00"),
);
const dateOnlyRegistration =
  !courseId || baseline?.registrationStartDate !== undefined;
const trackedFields = [
  "name",
  "description",
  "level",
  "courseTypeId",
  "instructorId",
  "contentMarkdown",
  "schedule",
  "conditions",
  "startsAt",
  "endsAt",
  ...(dateOnlyRegistration
    ? (["registrationStartDate", "registrationEndDate"] as const)
    : (["registrationStartAt", "registrationEndAt"] as const)),
  "minimumGrade",
  "artwork",
] as const;
const initialValues = Object.fromEntries(
  trackedFields.map((name) => [name, baseline?.[name] ?? ""]),
);
const displayedArtwork = courseId
  ? (baseline?.artwork ?? values.artwork)
  : values.artwork;
const currentArtworkUrl = publicArtworkUrl(
  displayedArtwork,
  import.meta.env.PUBLIC_SUPABASE_URL,
);
---

<form
  method="post"
  class="course-form flex flex-col gap-8"
  data-course-id={courseId}
  data-course-mutation-id={courseId}
  data-baseline={baseline ? JSON.stringify(initialValues) : undefined}
  data-group-formats={JSON.stringify(
    formats.map(({ id, sessionMinutes }) => [id, sessionMinutes]),
  )}
  novalidate
>
  {intent && <input type="hidden" name="intent" value={intent} />}
  {requestKey && <input type="hidden" name="requestKey" value={requestKey} />}
  {revision && <input type="hidden" name="revision" value={revision} />}
  <input type="hidden" name="artwork" value={values.artwork ?? ""} />
  {!courseId && (
    <p
      class="artwork-create-error hidden text-sm text-destructive"
      role="alert"
      aria-live="assertive"
    ></p>
  )}
  {!courseId && (
    <div
      class="draft-recovery hidden rounded-lg border bg-secondary p-4 text-sm"
      role="status"
      aria-live="polite"
    >
      <p>
        El borrador ya se creó, pero faltan cambios por guardar. Puedes
        reintentar o abrirlo para continuar.
      </p>
      <div class="mt-3 flex flex-wrap gap-3">
        <button
          type="button"
          class="retry-artwork min-h-11 rounded-lg border px-4 font-medium"
        >
          Reintentar pendientes
        </button>
        <a
          class="draft-link inline-flex min-h-11 items-center rounded-lg border px-4 font-medium"
          href="/app/cursos"
        >
          Abrir borrador
        </a>
      </div>
    </div>
  )}
  {errors.artwork && (
    <p id="artwork-error" role="alert" class="text-sm text-destructive">
      {errors.artwork}
    </p>
  )}
  <fieldset disabled={disabled} class="flex flex-col gap-8 disabled:opacity-70">
    <section
      class="rounded-xl border bg-card p-5 shadow-xs sm:p-7"
      aria-labelledby="general-title"
    >
      <h2 id="general-title" class="text-xl font-semibold">
        Información general
      </h2>
      <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(16rem,0.8fr)_minmax(0,1.4fr)] lg:items-start">
        {!disabled && (
          <CourseImageEditor
            client:load
            {...(courseId ? { courseId } : {})}
            currentArtwork={displayedArtwork ?? null}
            currentArtworkUrl={currentArtworkUrl}
          />
        )}
        <div class="grid min-w-0 gap-5">
          <label>
            {" "}
            <span class="text-sm font-medium">Nombre</span>
            <input
              class={control}
              name="name"
              data-course-input="text"
              value={values.name ?? ""}
              required
              aria-invalid={Boolean(errors.name)}
              aria-describedby={errorId("name")}
            />
            {errors.name && (
              <span id="name-error" class="mt-1 block text-sm text-destructive">
                {errors.name}
              </span>
            )}
          </label>
          <label>
            {" "}
            <span class="text-sm font-medium">Descripción</span>
            <textarea
              class={area}
              name="description"
              data-course-input="multiline"
              required
              aria-invalid={Boolean(errors.description)}
              aria-describedby={errorId("description")}
            >{values.description ?? ""}</textarea>
            {errors.description && (
              <span
                id="description-error"
                class="mt-1 block text-sm text-destructive"
              >
                {errors.description}
              </span>
            )}
          </label>
        </div>
      </div>
      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        <CourseSelect
          client:only="react"
          name="level"
          label="Nivel"
          value={values.level ?? ""}
          error={errors.level ?? ""}
          disabled={disabled}
          placeholder="Selecciona un nivel"
          options={[
            { value: "BASIC", label: "Básico" },
            { value: "INTERMEDIATE", label: "Medio" },
            { value: "ADVANCED", label: "Avanzado" },
          ]}
        />
        <div data-format-field>
          <CourseSelect
            client:only="react"
            name="courseTypeId"
            label="Formato de curso"
            value={values.courseTypeId ?? ""}
            error={errors.courseTypeId ?? ""}
            disabled={disabled || formats.length === 0}
            placeholder="Selecciona un formato"
            options={formats
              .filter(
                (format) => format.active || format.id === values.courseTypeId,
              )
              .map((format) => ({
                value: format.id,
                label: `${format.name} · ${format.totalHours} h · ${format.studentAmount} / ${format.externalAmount} BOB`,
                disabled:
                  !format.active ||
                  (!courseId && format.sessionMinutes === null),
              }))}
          />
          <p
            data-format-error
            id="courseTypeId-client-error"
            role="alert"
            hidden
            class="mt-1 text-sm text-destructive"
          ></p>
        </div>
        <noscript>
          <label class="text-sm font-medium">
            Nivel
            <select class={control} name="level" required disabled={disabled}>
              <option value="">Selecciona un nivel</option>
              {[
                { value: "BASIC", label: "Básico" },
                { value: "INTERMEDIATE", label: "Medio" },
                { value: "ADVANCED", label: "Avanzado" },
              ].map((option) => (
                <option
                  value={option.value}
                  selected={values.level === option.value}
                >
                  {option.label}
                </option>
              ))}
            </select>
          </label>
          <label class="text-sm font-medium">
            Formato de curso
            <select
              class={control}
              name="courseTypeId"
              required
              disabled={disabled || formats.length === 0}
            >
              <option value="">Selecciona un formato</option>
              {formats
                .filter(
                  (format) =>
                    format.active || format.id === values.courseTypeId,
                )
                .map((format) => (
                  <option
                    value={format.id}
                    selected={values.courseTypeId === format.id}
                    disabled={
                      !format.active ||
                      (!courseId && format.sessionMinutes === null)
                    }
                  >
                    {format.name}
                  </option>
                ))}
            </select>
          </label>
        </noscript>
        <div class="sm:col-span-2">
          <CourseSelect
            client:only="react"
            name="instructorId"
            label="Instructor"
            preserveDisabledValue={Boolean(courseId) && !values.instructorId}
            value={values.instructorId || "unassigned"}
            placeholder="Selecciona un instructor"
            required={false}
            disabled={disabled}
            error={errors.instructorId ?? ""}
            options={[
              {
                value: "unassigned",
                label: "Sin asignar (solo borrador)",
                disabled: Boolean(courseId),
              },
              ...instructors
                .filter((instructor) => instructor.status === "ACTIVE")
                .map((instructor) => ({
                  value: instructor.id,
                  label: `${instructor.firstName} ${instructor.lastName}`,
                })),
            ]}
          >
            <div slot="fallback" class="flex flex-col gap-2">
              <label for="instructorId-native" class="text-sm font-medium">
                Instructor
              </label>
              {courseId && !values.instructorId && (
                <input type="hidden" name="instructorId" value="" />
              )}
              <select
                id="instructorId-native"
                name="instructorId"
                class={control}
                disabled={disabled}
                aria-invalid={Boolean(errors.instructorId)}
              >
                <option
                  value=""
                  selected={!values.instructorId}
                  disabled={Boolean(courseId)}
                >
                  Sin asignar (solo borrador)
                </option>
                {instructors
                  .filter((instructor) => instructor.status === "ACTIVE")
                  .map((instructor) => (
                    <option
                      value={instructor.id}
                      selected={values.instructorId === instructor.id}
                    >
                      {instructor.firstName} {instructor.lastName}
                    </option>
                  ))}
              </select>
              {errors.instructorId && (
                <p class="text-sm text-destructive">{errors.instructorId}</p>
              )}
            </div>
          </CourseSelect>
          <p class="mt-2 text-sm text-muted-foreground">
            Todos los grupos heredan esta asignación. Obligatorio para publicar;
            no se puede cambiar desde el inicio oficial.
          </p>
        </div>
        <div class="min-w-0 sm:col-span-2">
          <label for="contentMarkdown" class="text-sm font-medium">
            Contenido del curso (Markdown, opcional)
          </label>
          <CourseMarkdownEditor
            client:load
            value={values.contentMarkdown ?? ""}
            error={errors.contentMarkdown ?? ""}
            disabled={disabled}
            describedBy="contentMarkdown-help"
          />
          <span class="mt-1 block text-xs text-muted-foreground">
            <span id="contentMarkdown-help">
              Usa encabezados con ## y listas con -; el texto se publicará junto
              al curso.
            </span>
          </span>
        </div>
        {legacy && (
          <CourseSchedulePicker
            client:only="react"
            value={values.schedule ?? ""}
            error={errors.schedule ?? ""}
            disabled={disabled}
          />
        )}
        <noscript>
          {legacy || historicalHourlyPlan ? (
            <>
              <label class="sm:col-span-2">
                {legacy
                  ? "Horario informativo legado"
                  : "Horario planificado histórico"}
                <input
                  class={control}
                  name="schedule"
                  data-course-input="text"
                  value={values.schedule ?? ""}
                  required
                  disabled={disabled}
                />
              </label>
              {historicalHourlyPlan && (
                <input type="hidden" name="weekdays" value="1,2,3,4,5" />
              )}
            </>
          ) : (
            <>
              <input type="hidden" name="schedule" value={GROUP_SCHEDULE} />
              <input type="hidden" name="weekdays" value="1,2,3,4,5" />
            </>
          )}
        </noscript>
        <label class="sm:col-span-2">
          <span class="text-sm font-medium">Condiciones</span>
          <textarea
            class={area}
            name="conditions"
            data-course-input="multiline"
            required
            aria-invalid={Boolean(errors.conditions)}
            aria-describedby={errorId("conditions")}
          >{values.conditions ?? ""}</textarea>
          {errors.conditions && (
            <span
              id="conditions-error"
              class="mt-1 block text-sm text-destructive"
            >
              {errors.conditions}
            </span>
          )}
        </label>
      </div>
    </section>

    <section
      class="rounded-xl border bg-card p-4 shadow-xs sm:p-7"
      aria-labelledby="dates-title"
    >
      <h2 id="dates-title" class="text-xl font-semibold">
        Fechas y preinscripción
      </h2>
      <div class="mt-6 grid gap-5 lg:grid-cols-2">
        {legacy ? (
          [
            { name: "startsAt", label: "Inicio del curso" },
            { name: "endsAt", label: "Finalización del curso" },
          ].map(({ name, label }) => (
            <CourseDateTimePicker
              client:only="react"
              name={name}
              data-course-input="text"
              label={label}
              value={values[name] ?? ""}
              required={name === "startsAt" || name === "endsAt"}
              disabled={disabled}
              error={errors[name] ?? ""}
            />
          ))
        ) : (
          <CourseWeekdayPlanner
            client:only="react"
            newCourse={!courseId}
            formats={formats.map((format) =>
              format.id === values.courseTypeId && pinnedFormat
                ? { ...format, ...pinnedFormat }
                : format,
            )}
            startsAt={values.startsAt ?? ""}
            endsAt={values.endsAt ?? ""}
            error={
              errors.startDate ??
              errors.startsAt ??
              errors.endsAt ??
              errors.weekdays ??
              ""
            }
            disabled={disabled}
          />
        )}
        {dateOnlyRegistration
          ? (
              [
                {
                  name: "registrationStartDate",
                  label: "Apertura de preinscripción",
                },
                {
                  name: "registrationEndDate",
                  label: "Último día de preinscripción",
                },
              ] as const
            ).map(({ name, label }) => (
              <CourseDatePicker
                client:only="react"
                name={name}
                label={label}
                value={values[name] ?? ""}
                disabled={disabled}
                error={
                  errors[name] ??
                  errors[
                    name === "registrationStartDate"
                      ? "registrationStartAt"
                      : "registrationEndAt"
                  ] ??
                  ""
                }
              />
            ))
          : (
              [
                {
                  name: "registrationStartAt",
                  label: "Apertura de preinscripción",
                },
                {
                  name: "registrationEndAt",
                  label: "Cierre de preinscripción",
                },
              ] as const
            ).map(({ name, label }) => (
              <CourseDateTimePicker
                client:only="react"
                name={name}
                label={label}
                value={values[name] ?? ""}
                required={false}
                disabled={disabled}
                error={errors[name] ?? ""}
              />
            ))}
        {dateOnlyRegistration && (
          <p class="text-xs text-muted-foreground lg:col-span-2">
            El plazo incluye todo el día de cierre en Bolivia. Completa ambas
            fechas o deja ambas vacías; el cierre debe ser anterior al inicio de
            clases.
          </p>
        )}
        <noscript>
          {legacy || historicalHourlyPlan
            ? [
                { name: "startsAt", label: "Inicio del curso" },
                { name: "endsAt", label: "Finalización del curso" },
              ].map(({ name, label }) => (
                <label class="text-sm font-medium">
                  {label} (AAAA-MM-DDTHH:mm)
                  <input
                    class={control}
                    name={name}
                    value={values[name] ?? ""}
                    required
                    disabled={disabled}
                  />
                </label>
              ))
            : [
                { name: "startDate", label: "Fecha de inicio de clases" },
                { name: "endDate", label: "Fecha de finalización" },
              ].map(({ name, label }) => (
                <label class="text-sm font-medium">
                  {label} (Bolivia)
                  <input
                    class={control}
                    type="date"
                    name={name}
                    value={
                      values[name] ??
                      values[
                        name === "startDate" ? "startsAt" : "endsAt"
                      ]?.slice(0, 10) ??
                      ""
                    }
                    required
                    disabled={disabled}
                  />
                </label>
              ))}
          {(dateOnlyRegistration
            ? ([
                {
                  name: "registrationStartDate",
                  label: "Apertura de preinscripción",
                },
                {
                  name: "registrationEndDate",
                  label: "Último día de preinscripción",
                },
              ] as const)
            : ([
                {
                  name: "registrationStartAt",
                  label: "Apertura de preinscripción",
                },
                {
                  name: "registrationEndAt",
                  label: "Cierre de preinscripción",
                },
              ] as const)
          ).map(({ name, label }) => (
            <label class="text-sm font-medium">
              {label} ({dateOnlyRegistration ? "Bolivia" : "AAAA-MM-DDTHH:mm"})
              <input
                class={control}
                type={dateOnlyRegistration ? "date" : "text"}
                name={name}
                value={values[name] ?? ""}
                disabled={disabled}
              />
            </label>
          ))}
        </noscript>
      </div>
    </section>

    {!courseId && !disabled && (
      <section
        class="rounded-xl border bg-card p-5 shadow-xs sm:p-7"
        aria-labelledby="initial-groups-title"
        data-initial-groups
      >
        <h2 id="initial-groups-title" class="text-xl font-semibold">
          Grupos iniciales
        </h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Añade horarios y cupos para los grupos iniciales (opcional).
        </p>
        <div data-initial-group-list class="mt-5 flex flex-col gap-3"></div>
        <template data-initial-group-template>
          <div
            class="grid gap-3 rounded-lg border p-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] sm:items-end"
            data-initial-group
          >
            <label class="min-w-0 text-sm font-medium">
              <div class="flex min-h-5 items-baseline justify-between gap-2 whitespace-nowrap">
                <span class="shrink-0">Hora de inicio</span>
                <span
                  class="min-w-0 truncate text-xs font-normal text-muted-foreground"
                  data-initial-group-end
                  aria-live="polite"
                ></span>
              </div>
              <input
                class={control}
                type="time"
                name="initialGroupTime"
                required
              />
            </label>
            <label class="min-w-0 text-sm font-medium">
              Capacidad (personas)
              <input
                class={control}
                type="number"
                name="initialGroupCapacity"
                min="1"
                max="2147483647"
                step="1"
                required
              />
            </label>
            <button
              type="button"
              class="min-h-11 rounded-lg border px-4 text-sm font-medium hover:bg-secondary"
              data-remove-initial-group
            >
              Quitar
            </button>
          </div>
        </template>
        <button
          type="button"
          class="mt-4 min-h-11 rounded-lg border px-4 text-sm font-medium hover:bg-secondary"
          data-add-initial-group
        >
          Añadir grupo
        </button>
        <p
          data-initial-group-error
          role="alert"
          hidden
          class="mt-3 text-sm text-destructive"
        ></p>
        <noscript>
          <p class="mt-2 text-sm text-muted-foreground">
            Podrás añadir grupos después de crear el borrador.
          </p>
        </noscript>
      </section>
    )}

    <section
      class="rounded-xl border bg-card p-5 shadow-xs sm:p-7"
      aria-labelledby="prices-title"
    >
      <h2 id="prices-title" class="text-xl font-semibold">
        Aprobación
      </h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-3">
        <div>
          <label for="minimumGrade" class="text-sm font-medium">
            Nota mínima (0–100)
          </label>
          <input
            class={control}
            id="minimumGrade"
            name="minimumGrade"
            type="text"
            inputmode="numeric"
            data-course-input="grade"
            value={values.minimumGrade ?? ""}
            required
            aria-invalid={Boolean(errors.minimumGrade)}
            aria-describedby={errorId("minimumGrade")}
          />
          {errors.minimumGrade && (
            <span
              id="minimumGrade-error"
              class="mt-1 block text-sm text-destructive"
            >
              {errors.minimumGrade}
            </span>
          )}
        </div>
      </div>
    </section>
  </fieldset>
  <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
    <a
      href="/app/cursos"
      class="inline-flex min-h-11 items-center justify-center rounded-lg border px-5 text-sm font-medium hover:bg-secondary"
    >
      Cancelar
    </a>
    <button
      type="submit"
      disabled={disabled}
      class="submit-button inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 text-sm font-semibold text-primary-foreground shadow-xs hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
    >
      <span class="submit-label">{submitLabel}</span>
      <span class="submit-pending hidden">Guardando…</span>
    </button>
  </div>
</form>

<script>
  import { notifications } from "@/lib/notifications";
  import {
    acquireCourseMutation,
    synchronizeCourseRevision,
  } from "./course-mutation-lock";
  import { isCourseSaveResult } from "@/domain/courses/mutation-result";
  import {
    createCourseWithArtwork,
    DefinitiveCreateError,
    isError,
    type InitialGroup,
  } from "./createCourseWithArtwork";
  import {
    acceptsCourseInput,
    draftFieldsReady,
    type CourseInputKind,
  } from "./course-input-filter";
  import { groupEndTime } from "./group-schedule-preview";
  document.addEventListener("astro:page-load", () => {
    let preparedImage: File | null = null;
    let imageSelected = false;
    window.addEventListener("course-artwork-selection", (event) => {
      imageSelected = (event as CustomEvent<boolean>).detail;
    });
    window.addEventListener("course-artwork-prepared", (event) => {
      preparedImage = (event as CustomEvent<File | null>).detail;
      document
        .querySelector<HTMLFormElement>(".course-form")
        ?.dispatchEvent(new Event("course-form-change"));
    });
    document
      .querySelectorAll<HTMLFormElement>(".course-form")
      .forEach((form) => {
        const mutationPath = window.location.pathname;
        const button = form.querySelector<HTMLButtonElement>(".submit-button");
        const groupList = form.querySelector<HTMLElement>(
          "[data-initial-group-list]",
        );
        const groupTemplate = form.querySelector<HTMLTemplateElement>(
          "[data-initial-group-template]",
        );
        const formatError = form.querySelector<HTMLElement>(
          "[data-format-error]",
        );
        const formatTrigger = () =>
          form.querySelector<HTMLElement>("#courseTypeId-select");
        const clearFormatError = () => {
          if (!formatError || formatError.hidden) return;
          formatError.hidden = true;
          const trigger = formatTrigger();
          trigger?.removeAttribute("aria-invalid");
          trigger?.removeAttribute("aria-describedby");
        };
        const showFormatError = (message: string) => {
          if (!formatError) return;
          formatError.textContent = message;
          formatError.hidden = false;
          const trigger = formatTrigger();
          trigger?.setAttribute("aria-invalid", "true");
          trigger?.setAttribute("aria-describedby", formatError.id);
          trigger?.scrollIntoView({ block: "center" });
          trigger?.focus();
        };
        form.addEventListener("change", () => {
          if (new FormData(form).get("courseTypeId")) clearFormatError();
        });
        const updateGroupPreviews = () => {
          const formats = JSON.parse(form.dataset.groupFormats ?? "[]") as [
            string,
            number | null,
          ][];
          const minutes =
            formats.find(
              ([id]) => id === String(new FormData(form).get("courseTypeId")),
            )?.[1] ?? null;
          const intervals: [number, number][] = [];
          let issue = "";
          groupList
            ?.querySelectorAll<HTMLElement>("[data-initial-group]")
            .forEach((row, index) => {
              const input = row.querySelector<HTMLInputElement>(
                '[name="initialGroupTime"]',
              );
              const hint = row.querySelector<HTMLElement>(
                "[data-initial-group-end]",
              );
              if (!input || !hint) return;
              input.setAttribute(
                "aria-label",
                `Hora de inicio del grupo ${index + 1}`,
              );
              const time = input.value;
              const end = groupEndTime(time, minutes);
              hint.textContent = end
                ? `Fin ${end}`
                : time
                  ? "No termina hoy"
                  : "";
              if (time && !end)
                issue = "Elige horarios que terminen el mismo día.";
              if (end) {
                const [hour, minute] = time.split(":").map(Number);
                const start = hour! * 60 + minute!;
                const finish = start + minutes!;
                if (
                  intervals.some(
                    ([otherStart, otherEnd]) =>
                      start < otherEnd && otherStart < finish,
                  )
                )
                  issue = "Los horarios de los grupos no pueden solaparse.";
                intervals.push([start, finish]);
              }
            });
          const warning = form.querySelector<HTMLElement>(
            "[data-initial-group-error]",
          );
          if (warning) {
            warning.textContent = issue;
            warning.hidden = !issue;
          }
        };
        form.addEventListener("input", updateGroupPreviews);
        form.addEventListener("change", updateGroupPreviews);
        form.addEventListener("course-form-change", updateGroupPreviews);
        form
          .querySelector<HTMLButtonElement>("[data-add-initial-group]")
          ?.addEventListener("click", () => {
            if (!groupList || !groupTemplate) return;
            const row = groupTemplate.content.cloneNode(true);
            groupList.append(row);
            groupList.lastElementChild
              ?.querySelector<HTMLInputElement>(
                'input[name="initialGroupTime"]',
              )
              ?.focus();
            form.dispatchEvent(new Event("course-form-change"));
          });
        groupList?.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          target
            .closest("[data-remove-initial-group]")
            ?.closest("[data-initial-group]")
            ?.remove();
          form.dispatchEvent(new Event("course-form-change"));
        });
        // Capture edits before React's delegated change handlers see them. Invalid
        // paste/drop/IME commits are reverted as a whole, never sanitized into a
        // different value that might inadvertently be submitted.
        const admitted = new WeakMap<
          HTMLInputElement | HTMLTextAreaElement,
          string
        >();
        const filtered = (target: EventTarget | null) => {
          if (!(
            target instanceof HTMLInputElement ||
            target instanceof HTMLTextAreaElement
          ))
            return null;
          const kind = target.dataset.courseInput as
            CourseInputKind | undefined;
          return kind ? { target, kind } : null;
        };
        form.addEventListener("beforeinput", (event) => {
          const input = event as InputEvent;
          const field = filtered(event.target);
          if (
            !field ||
            input.isComposing ||
            !input.cancelable ||
            input.inputType.startsWith("delete")
          )
            return;
          const { target, kind } = field;
          const inserted =
            input.data ?? input.dataTransfer?.getData("text/plain") ?? "";
          if (!inserted) return;
          const candidate =
            target.value.slice(
              0,
              target.selectionStart ?? target.value.length,
            ) +
            inserted +
            target.value.slice(target.selectionEnd ?? target.value.length);
          if (!acceptsCourseInput(kind, candidate)) event.preventDefault();
        });
        form.addEventListener(
          "input",
          (event) => {
            const field = filtered(event.target);
            if (!field || (event as InputEvent).isComposing) return;
            const { target, kind } = field;
            if (acceptsCourseInput(kind, target.value))
              admitted.set(target, target.value);
            else target.value = admitted.get(target) ?? target.defaultValue;
          },
          true,
        );
        form.addEventListener("compositionstart", (event) => {
          const field = filtered(event.target);
          if (field && acceptsCourseInput(field.kind, field.target.value))
            admitted.set(field.target, field.target.value);
        });
        form.addEventListener("compositionend", (event) => {
          const field = filtered(event.target);
          if (!field) return;
          if (!acceptsCourseInput(field.kind, field.target.value)) {
            field.target.value =
              admitted.get(field.target) ?? field.target.defaultValue;
            field.target.dispatchEvent(new Event("input", { bubbles: true }));
          }
        });
        let baseline: Record<string, string> | null = form.dataset.baseline
          ? JSON.parse(form.dataset.baseline)
          : null;
        let saving = false;
        let createdDraft = false;
        let pendingArtworkKey: string | null = null;
        window.addEventListener("course-artwork-prepared", () => {
          pendingArtworkKey = null;
        });
        if (button && !button.disabled) {
          // The SSR button stays usable without JavaScript. Once JS runs, wait for
          // all form-associated islands before comparing against persisted values.
          button.disabled = true;
          form.dataset.validationInitialized = "true";
          let ready = false;
          const fields = baseline ? Object.keys(baseline) : [];
          const sync = () => {
            const current = new FormData(form);
            if (
              !ready &&
              (baseline
                ? !fields.every((name) => current.has(name))
                : !formatTrigger())
            )
              return;
            ready = true;
            const changed = baseline
              ? Boolean(preparedImage) ||
                !fields.every((name) => {
                  const values = current.getAll(name);
                  return (
                    values.length === 1 &&
                    (name === "instructorId" && values[0] === "unassigned"
                      ? ""
                      : values[0]) ===
                      (name === "instructorId" &&
                      baseline?.[name] === "unassigned"
                        ? ""
                        : (baseline?.[name] ?? "")
                      ).replace(/\r\n?/g, "\n")
                  );
                })
              : false;
            const values = Object.fromEntries(
              [...current.entries()].filter(
                (entry): entry is [string, string] =>
                  typeof entry[1] === "string",
              ),
            );
            // Keep an untouched draft disabled, but once named permit an
            // attempt without a format to show its field-level error.
            const awaitingFormat =
              !baseline && !values.courseTypeId && Boolean(values.name?.trim());
            const valid =
              form.checkValidity() && draftFieldsReady(values, !baseline);
            button.disabled =
              saving ||
              form.dataset.mutationPending === "true" ||
              createdDraft ||
              form.dataset.archived === "true" ||
              (baseline ? !changed || !valid : !awaitingFormat && !valid);
          };
          // FormData reads the controls' current values directly, including hidden
          // fields updated by React islands, so reconcile each change immediately.
          form.addEventListener("input", sync);
          form.addEventListener("change", sync);
          form.addEventListener("course-form-change", sync);
          const observer = new MutationObserver(() => {
            sync();
          });
          observer.observe(form, { childList: true, subtree: true });
          sync();
          // Reconcile after all islands hydrate, even if their first form controls
          // appeared before their final values were committed.
          window.addEventListener(
            "load",
            () => {
              sync();
              observer.disconnect();
            },
            { once: true },
          );
          window.addEventListener("pageshow", sync);
        }
        form.addEventListener("submit", (event) => {
          if (saving || createdDraft) {
            event.preventDefault();
            return;
          }
          if (
            !form.dataset.courseId &&
            !new FormData(form).get("courseTypeId")
          ) {
            event.preventDefault();
            showFormatError("Selecciona un formato de curso.");
            return;
          }
          if (!form.reportValidity()) {
            event.preventDefault();
            return;
          }
          if (!form.dataset.courseId) {
            event.preventDefault();
            const error = form.querySelector<HTMLElement>(
              ".artwork-create-error",
            );
            const recovery = form.querySelector<HTMLElement>(".draft-recovery");
            const retry =
              form.querySelector<HTMLButtonElement>(".retry-artwork");
            const link = form.querySelector<HTMLAnchorElement>(".draft-link");
            if (!error || !recovery || !retry || !link) return;
            if (imageSelected && !preparedImage) {
              error.textContent =
                "Confirma el recorte con “Guardar recorte” antes de crear el borrador.";
              error.classList.remove("hidden");
              error.scrollIntoView({ block: "center" });
              return;
            }
            const fields = new FormData(form);
            const image = preparedImage;
            const times = fields.getAll("initialGroupTime");
            const capacities = fields.getAll("initialGroupCapacity");
            const groups: InitialGroup[] = times.map((time, index) => ({
              startTime: String(time),
              capacity: Number(capacities[index]),
            }));
            const formats = JSON.parse(form.dataset.groupFormats ?? "[]") as [
              string,
              number | null,
            ][];
            const minutes = formats.find(
              ([id]) => id === String(fields.get("courseTypeId")),
            )?.[1];
            const intervals: [number, number][] = [];
            let groupIssue = "";
            for (const group of groups) {
              const [hour, minute] = group.startTime.split(":").map(Number);
              const start = hour! * 60 + minute!;
              if (
                !/^([01]\d|2[0-3]):[0-5]\d$/.test(group.startTime) ||
                minutes == null ||
                start + minutes >= 1440
              ) {
                groupIssue = "Elige horarios que terminen el mismo día.";
                break;
              }
              if (
                intervals.some(
                  ([otherStart, otherEnd]) =>
                    start < otherEnd && otherStart < start + minutes,
                )
              ) {
                groupIssue = "Los horarios de los grupos no pueden solaparse.";
                break;
              }
              intervals.push([start, start + minutes]);
            }
            const groupError = form.querySelector<HTMLElement>(
              "[data-initial-group-error]",
            );
            if (groupIssue) {
              if (groupError) {
                groupError.textContent = groupIssue;
                groupError.hidden = false;
                groupError.scrollIntoView({ block: "center" });
              }
              return;
            }
            if (groupError) groupError.hidden = true;
            saving = true;
            if (button) {
              button.disabled = true;
              button.querySelector(".submit-label")?.classList.add("hidden");
              button
                .querySelector(".submit-pending")
                ?.classList.remove("hidden");
            }
            error.classList.add("hidden");
            let draftExists = false;
            const showError = (caught: unknown) => {
              error.textContent =
                caught instanceof Error
                  ? caught.message
                  : "No se pudo guardar. Inténtalo nuevamente.";
              error.classList.remove("hidden");
              error.scrollIntoView({ block: "center" });
              if (draftExists) recovery.classList.remove("hidden");
              else if (!(caught instanceof DefinitiveCreateError)) {
                createdDraft = true; // Creation is uncertain: only retry the exact request, never a changed draft.
                recovery.classList.remove("hidden");
                recovery.querySelector("p")!.textContent =
                  "No se confirmó la respuesta. Reintenta la misma solicitud para recuperar el borrador sin duplicarlo.";
                link.hidden = true;
                retry.hidden = false;
                retry.textContent = "Reintentar creación";
                retry.onclick = () => {
                  if (saving) return;
                  saving = true;
                  retry.disabled = true;
                  void notifications
                    .promise(attempt, {
                      loading: { title: "Recuperando borrador…" },
                      success: { title: "Borrador creado correctamente." },
                      error: (caught) => ({
                        title:
                          caught instanceof Error
                            ? caught.message
                            : "No se pudo recuperar el borrador.",
                      }),
                    })
                    .catch(showError)
                    .finally(() => {
                      saving = false;
                      retry.disabled = false;
                    });
                };
              }
              if (!draftExists && button) {
                button.disabled = false;
                button
                  .querySelector(".submit-label")
                  ?.classList.remove("hidden");
                button
                  .querySelector(".submit-pending")
                  ?.classList.add("hidden");
              }
            };
            const attempt = () =>
              createCourseWithArtwork(fields, image, groups, (url, attach) => {
                draftExists = true;
                createdDraft = true;
                link.hidden = false;
                recovery.querySelector("p")!.textContent =
                  "El borrador ya se creó, pero faltan cambios por guardar. Puedes reintentar o abrirlo para continuar.";
                link.href = url;
                retry.textContent = groups.length
                  ? "Reintentar pendientes"
                  : "Reintentar foto";
                retry.hidden = !image && !groups.length;
                retry.onclick = () => {
                  if (saving) return;
                  saving = true;
                  retry.disabled = true;
                  error.classList.add("hidden");
                  void notifications
                    .promise(attach, {
                      loading: { title: "Guardando pendientes…" },
                      success: { title: "Cambios pendientes guardados." },
                      error: (caught) => ({
                        title:
                          caught instanceof Error
                            ? caught.message
                            : "No se pudieron guardar los pendientes.",
                      }),
                    })
                    .catch(showError)
                    .finally(() => {
                      saving = false;
                      retry.disabled = false;
                    });
                };
              });
            void notifications
              .promise(attempt, {
                loading: { title: "Creando borrador…" },
                success: { title: "Borrador creado correctamente." },
                error: (caught) => ({
                  title:
                    caught instanceof Error
                      ? caught.message
                      : "No se pudo crear el borrador.",
                }),
              })
              .catch(showError)
              .finally(() => {
                saving = false;
                button
                  ?.querySelector(".submit-label")
                  ?.classList.remove("hidden");
                button
                  ?.querySelector(".submit-pending")
                  ?.classList.add("hidden");
                form.dispatchEvent(new Event("course-form-change"));
              });
            return;
          }
          if (form.dataset.courseId) {
            event.preventDefault();
            if (!button || saving) return;
            if (imageSelected && !preparedImage) return;
            const release = acquireCourseMutation(form);
            if (!release) return;
            saving = true;
            button.disabled = true;
            button.setAttribute("aria-busy", "true");
            button.querySelector(".submit-label")?.classList.add("hidden");
            button.querySelector(".submit-pending")?.classList.remove("hidden");
            const error =
              document.querySelector<HTMLElement>("[data-save-error]");
            if (error) error.hidden = true;
            form
              .querySelectorAll<HTMLElement>("[data-async-field-error]")
              .forEach((item) => item.remove());
            form
              .querySelectorAll<HTMLElement>('[aria-invalid="true"]')
              .forEach((item) => item.removeAttribute("aria-invalid"));
            void notifications
              .promise(
                async () => {
                  try {
                    const fields = new FormData(form);
                    const submittedImage = preparedImage;
                    let submittedArtworkKey = pendingArtworkKey;
                    if (submittedImage) {
                      if (!submittedArtworkKey) {
                        const upload = new FormData();
                        upload.set("courseId", form.dataset.courseId!);
                        upload.set("image", submittedImage);
                        const uploaded = await fetch("/app/cursos/imagen", {
                          method: "POST",
                          body: upload,
                          credentials: "same-origin",
                        });
                        if (
                          uploaded.redirected ||
                          !uploaded.headers
                            .get("content-type")
                            ?.includes("application/json")
                        )
                          throw new Error(
                            "La sesión cambió. Recarga la página.",
                          );
                        const result: unknown = await uploaded.json();
                        if (
                          !uploaded.ok ||
                          !result ||
                          typeof result !== "object" ||
                          !("artwork" in result) ||
                          typeof result.artwork !== "string"
                        )
                          throw new Error(
                            isError(result)
                              ? result.error
                              : "No se pudo subir la foto.",
                          );
                        submittedArtworkKey = result.artwork;
                        if (preparedImage === submittedImage)
                          pendingArtworkKey = result.artwork;
                      }
                      fields.set("artwork", submittedArtworkKey);
                    }
                    const response = await fetch(mutationPath, {
                      method: "POST",
                      headers: { Accept: "application/json" },
                      body: fields,
                    });
                    if (
                      response.redirected ||
                      !response.headers
                        .get("content-type")
                        ?.includes("application/json")
                    )
                      throw new Error(
                        "La sesión cambió. Recarga la página e inténtalo de nuevo.",
                      );
                    const result = (await response.json()) as {
                      revision?: string;
                      name?: string;
                      message?: string;
                      errors?: Record<string, string>;
                    };
                    if (!response.ok || !isCourseSaveResult(result)) {
                      if (error) {
                        error.textContent =
                          result.message ??
                          "No se pudieron guardar los cambios. Inténtalo nuevamente.";
                        error.hidden = false;
                      }
                      for (const [name, message] of Object.entries(
                        result.errors ?? {},
                      )) {
                        const control = Array.from(form.elements).find(
                          (element) =>
                            element instanceof HTMLElement &&
                            element.getAttribute("name") === name,
                        );
                        if (!(control instanceof HTMLElement)) continue;
                        const hint = document.createElement("p");
                        hint.dataset.asyncFieldError = name;
                        hint.className = "mt-1 text-sm text-destructive";
                        hint.textContent = message;
                        const wrapper =
                          control.closest("label") ?? control.parentElement;
                        wrapper?.append(hint);
                        control.setAttribute("aria-invalid", "true");
                      }
                      error?.scrollIntoView({ block: "center" });
                      throw new Error(
                        result.message ?? "Revisa los campos del formulario.",
                      );
                    }
                    if (!form.isConnected) return; // A late response must not update another course after navigation.
                    synchronizeCourseRevision(
                      form.dataset.courseId!,
                      result.revision,
                    );
                    if (submittedImage && submittedArtworkKey) {
                      form.querySelector<HTMLInputElement>(
                        'input[name="artwork"]',
                      )!.value = submittedArtworkKey;
                      if (preparedImage === submittedImage) {
                        window.dispatchEvent(
                          new CustomEvent("course-artwork-saved", {
                            detail: submittedArtworkKey,
                          }),
                        );
                        preparedImage = null;
                        imageSelected = false;
                        pendingArtworkKey = null;
                      }
                    }
                    baseline = Object.fromEntries(
                      [...fields].filter(
                        (entry): entry is [string, string] =>
                          typeof entry[1] === "string" &&
                          entry[0] in (baseline ?? {}),
                      ),
                    );
                    form.dataset.baseline = JSON.stringify(baseline);
                    form.dispatchEvent(new Event("course-form-change"));
                    const breadcrumb = document.querySelector<HTMLElement>(
                      'nav[aria-label="Ruta de navegación"] [aria-current="page"]',
                    );
                    if (breadcrumb && result.name)
                      breadcrumb.textContent = result.name;
                    if (result.name)
                      document.title = `Editar ${result.name} | SkillBase`;
                  } catch (caught) {
                    if (error) {
                      error.textContent =
                        caught instanceof Error
                          ? caught.message
                          : "No se pudieron guardar los cambios. Inténtalo nuevamente.";
                      error.hidden = false;
                      error.scrollIntoView({ block: "center" });
                    }
                    throw caught;
                  } finally {
                    saving = false;
                    release();
                    button
                      .querySelector(".submit-label")
                      ?.classList.remove("hidden");
                    button
                      .querySelector(".submit-pending")
                      ?.classList.add("hidden");
                    button.removeAttribute("aria-busy");
                    form.dispatchEvent(new Event("course-form-change"));
                  }
                },
                {
                  loading: { title: "Guardando cambios…" },
                  success: { title: "Cambios guardados correctamente." },
                  error: (caught) => ({
                    title:
                      caught instanceof Error
                        ? caught.message
                        : "No se pudieron guardar los cambios.",
                  }),
                },
              )
              .catch(() => {});
            return;
          }
          if (!button) return;
          button.disabled = true;
          button.querySelector(".submit-label")?.classList.add("hidden");
          button.querySelector(".submit-pending")?.classList.remove("hidden");
        });
      });
  });
</script>
