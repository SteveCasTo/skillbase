---
import { buttonVariants } from "@/components/ui/button";
import {
  lifecycleBlockReason,
  type InstructorLifecycle,
} from "@/domain/instructors/lifecycle";
interface Props {
  state: InstructorLifecycle;
  revision: string;
  endpoint: string;
  error?: string | null;
}
const { state, revision, endpoint, error } = Astro.props;
const statusAction = state.status === "ACTIVE" ? "deactivate" : "activate";
const statusReason = lifecycleBlockReason(state, statusAction);
const deleteReason = lifecycleBlockReason(
  { ...state, deletionPending: false },
  "delete",
);
const actions = deleteReason
  ? [
      {
        intent: statusAction,
        label:
          statusAction === "activate"
            ? "Activar instructor"
            : "Desactivar instructor",
        reason: statusReason,
        copy:
          statusAction === "activate"
            ? "Se habilitará el acceso a su cuenta."
            : "Se bloqueará el acceso a su cuenta. Su historial se conserva.",
      },
    ]
  : [
      {
        intent: "delete",
        label: state.deletionPending
          ? "Completar eliminación"
          : "Eliminar instructor",
        reason: null,
        copy: "Se eliminarán el perfil y el acceso a su cuenta. Esta acción no se puede deshacer.",
      },
    ];
---

<section data-instructor-lifecycle class="mt-5 flex min-w-0 flex-col gap-5">
  <header class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex min-w-0 flex-wrap items-center gap-3">
      <slot />
      <p class="text-sm text-muted-foreground">
        {state.deletionPending
          ? "Eliminación pendiente · acceso bloqueado"
          : state.status === "ACTIVE"
            ? "Cuenta activa"
            : state.status === "DISABLED"
              ? "Cuenta desactivada"
              : "Acceso no habilitado"}
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      {actions.map((action) => (
        <details data-lifecycle-confirm class="max-w-full">
          <summary
            class={buttonVariants({
              variant: action.intent === "delete" ? "destructive" : "outline",
              className:
                "min-h-11 cursor-pointer aria-disabled:cursor-not-allowed aria-disabled:opacity-50",
            })}
            aria-disabled={Boolean(action.reason)}
          >
            {action.label}
          </summary>
          <form
            method="post"
            action={endpoint}
            data-lifecycle-form
            class="mt-3 flex max-w-lg flex-col gap-3 rounded-xl border bg-card p-4"
          >
            <p>{action.copy}</p>
            <input type="hidden" name="intent" value={action.intent} />
            <input type="hidden" name="revision" value={revision} />
            <button
              type="submit"
              disabled={Boolean(action.reason)}
              class={buttonVariants({
                variant: action.intent === "delete" ? "destructive" : "default",
                className: "min-h-11",
              })}
            >
              Confirmar {action.label.toLowerCase()}
            </button>
          </form>
        </details>
      ))}
    </div>
  </header>
  {deleteReason &&
    statusReason &&
    (!state.exclusiveInstructor || state.courses.length === 0) && (
      <p class="text-sm text-muted-foreground">
        {state.exclusiveInstructor
          ? state.status === "INVITED"
            ? "El acceso todavía no está habilitado."
            : statusReason
          : "Esta cuenta también tiene acceso administrativo. No se puede dar de baja desde Instructores."}
      </p>
    )}
  {state.courses.length > 0 && (
    <section
      aria-labelledby="blocking-courses-title"
      class="flex min-w-0 flex-col gap-3"
    >
      <h2 id="blocking-courses-title" class="text-sm font-medium">
        {state.exclusiveInstructor
          ? "Reasigna o archiva estos cursos antes de desactivar al instructor:"
          : "Cursos asignados:"}
      </h2>
      <ul class="grid min-w-0 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {state.courses.map((course) => (
          <li class="min-w-0">
            <a
              class="block h-full break-words rounded-lg border bg-card p-4 text-sm font-medium hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring"
              href={`/app/cursos/${course.id}/editar`}
            >
              {course.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  <p
    data-lifecycle-error
    role="alert"
    tabindex="-1"
    hidden={!error}
    class="text-sm text-destructive"
  >
    {error}
  </p>
  <dialog
    data-lifecycle-dialog
    aria-labelledby="lifecycle-dialog-title"
    aria-describedby="lifecycle-dialog-copy"
    class="m-auto w-[min(28rem,calc(100%-2rem))] rounded-xl border bg-card p-6 text-card-foreground backdrop:bg-foreground/40"
  >
    <div class="flex flex-col gap-4">
      <h3 id="lifecycle-dialog-title" class="text-xl font-semibold"></h3>
      <p id="lifecycle-dialog-copy" class="text-sm text-muted-foreground"></p>
      <div class="flex flex-wrap justify-end gap-3">
        <button
          type="button"
          data-lifecycle-close
          class={buttonVariants({ variant: "outline", className: "min-h-11" })}
        >
          Cancelar
        </button>
        <button
          type="button"
          data-lifecycle-accept
          class={buttonVariants({ className: "min-h-11" })}
        >
          Confirmar
        </button>
      </div>
    </div>
  </dialog>
</section>
<script>
  import { navigate } from "astro:transitions/client";
  import { notifications } from "@/lib/notifications";
  function setupLifecycle() {
    document
      .querySelectorAll<HTMLElement>("[data-instructor-lifecycle]")
      .forEach((panel) => {
        if (panel.dataset.ready) return;
        panel.dataset.ready = "true";
        const dialog = panel.querySelector<HTMLDialogElement>(
          "[data-lifecycle-dialog]",
        )!;
        const error = panel.querySelector<HTMLElement>(
          "[data-lifecycle-error]",
        )!;
        let form: HTMLFormElement | null = null;
        let trigger: HTMLElement | null = null;
        let pending = false;
        const controls = [
          ...panel.querySelectorAll<HTMLButtonElement>("button"),
        ];
        const originalDisabled = new Map(
          controls.map((control) => [control, control.disabled]),
        );
        panel
          .querySelectorAll<HTMLDetailsElement>("[data-lifecycle-confirm]")
          .forEach((details) => {
            const summary = details.querySelector<HTMLElement>("summary")!;
            summary.addEventListener("click", (event) => {
              event.preventDefault();
              if (pending || summary.getAttribute("aria-disabled") === "true")
                return;
              form = details.querySelector<HTMLFormElement>("form")!;
              trigger = summary;
              panel.querySelector("#lifecycle-dialog-title")!.textContent =
                summary.textContent;
              panel.querySelector("#lifecycle-dialog-copy")!.textContent =
                form.querySelector("p")!.textContent;
              dialog.showModal();
            });
          });
        dialog.addEventListener("close", () => trigger?.focus());
        panel
          .querySelector("[data-lifecycle-close]")!
          .addEventListener("click", () => dialog.close());
        panel
          .querySelector("[data-lifecycle-accept]")!
          .addEventListener("click", async () => {
            if (!form || pending) return;
            const submitted = form;
            pending = true;
            controls.forEach((control) => {
              control.disabled = true;
            });
            panel.setAttribute("aria-busy", "true");
            dialog.close();
            error.hidden = true;
            const id = crypto.randomUUID();
            notifications.loading({ id, title: "Actualizando cuenta…" });
            let failureMessage = "";
            try {
              const response = await fetch(submitted.action, {
                method: "POST",
                headers: {
                  Accept: "application/json",
                  "Content-Type": "application/x-www-form-urlencoded",
                },
                body: new URLSearchParams(
                  [...new FormData(submitted)].map(([key, value]) => [
                    key,
                    String(value),
                  ]),
                ),
              });
              const result: unknown = await response.json();
              if (!result || typeof result !== "object")
                throw new Error(
                  "No se pudo confirmar la operación. Recarga para comprobar el estado de la cuenta.",
                );
              if (!response.ok) {
                failureMessage =
                  "error" in result && typeof result.error === "string"
                    ? result.error
                    : "No se pudo actualizar la cuenta.";
                throw new Error(failureMessage);
              }
              if (
                !("destination" in result) ||
                typeof result.destination !== "string" ||
                !/^\/app\/instructores(?:\?success=deleted|\/[0-9a-f-]+\/editar\?success=(?:activate|deactivate))$/u.test(
                  result.destination,
                )
              )
                throw new Error(
                  "Recarga para comprobar el estado de la cuenta.",
                );
              notifications.success({ id, title: "Cuenta actualizada" });
              await navigate(result.destination);
            } catch {
              const message =
                failureMessage ||
                "No se pudo actualizar la cuenta. Recarga para comprobar su estado.";
              error.textContent = message;
              error.hidden = false;
              error.focus();
              notifications.dismiss(id);
            } finally {
              pending = false;
              controls.forEach((control) => {
                control.disabled = originalDisabled.get(control) ?? false;
              });
              panel.removeAttribute("aria-busy");
            }
          });
      });
  }
  setupLifecycle();
  document.addEventListener("astro:page-load", setupLifecycle);
</script>
