---
import "@fontsource/alef/700.css";
import "@/styles/public-courses.css";
import "@/styles/public-header.css";

import LandingHeader from "@/components/landing/LandingHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
---

<BaseLayout
  {title}
  {description}
  {noindex}
  showToasts={false}
  allowSystemTheme={false}
>
  <div class="public-courses">
    <LandingHeader onLanding={false} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="course-footer">
      <strong>Formación continua</strong>
      <span>Departamento de Informática y Sistemas · FCyT · UMSS</span>
      <nav aria-label="Navegación de pie de página">
        <a href="/">Inicio</a>
        <a href="/cursos">Cursos</a>
        <a href="/login">Acceso del equipo</a>
      </nav>
    </footer>
  </div>
</BaseLayout>
