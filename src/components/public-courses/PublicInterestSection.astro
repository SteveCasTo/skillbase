---
import PublicInterestForm from "./PublicInterestForm";
import { SileoHost } from "@/components/SileoHost";
import type {
  InterestFormValues,
  PublicInterestFormDto,
  PublicInterestPostPayload,
} from "@/domain/interests/types";
import "@/styles/public-interest.css";

interface Props {
  slug: string;
  form: PublicInterestFormDto | null;
  values: InterestFormValues;
  result?: PublicInterestPostPayload | undefined;
}
const { slug, form, values, result } = Astro.props;
---

<section id="interes" class="public-interest" aria-labelledby="interest-title">
  <div class="interest-introduction">
    <h2 id="interest-title">¿Te interesa este curso?</h2>
    <p>
      Deja tus datos para expresar tu interés. No implica aceptación, pago,
      reserva de plaza ni inscripción.
    </p>
  </div>
  <div class="interest-form-column">
    {form || result ? (
      <PublicInterestForm
        client:load
        action={`/cursos/${encodeURIComponent(slug)}#interes`}
        available={form?.available ?? false}
        groups={form?.groups ?? []}
        initialValues={values}
        initialResult={result}
      />
    ) : (
      <div class="interest-result" role="status">
        <h3>Consulta no disponible</h3>
        <p>
          No pudimos consultar el registro de interés. Intenta nuevamente más
          tarde.
        </p>
      </div>
    )}
  </div>
  <SileoHost client:load />
</section>
