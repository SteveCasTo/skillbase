---
import { ArrowUpRight } from "lucide-react";
import type { DisplayCourse } from "./course-details";
import {
  courseDateRange,
  levelLabels,
  availabilityLabels,
} from "@/components/landing/course-presentation";
import { publicArtworkUrl } from "@/server/courses/artwork";
import CourseArtworkFallback from "./CourseArtworkFallback.astro";

interface Props {
  course: DisplayCourse;
  prominent?: boolean;
  revealDelay?: number;
}
const { course, prominent = false, revealDelay = 0 } = Astro.props;
const artworkUrl = publicArtworkUrl(
  course.artwork,
  import.meta.env.PUBLIC_SUPABASE_URL,
);
---

<article
  class:list={["catalog-poster", { prominent }]}
  style={`--poster-reveal-delay: ${revealDelay}ms`}
>
  <a
    href={`/cursos/${encodeURIComponent(course.slug)}`}
    aria-label={`Ver curso: ${course.name}`}
  >
    <div
      class:list={[
        "poster-art",
        { "has-photo": artworkUrl, "has-fallback": !artworkUrl },
      ]}
      aria-hidden="true"
    >
      {artworkUrl ? (
        <img
          src={artworkUrl}
          alt=""
          width="1200"
          height="750"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <CourseArtworkFallback name={course.name} />
      )}
    </div>
    <div class="poster-copy">
      <p class="course-status">
        {availabilityLabels[course.registrationAvailability]}
      </p>
      <h2>{course.name}</h2>
      <p class="poster-excerpt">{course.description}</p>
      <div class="poster-bottom">
        <span>
          {courseDateRange(course)} · {levelLabels[course.level]} ·{" "}
          {course.totalHours} horas
        </span>
        <span class="poster-action">
          Ver curso <ArrowUpRight aria-hidden="true" />
        </span>
      </div>
    </div>
  </a>
</article>
