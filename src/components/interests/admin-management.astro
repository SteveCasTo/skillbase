---
import type { AdminInterestCourseDto } from "@/domain/interests/types";
import { buttonVariants } from "@/components/ui/button";
import { confirmationFooterClassName } from "@/components/ui/confirmation-footer";
import { Skeleton } from "@/components/private-nav/Skeleton";
import { preferenceDemand } from "./admin-presentation";
import "@/styles/admin-interests.css";

interface Props {
  data: AdminInterestCourseDto;
  status?: "ACTIVE" | "CANCELLED" | undefined;
}
const { data, status } = Astro.props;
const path = `/app/interesados/${data.course.id}`;
const preference = (id: string | null) => {
  if (id === null) return "Sin preferencia";
  const group = data.groups.find((item) => item.id === id);
  return group
    ? `${group.startTime}–${group.endTime}${group.status === "CANCELLED" ? " · Grupo cancelado (histórico)" : ""}`
    : "Grupo histórico";
};
const date = (iso: string) =>
  new Intl.DateTimeFormat("es-BO", {
    dateStyle: "medium",
    timeZone: "America/La_Paz",
  }).format(new Date(iso));
const filters = [
  { label: "Todos", value: undefined },
  { label: "Activos", value: "ACTIVE" },
  { label: "Cancelados", value: "CANCELLED" },
];
---

<div
  data-admin-interests
  data-course-id={data.course.id}
  data-filter={status ?? ""}
>
  <section
    data-interest-metrics
    aria-labelledby="interest-metrics-title"
    class="mt-6 rounded-xl border bg-card p-4 sm:p-5"
  >
    <h2
      id="interest-metrics-title"
      class="flex flex-wrap items-center justify-between gap-3 text-lg font-semibold"
    >
      Interesados activos{" "}
      <span data-active-total class="tabular-nums">
        {data.metrics.activeTotal}
      </span>
    </h2>
    <dl class="mt-4 flex flex-col gap-3">
      {preferenceDemand(data.metrics).map((bucket) => (
        <div
          data-demand-row={bucket.preferredGroupId ?? ""}
          data-leading={String(bucket.leading)}
          class="interest-demand-row grid grid-cols-[minmax(0,1fr)_auto] gap-x-3 gap-y-1 text-sm"
        >
          <dt class="min-w-0 break-words">
            {preference(bucket.preferredGroupId)}
            <span
              data-demand-leading
              hidden={!bucket.leading}
              class="ml-2 text-xs font-medium"
            >
              Mayor demanda
            </span>
          </dt>
          <dd
            data-preference-id={bucket.preferredGroupId ?? ""}
            class="shrink-0 font-semibold tabular-nums"
          >
            {bucket.activeCount}
          </dd>
          <dd class="col-span-2">
            <div
              aria-hidden="true"
              class="h-2 overflow-hidden rounded-full bg-muted"
            >
              <div
                data-demand-bar
                class="interest-demand-bar h-full rounded-full"
                style={`width: ${bucket.share}%`}
              ></div>
            </div>
            <span class="sr-only">
              {Math.round(bucket.share)} % del total activo
            </span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section aria-labelledby="interest-list-title" class="mt-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 id="interest-list-title" tabindex="-1" class="text-xl font-semibold">
        Registros de interés
      </h2>
      <form
        method="get"
        action={path}
        data-interest-filter
        aria-label="Filtrar interesados por estado"
        class="flex flex-wrap gap-2"
      >
        {filters.map((filter) => (
          <button
            type="submit"
            name="status"
            value={filter.value ?? "ALL"}
            aria-pressed={status === filter.value}
            class={buttonVariants({
              variant: status === filter.value ? "secondary" : "outline",
              className: "min-h-11",
            })}
          >
            {filter.label}
          </button>
        ))}
      </form>
    </div>
    <p
      data-interests-error
      hidden
      role="alert"
      class="mt-4 rounded-lg border bg-card p-4 text-sm"
    ></p>
    <button
      data-filter-retry
      hidden
      type="button"
      class={buttonVariants({ variant: "outline", className: "mt-2 min-h-11" })}
    >
      Reintentar filtro
    </button>
    <p data-filter-announcement aria-live="polite" class="sr-only"></p>
    <div
      data-filter-skeleton
      hidden
      aria-hidden="true"
      class="interest-registration-grid mt-5"
    >
      {[0, 1, 2].map(() => (
        <div class="flex flex-col gap-4 rounded-xl border bg-card p-6">
          <Skeleton className="h-5 w-2/3" />
          <Skeleton className="h-4 w-full" />
          <Skeleton className="h-20 w-full" />
        </div>
      ))}
    </div>
    <a
      data-session-login
      hidden
      href="/login"
      class="mt-2 inline-flex min-h-11 items-center underline underline-offset-4"
    >
      Iniciar sesión
    </a>
    <div
      data-interests-empty
      hidden={data.registrations.length !== 0}
      class="mt-5 rounded-xl border border-dashed bg-card p-7 text-center"
    >
      <h3 class="font-semibold">No hay registros para este filtro</h3>
      <p class="mt-2 text-sm text-muted-foreground">
        Prueba con Todos para consultar el historial completo del curso.
      </p>
    </div>
    <ul data-interest-list class="interest-registration-grid mt-5">
      {data.registrations.map((registration) => (
        <li
          data-interest-id={registration.id}
          data-status={registration.status}
          class="flex min-w-0 flex-col rounded-xl border bg-card p-5 sm:p-6"
        >
          <article
            aria-labelledby={`interest-name-${registration.id}`}
            class="flex min-w-0 grow flex-col gap-5"
          >
            <div class="min-w-0">
              <h3
                id={`interest-name-${registration.id}`}
                class="break-words font-semibold"
              >
                {registration.firstName} {registration.lastName}
              </h3>
              <p data-interest-status class="mt-2 text-sm font-medium">
                {registration.status === "ACTIVE" ? "Activo" : "Cancelado"}
              </p>
              <dl class="mt-3 flex flex-col gap-2 text-sm">
                <div>
                  <dt class="sr-only">Email</dt>
                  <dd class="break-all">{registration.email}</dd>
                </div>
                <div>
                  <dt class="sr-only">Teléfono</dt>
                  <dd class="break-all text-muted-foreground">
                    {registration.phone ?? "Sin teléfono"}
                  </dd>
                </div>
              </dl>
            </div>
            <dl class="grid gap-3 text-sm">
              <div>
                <dt class="text-muted-foreground">Preferencia de grupo</dt>
                <dd class="mt-1 break-words">
                  {preference(registration.preferredGroupId)}
                </dd>
              </div>
              <div>
                <dt class="text-muted-foreground">Fecha de registro</dt>
                <dd class="mt-1">
                  <time datetime={registration.createdAt}>
                    {date(registration.createdAt)}
                  </time>
                </dd>
              </div>
            </dl>
            <details data-interest-action class="mt-auto">
              <summary
                class={buttonVariants({
                  variant: "outline",
                  className:
                    "min-h-11 w-full cursor-pointer whitespace-normal text-center",
                })}
              >
                {registration.status === "ACTIVE"
                  ? "Cancelar interés"
                  : "Reactivar interés"}
              </summary>
              <form
                method="post"
                action={status ? `${path}?status=${status}` : path}
                data-interest-form
                aria-label={`Cambiar estado de ${registration.firstName} ${registration.lastName}`}
                class="mt-3 flex flex-col gap-3"
              >
                <input
                  type="hidden"
                  name="interestRegistrationId"
                  value={registration.id}
                />
                <input
                  type="hidden"
                  name="revision"
                  value={registration.updatedAt}
                />
                <input
                  type="hidden"
                  name="intent"
                  value={
                    registration.status === "ACTIVE" ? "cancel" : "reactivate"
                  }
                />
                <p data-confirm-copy class="text-sm text-muted-foreground">
                  {registration.status === "ACTIVE"
                    ? "¿Cancelar este registro? Se conservará en el historial."
                    : "¿Reactivar este registro de interés?"}
                </p>
                <div class={confirmationFooterClassName}>
                  <a
                    href={status ? `${path}?status=${status}` : path}
                    class={buttonVariants({ variant: "outline" })}
                  >
                    Volver
                  </a>
                  <button
                    type="submit"
                    class={buttonVariants({
                      variant: "secondary",
                      className: "min-h-11",
                    })}
                  >
                    {registration.status === "ACTIVE"
                      ? "Cancelar interés"
                      : "Reactivar interés"}
                  </button>
                </div>
              </form>
            </details>
          </article>
          <p
            data-row-error
            hidden
            role="alert"
            class="mt-4 text-sm text-destructive"
          ></p>
        </li>
      ))}
    </ul>
  </section>
  <dialog
    data-interest-dialog
    role="alertdialog"
    aria-labelledby="interest-dialog-title"
    aria-describedby="interest-dialog-description"
    class="fixed inset-0 m-auto w-[calc(100%_-_2rem)] max-w-md rounded-xl border bg-card p-6 text-card-foreground shadow-lg backdrop:bg-foreground/30"
  >
    <h2 id="interest-dialog-title" class="text-lg font-semibold"></h2>
    <p
      id="interest-dialog-description"
      class="mt-3 text-sm text-muted-foreground"
    ></p>
    <div class={`mt-6 ${confirmationFooterClassName}`}>
      <button
        data-dialog-dismiss
        type="button"
        autofocus
        class={buttonVariants({ variant: "outline", className: "min-h-11" })}
      >
        Volver
      </button>
      <button
        data-dialog-confirm
        type="button"
        class={buttonVariants({ variant: "secondary", className: "min-h-11" })}
      >
        Confirmar
      </button>
    </div>
  </dialog>
</div>

<script>
  import { initializeAdminInterests } from "./admin-client";
  initializeAdminInterests();
  document.addEventListener("astro:page-load", initializeAdminInterests);
</script>
