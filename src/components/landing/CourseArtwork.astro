---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import previewCoursePhoto from "../../../assets/plates/course-python-preview.jpg";

interface Props {
  slug: string;
  name: string;
  priority?: boolean;
  usePreviewPhoto?: boolean;
}

const { slug, name, priority = false, usePreviewPhoto = false } = Astro.props;
const previewArtwork: Readonly<Record<string, ImageMetadata>> = {
  "fundamentos-de-python": previewCoursePhoto,
};
const artwork = usePreviewPhoto ? previewArtwork[slug] : undefined;
const initials = name
  .split(/\s+/)
  .filter((word) => word.length > 2)
  .slice(0, 2)
  .map((word) => word[0]?.toLocaleUpperCase("es-BO") ?? "")
  .join("");
---

<div
  class:list={[
    "course-artwork",
    { "has-photo": artwork, "is-featured-artwork": priority },
  ]}
  data-artwork={artwork ? "photo" : "fallback"}
>
  {artwork ? (
    <Image
      src={artwork}
      alt=""
      widths={[480, 720, 960, 1280]}
      sizes="(max-width: 639px) 100vw, (max-width: 899px) 50vw, 58vw"
      format="webp"
      quality={82}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
    />
  ) : (
    <div class="course-artwork-fallback" aria-hidden="true">
      <span class="fallback-rule" />
      <strong>{initials || "CA"}</strong>
      <span class="fallback-caption">Cota Activa · curso</span>
    </div>
  )}
</div>
