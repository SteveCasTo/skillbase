---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import previewCoursePhoto from "../../../assets/plates/course-python-preview.jpg";
import { publicArtworkUrl } from "@/server/courses/artwork";
import CourseArtworkFallback from "@/components/public-courses/CourseArtworkFallback.astro";

interface Props {
  slug: string;
  name: string;
  priority?: boolean;
  usePreviewPhoto?: boolean;
  artwork?: string | null | undefined;
}

const {
  slug,
  name,
  priority = false,
  usePreviewPhoto = false,
  artwork: artworkKey,
} = Astro.props;
const previewArtwork: Readonly<Record<string, ImageMetadata>> = {
  "fundamentos-de-python": previewCoursePhoto,
};
const artwork = usePreviewPhoto ? previewArtwork[slug] : undefined;
const remoteArtwork = publicArtworkUrl(
  artworkKey,
  import.meta.env.PUBLIC_SUPABASE_URL,
);
---

<div
  class:list={[
    "course-artwork",
    { "has-photo": artwork || remoteArtwork, "is-featured-artwork": priority },
  ]}
  data-artwork={artwork || remoteArtwork ? "photo" : "fallback"}
>
  {remoteArtwork ? (
    <img
      src={remoteArtwork}
      alt=""
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
      width="1200"
      height="750"
    />
  ) : artwork ? (
    <Image
      src={artwork}
      alt=""
      widths={[480, 720, 960, 1280]}
      sizes="(max-width: 639px) 100vw, (max-width: 899px) 50vw, 58vw"
      format="webp"
      quality={82}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
    />
  ) : (
    <CourseArtworkFallback {name} />
  )}
</div>
