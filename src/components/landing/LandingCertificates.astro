---
import { ShieldCheck } from "lucide-react";
import VerificationForm from "@/components/certificates/VerificationForm.astro";
---

<section
  id="certificados"
  class="certificates"
  aria-labelledby="certificates-title"
>
  <div class="certificate-signal" aria-hidden="true">
    <span />
    <ShieldCheck />
  </div>
  <div class="certificate-heading" data-signal-reveal="field">
    <h2 id="certificates-title">Una credencial debe poder comprobarse.</h2>
  </div>
  <div class="certificate-copy" data-signal-reveal="field">
    <p>
      La verificación pública permite confirmar la validez de un certificado sin
      exponer información personal innecesaria.
    </p>
    <VerificationForm landing />
  </div>
</section>
