---
import { ArrowRight } from "lucide-react";

import cotaActivaDesktop from "../../../assets/plates/optimized/cota-activa-desktop-1672.webp";
import cotaActivaMobile from "../../../assets/plates/optimized/cota-activa-mobile-1198.webp";
import { responsiveSourceSet } from "./responsive-images";

const mobileWidths = [320, 480, 640, 960, 1198] as const;
const desktopWidths = [640, 960, 1280, 1672] as const;
const mobileAvif = responsiveSourceSet(cotaActivaMobile, mobileWidths, "avif");
const mobileWebp = responsiveSourceSet(cotaActivaMobile, mobileWidths, "webp");
const desktopAvif = responsiveSourceSet(
  cotaActivaDesktop,
  desktopWidths,
  "avif",
);
const desktopWebp = responsiveSourceSet(
  cotaActivaDesktop,
  desktopWidths,
  "webp",
);
const fallback = cotaActivaDesktop;
---

<section class="hero" aria-labelledby="hero-title">
  <picture class="hero-plate">
    <source
      media="(max-width: 639px)"
      type="image/avif"
      srcset={mobileAvif}
      sizes="100vw"
      width={cotaActivaMobile.width}
      height={cotaActivaMobile.height}
    />
    <source
      media="(max-width: 639px)"
      type="image/webp"
      srcset={mobileWebp}
      sizes="100vw"
      width={cotaActivaMobile.width}
      height={cotaActivaMobile.height}
    />
    <source
      media="(min-width: 640px)"
      type="image/avif"
      srcset={desktopAvif}
      sizes="100vw"
      width={cotaActivaDesktop.width}
      height={cotaActivaDesktop.height}
    />
    <source
      media="(min-width: 640px)"
      type="image/webp"
      srcset={desktopWebp}
      sizes="100vw"
      width={cotaActivaDesktop.width}
      height={cotaActivaDesktop.height}
    />
    <img
      src={fallback.src}
      width={cotaActivaDesktop.width}
      height={cotaActivaDesktop.height}
      alt=""
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <div class="hero-copy">
    <h1 id="hero-title">El siguiente paso es tuyo.</h1>
    <p>Descubre nuevas formas de seguir creciendo.</p>
    <a class="primary-action public-action" href="#cursos">
      Explorar cursos <ArrowRight aria-hidden="true" />
    </a>
  </div>
</section>
