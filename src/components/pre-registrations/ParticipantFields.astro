---
import { Input } from "@/components/ui/input";
import type { ParticipantData } from "@/domain/pre-registrations/types";
import { participantFields as fields } from "./participant-fields";
interface Props {
  id: string;
  participant: ParticipantData;
  errors?: Readonly<Record<string, string>>;
  readOnly?: boolean;
}
const { id, participant, errors = {}, readOnly = false } = Astro.props;
---

<div class="participant-fields grid min-w-0 gap-5">
  {fields.map((field) => (
    <div
      class="flex min-w-0 flex-col gap-2"
      data-invalid={Boolean(errors[field.name])}
    >
      <label for={`${id}-${field.name}`} class="text-sm font-medium">
        {field.label}
      </label>
      <Input
        id={`${id}-${field.name}`}
        name={field.name}
        type={field.type}
        autoComplete={field.autocomplete}
        maxLength={field.max}
        required={field.name !== "phone"}
        readOnly={readOnly}
        defaultValue={participant[field.name] ?? ""}
        aria-invalid={Boolean(errors[field.name])}
        aria-describedby={`${id}-${field.name}-error`}
        className="min-h-11"
      />
      <p
        id={`${id}-${field.name}-error`}
        data-field-error={field.name}
        class="text-sm text-destructive empty:hidden"
      >
        {errors[field.name]}
      </p>
    </div>
  ))}
</div>
<style>
  .participant-fields {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 40rem) {
    .participant-fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .participant-fields {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
<script>
  import { bindPhoneInputs } from "./participant-fields";
  bindPhoneInputs();
  document.addEventListener("astro:page-load", () => bindPhoneInputs());
</script>
