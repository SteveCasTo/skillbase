---
import type {
  ParticipantDto,
  ParticipantData,
} from "@/domain/pre-registrations/types";
import { buttonVariants } from "@/components/ui/button";
import ParticipantFields from "./ParticipantFields.astro";
interface Props {
  id: string;
  participant: ParticipantDto;
  values?: ParticipantData;
  action: string;
  requestKey: string;
  errors?: Readonly<Record<string, string>>;
  message?: string;
  lastSubmitted?: Readonly<Record<string, string>> | undefined;
}
const {
  id,
  participant,
  values = participant,
  action,
  requestKey,
  errors = {},
  message,
} = Astro.props;
---

<form
  id={id}
  action={action}
  method="post"
  data-participant-edit
  data-last-submitted={
    Astro.props.lastSubmitted
      ? JSON.stringify(Astro.props.lastSubmitted)
      : undefined
  }
  data-participant-baseline={JSON.stringify(participant)}
  class="flex min-w-0 flex-col gap-6"
  data-astro-reload
>
  <input type="hidden" name="participantId" value={participant.id} />
  <input type="hidden" name="revision" value={participant.revision} />
  <input type="hidden" name="requestKey" value={requestKey} />
  <p class="rounded-lg border bg-secondary p-4 text-sm">
    Esta es la ficha global de la misma persona en todos sus cursos. Los cambios
    no modifican datos públicos de interesados.
  </p>
  <p role="alert" data-form-error class="text-sm text-destructive empty:hidden">
    {message ?? errors.form}
  </p>
  <fieldset class="min-w-0">
    <legend class="mb-4 text-lg font-semibold">Datos de la persona</legend>
    <ParticipantFields id={id} participant={values} errors={errors} />
  </fieldset>
  <button
    type="submit"
    class={buttonVariants({
      className: "min-h-11 w-full sm:w-auto sm:self-start",
    })}
  >
    Guardar cambios
  </button>
</form>
<script>
  import type { ParticipantDto } from "@/domain/pre-registrations/types";
  import { RegistrationError } from "@/domain/pre-registrations/errors";
  import {
    normalizedParticipantDirty,
    participantValues,
  } from "./presentation";
  import { readFormValues, showFormIssues } from "./registration-client";
  function initialize() {
    document
      .querySelectorAll<HTMLFormElement>("[data-participant-edit]")
      .forEach((form) => {
        if (form.dataset.bound) return;
        form.dataset.bound = "true";
        form.noValidate = true;
        const touched = new Set<string>();
        const update = (all = false) => {
          const baseline = JSON.parse(
            form.dataset.participantBaseline!,
          ) as ParticipantDto;
          const values = readFormValues(form);
          let issues: Readonly<Record<string, string>> = {};
          try {
            participantValues(values);
          } catch (error) {
            if (!(error instanceof RegistrationError)) throw error;
            issues = error.issues;
          }
          showFormIssues(form, issues, all ? undefined : touched);
          const valid =
            Object.keys(issues).length === 0 &&
            normalizedParticipantDirty(values, baseline);
          const button = form.querySelector<HTMLButtonElement>(
            'button[type="submit"]',
          );
          if (button) button.disabled = Boolean(form.dataset.pending) || !valid;
          return valid;
        };
        form.addEventListener("input", () => update());
        form.addEventListener("reset", () => queueMicrotask(() => update()));
        form.addEventListener("focusout", (event) => {
          if (event.target instanceof HTMLInputElement)
            touched.add(event.target.name);
          update();
        });
        form.addEventListener("registration:updated", () => update());
        form.addEventListener("submit", (event) => {
          if (form.dataset.pending || !update(true)) {
            event.preventDefault();
            form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
          }
        });
        update();
      });
  }
  initialize();
  document.dispatchEvent(new Event("registration:forms-ready"));
  document.addEventListener("astro:page-load", initialize);
</script>
