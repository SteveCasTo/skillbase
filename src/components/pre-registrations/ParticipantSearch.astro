---
import type { AdminInterestRegistrationDto } from "@/domain/interests/types";
import { X } from "lucide-react";
import { Input } from "@/components/ui/input";
import { buttonVariants } from "@/components/ui/button";
interface Props {
  id: string;
  courseId: string;
  interests?: readonly AdminInterestRegistrationDto[];
  action?: string;
  query?: string;
  chooseHrefs?: Readonly<Record<string, string>>;
  targetFormId?: string;
  error?: string;
  selected?: boolean;
  clearHref?: string;
}
const {
  id,
  courseId,
  interests = [],
  action,
  query = "",
  chooseHrefs = {},
  targetFormId,
  error,
  selected = false,
  clearHref,
} = Astro.props;
const rows = interests
  .filter(
    (person) => person.courseId === courseId && person.status === "ACTIVE",
  )
  .slice(0, 30);
---

<section
  id={id}
  data-participant-search
  data-target-form={targetFormId}
  aria-label="Buscar interesado"
  class="flex min-w-0 flex-col gap-3"
>
  <form
    method="get"
    action={action}
    data-search-form
    class="flex min-w-0 flex-col gap-2"
  >
    {courseId && <input type="hidden" name="courseId" value={courseId} />}
    <label for={`${id}-query`} class="text-sm font-medium">
      Buscar interesado por nombre o correo
    </label>
    <div class="flex min-w-0 items-center gap-2">
      <Input
        id={`${id}-query`}
        name="search"
        type="search"
        defaultValue={query}
        maxLength={100}
        autoComplete="off"
        className="min-h-11 min-w-0 flex-1"
      />
      {targetFormId && (
        <button
          type="button"
          hidden
          data-clear-person
          aria-label="Cambiar persona o registrar manualmente"
          title="Cambiar persona o registrar manualmente"
          class={buttonVariants({
            variant: "outline",
            size: "icon",
            className: "size-11 shrink-0",
          })}
        >
          <X aria-hidden="true" />
        </button>
      )}
    </div>
    {selected && clearHref && (
      <noscript>
        <a
          href={clearHref}
          class="inline-flex min-h-11 items-center text-sm underline underline-offset-4"
        >
          Cambiar persona
        </a>
      </noscript>
    )}
    {action && (
      <button
        type="submit"
        data-search-submit
        class={buttonVariants({
          variant: "outline",
          className: "min-h-11 self-start",
        })}
      >
        Buscar
      </button>
    )}
  </form>
  <p
    role="alert"
    data-search-error
    class="text-sm text-destructive empty:hidden"
  >
    {error}
  </p>
  <p
    data-search-loading
    hidden
    role="status"
    class="text-sm text-muted-foreground"
  >
    Buscando…
  </p>
  <ul
    data-search-results
    class="flex min-w-0 flex-col divide-y rounded-lg border empty:hidden"
  >
    {rows.map((person) => (
      <li class="min-w-0">
        <a
          href={chooseHrefs[person.id]}
          data-choose-person={targetFormId ? "" : undefined}
          data-kind="interest"
          data-person={targetFormId ? JSON.stringify(person) : undefined}
          class="flex min-h-11 w-full flex-col gap-1 px-4 py-3 text-left transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring"
        >
          <span class="break-words font-medium">
            {person.firstName} {person.lastName}
          </span>
          <span class="break-words text-sm text-muted-foreground">
            {person.email}
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p
    data-search-empty
    hidden={rows.length > 0 || query.length < 2}
    role="status"
    class="text-sm text-muted-foreground"
  >
    Sin coincidencias.
  </p>
  <p data-selected-person role="status" class="sr-only">
    {selected
      ? "Interesado seleccionado. Puedes editar sus datos o cambiar de persona."
      : ""}
  </p>
</section>
