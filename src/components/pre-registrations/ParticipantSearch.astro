---
import type { ParticipantDto } from "@/domain/pre-registrations/types";
import type { AdminInterestRegistrationDto } from "@/domain/interests/types";
import { Input } from "@/components/ui/input";
import { buttonVariants } from "@/components/ui/button";
interface Props {
  id: string;
  courseId: string;
  participants?: readonly ParticipantDto[];
  interests?: readonly AdminInterestRegistrationDto[];
  action?: string;
  query?: string;
  chooseHrefs?: Readonly<Record<string, string>>;
  targetFormId?: string;
  error?: string;
  chooseLabel?: string;
}
const {
  id,
  courseId,
  participants = [],
  interests = [],
  action,
  query = "",
  chooseHrefs = {},
  targetFormId,
  error,
} = Astro.props;
const rows = [
  ...participants.map((person) => ({ person, kind: "participant" })),
  ...interests
    .filter(
      (person) => person.courseId === courseId && person.status === "ACTIVE",
    )
    .map((person) => ({ person, kind: "interest" })),
].slice(0, 30);
const compact = Boolean(targetFormId);
---

<section
  id={id}
  data-participant-search
  data-target-form={targetFormId}
  aria-label="Buscar persona"
  class="flex min-w-0 flex-col gap-3"
>
  <form
    method="get"
    action={action}
    data-search-form
    class="flex min-w-0 flex-col gap-2"
  >
    {courseId && <input type="hidden" name="courseId" value={courseId} />}
    <label for={`${id}-query`} class="text-sm font-medium">
      {compact ? "Buscar participante o interesado" : "Nombre o CI"}
    </label>
    <Input
      id={`${id}-query`}
      name="search"
      type="search"
      defaultValue={query}
      maxLength={100}
      autoComplete="off"
      className="min-h-11"
    />
    {action && (
      <button
        type="submit"
        data-search-submit
        class={buttonVariants({
          variant: "outline",
          className: "min-h-11 self-start",
        })}
      >
        Buscar
      </button>
    )}
  </form>
  <p
    role="alert"
    data-search-error
    class="text-sm text-destructive empty:hidden"
  >
    {error}
  </p>
  <p
    data-search-loading
    hidden
    role="status"
    class="text-sm text-muted-foreground"
  >
    Buscando…
  </p>
  <ul
    data-search-results
    class={
      compact
        ? "flex min-w-0 flex-col divide-y rounded-lg border empty:hidden"
        : "grid min-w-0 gap-4 sm:grid-cols-2 xl:grid-cols-3"
    }
  >
    {rows.map(({ person, kind }) => (
      <li class="min-w-0">
        <a
          href={chooseHrefs[person.id]}
          data-choose-person={compact ? "" : undefined}
          data-kind={kind}
          data-person={compact ? JSON.stringify(person) : undefined}
          class={
            compact
              ? "flex min-h-11 w-full flex-col gap-1 px-4 py-3 text-left transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring"
              : "flex h-full min-w-0 flex-col gap-2 rounded-xl border p-5 transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring"
          }
        >
          <span class="break-words font-medium">
            {person.firstName} {person.lastName}
          </span>
          {!compact && "ci" in person && (
            <span class="break-words text-sm text-muted-foreground">
              CI: {person.ci}
            </span>
          )}
          <span class="break-words text-sm text-muted-foreground">
            {person.email}
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p
    data-search-empty
    hidden={rows.length > 0 || query.length < 2}
    role="status"
    class="text-sm text-muted-foreground"
  >
    Sin coincidencias.
  </p>
  <p data-selected-person role="status" class="text-sm empty:hidden"></p>
  {targetFormId && (
    <button
      type="button"
      hidden
      data-clear-person
      class={buttonVariants({
        variant: "outline",
        className: "min-h-11 self-start",
      })}
    >
      Registrar otra persona
    </button>
  )}
</section>
