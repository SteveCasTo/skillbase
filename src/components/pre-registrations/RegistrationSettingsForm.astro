---
import type { RegistrationSettings } from "@/domain/pre-registrations/types";
import { Input } from "@/components/ui/input";
import InlineEditField from "./InlineEditField.astro";
interface Props {
  settings: RegistrationSettings;
  action: string;
  errors?: Readonly<Record<string, string>>;
  values?: Readonly<Record<string, string>>;
  requestKey?: string;
  staleConflict?: boolean;
  message?: string | undefined;
}
const {
  settings,
  action,
  errors = {},
  values = {},
  requestKey = crypto.randomUUID(),
  staleConflict = false,
  message,
} = Astro.props;
const fields = [
  {
    name: "minimumPaymentPercent",
    label: "Pago mínimo para confirmar inscripción",
  },
  {
    name: "auxiliaryDiscountPercent",
    label: "Descuento para auxiliares elegibles",
  },
] as const;
---

<div class="contents">
  {fields.map((field, index) => (
    <form
      method="post"
      action={action}
      class="min-w-0"
      data-registration-settings-form
      data-edit-field={field.name}
      data-baseline={JSON.stringify(settings)}
      data-last-submitted={
        Object.keys(values).length ? JSON.stringify(values) : undefined
      }
    >
      <input
        type="hidden"
        name="revision"
        value={values.revision ?? settings.revision}
      />
      <input
        type="hidden"
        name="requestKey"
        value={index === 0 ? requestKey : crypto.randomUUID()}
      />
      {fields
        .filter((other) => other.name !== field.name)
        .map((other) => (
          <input type="hidden" name={other.name} value={settings[other.name]} />
        ))}
      <InlineEditField label={field.label} value={`${settings[field.name]} %`}>
        <label for={field.name} class="text-sm font-medium">
          {field.label}
        </label>
        <div class="flex max-w-sm items-center gap-2">
          <Input
            id={field.name}
            name={field.name}
            type="text"
            inputMode="numeric"
            pattern="[0-9]+"
            data-settings-integer
            data-integer-max="100"
            required
            defaultValue={values[field.name] ?? settings[field.name]}
            aria-invalid={Boolean(errors[field.name])}
            aria-describedby={`${field.name}-error`}
            className="min-h-11"
          />
          <span aria-label="por ciento">%</span>
        </div>
        <p
          id={`${field.name}-error`}
          data-field-error={field.name}
          role="alert"
          class="text-sm text-destructive empty:hidden"
        >
          {errors[field.name]}
        </p>
        <p
          data-form-error
          role="alert"
          class="text-sm text-destructive empty:hidden"
        >
          {!fields.some((item) => errors[item.name]) && index === 0
            ? message
            : ""}
        </p>
      </InlineEditField>
      <a
        href="/app/configuracion"
        data-settings-refresh
        hidden={!staleConflict}
        class="text-sm underline underline-offset-4"
      >
        Recargar valores vigentes
      </a>
    </form>
  ))}
</div>
<script src="./registration-settings-form-client.ts"></script>
