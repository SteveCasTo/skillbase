---
import type {
  RegistrationDetailDto,
  RegistrationFormDto,
} from "@/domain/pre-registrations/types";
import type { RegistrationOperation } from "@/server/pre-registrations/http";
import FinancialSummary from "./FinancialSummary.astro";
import FinancialHistory from "./FinancialHistory.astro";
import CashMovementForm from "./CashMovementForm.astro";
import CancellationForm from "./CancellationForm.astro";
import TransferForm from "./TransferForm.astro";
import RegistrationActionDialog from "./RegistrationActionDialog";
import ParticipantEditForm from "./ParticipantEditForm.astro";
interface Props {
  detail: RegistrationDetailDto;
  form: RegistrationFormDto;
  serverNow: string;
  failedOperation?: RegistrationOperation | undefined;
  values?: Readonly<Record<string, string>>;
  errors?: Readonly<Record<string, string>>;
  message?: string | undefined;
}
const {
  detail,
  form,
  serverNow,
  failedOperation,
  values = {},
  errors = {},
  message,
} = Astro.props;
const registration = detail.registration;
const path = `/app/preinscripciones/${registration.id}`;
const attempted = (operation: RegistrationOperation) =>
  failedOperation === operation;
const revision = values.revision;
const withAttemptedRevision = (operation: RegistrationOperation) =>
  attempted(operation) && revision
    ? { ...registration, revision }
    : registration;
const key = (operation: RegistrationOperation) =>
  attempted(operation)
    ? values.requestKey || crypto.randomUUID()
    : crypto.randomUUID();
---

<div data-registration-panel class="mt-8 flex min-w-0 flex-col gap-8">
  <section aria-labelledby="registration-participant-title" class="min-w-0">
    <header class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <h2 id="registration-participant-title" class="text-xl font-semibold">
        Datos del participante
      </h2>
      <div
        role="group"
        class="flex flex-wrap items-center gap-3"
        aria-label="Acciones de preinscripción"
      >
        {registration.state === "ACTIVE" && (
          <>
            <RegistrationActionDialog
              client:load
              targetId="registration-transfer-panel"
              title="Cambiar de grupo"
              description={form.course.name}
              initialOpen={attempted("transfer")}
            />
            <RegistrationActionDialog
              client:load
              targetId="registration-cancel-panel"
              title="Cancelar preinscripción"
              description="Revisa el motivo antes de confirmar."
              destructive
              initialOpen={attempted("cancel")}
            />
          </>
        )}
      </div>
    </header>
    <div data-registration-participant-fields>
      <ParticipantEditForm
        id="registration-participant"
        participant={registration.participant}
        action={`/app/participantes/${registration.participant.id}?registrationId=${registration.id}`}
        requestKey={crypto.randomUUID()}
      />
    </div>
  </section>
  <div
    role="group"
    aria-label="Acciones financieras"
    class="flex flex-wrap gap-3"
  >
    {registration.state === "ACTIVE" && registration.balanceCents > 0 && (
      <RegistrationActionDialog
        client:load
        targetId="registration-payment-panel"
        title="Registrar abono"
        description="Registra el efectivo recibido."
        initialOpen={attempted("payment")}
      />
    )}
    {registration.state === "CANCELLED" && registration.refundDueCents > 0 && (
      <RegistrationActionDialog
        client:load
        targetId="registration-refund-panel"
        title="Registrar devolución"
        description="Registra el efectivo entregado."
        initialOpen={attempted("refund")}
      />
    )}
  </div>
  <FinancialSummary registration={registration} />
  {registration.registeredByName && (
    <p class="text-sm text-muted-foreground">
      Registrado por {registration.registeredByName}
    </p>
  )}
  <FinancialHistory detail={detail} />
  <div class="mutation-panels grid min-w-0 gap-8">
    {((registration.state === "ACTIVE" && registration.balanceCents > 0) ||
      attempted("payment")) && (
      <section class="min-w-0">
        <div
          id="registration-payment-panel"
          data-registration-operation="payment"
        >
          <CashMovementForm
            id="registration-payment"
            registration={withAttemptedRevision("payment")}
            kind="PAYMENT"
            startsAt={form.course.startsAt}
            {serverNow}
            requestKey={key("payment")}
            action={`${path}?operation=payment`}
            values={attempted("payment") ? values : {}}
            errors={
              attempted("payment")
                ? { ...errors, ...(message ? { form: message } : {}) }
                : {}
            }
          />
        </div>
      </section>
    )}
    {((registration.state === "CANCELLED" && registration.refundDueCents > 0) ||
      attempted("refund")) && (
      <section class="min-w-0">
        <div
          id="registration-refund-panel"
          data-registration-operation="refund"
        >
          <CashMovementForm
            id="registration-refund"
            registration={withAttemptedRevision("refund")}
            kind="REFUND"
            startsAt={form.course.startsAt}
            {serverNow}
            requestKey={key("refund")}
            action={`${path}?operation=refund`}
            values={attempted("refund") ? values : {}}
            errors={
              attempted("refund")
                ? { ...errors, ...(message ? { form: message } : {}) }
                : {}
            }
          />
        </div>
      </section>
    )}
    {registration.state === "ACTIVE" && (
      <section class="min-w-0">
        <div
          id="registration-transfer-panel"
          data-registration-operation="transfer"
        >
          <TransferForm
            id="registration-transfer"
            lastSubmitted={attempted("transfer") ? values : undefined}
            registration={withAttemptedRevision("transfer")}
            {form}
            {serverNow}
            action={`${path}?operation=transfer`}
            requestKey={key("transfer")}
            destinationGroupId={
              attempted("transfer") ? (values.destinationGroupId ?? "") : ""
            }
            errors={
              attempted("transfer")
                ? { ...errors, ...(message ? { form: message } : {}) }
                : {}
            }
          />
        </div>
      </section>
    )}
    {registration.state === "ACTIVE" && (
      <section class="min-w-0">
        <div
          id="registration-cancel-panel"
          data-registration-operation="cancel"
        >
          <CancellationForm
            id="registration-cancel"
            lastSubmitted={attempted("cancel") ? values : undefined}
            registration={withAttemptedRevision("cancel")}
            {form}
            {serverNow}
            action={`${path}?operation=cancel`}
            requestKey={key("cancel")}
            reason={attempted("cancel") ? (values.reason ?? "") : ""}
            errors={
              attempted("cancel")
                ? { ...errors, ...(message ? { form: message } : {}) }
                : {}
            }
          />
        </div>
      </section>
    )}
  </div>
</div>
<style>
  .mutation-panels {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
  }
  :global([data-dialog-host] h2) {
    display: none;
  }
</style>
