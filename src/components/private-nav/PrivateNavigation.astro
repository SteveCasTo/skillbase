---
import {
  BookOpen,
  ChevronDown,
  Layers3,
  UsersRound,
  Settings,
  FileBadge,
} from "lucide-react";

interface Props {
  mode: "desktop" | "mobile";
  currentPath: string;
  isAdmin: boolean;
  isInstructor: boolean;
}

const { mode, currentPath, isAdmin, isInstructor } = Astro.props;
const isActive = (path: string) =>
  currentPath === path || currentPath.startsWith(`${path}/`);
const courseLinks = [
  { href: "/app/cursos", label: "Cursos", icon: BookOpen },
  { href: "/app/interesados", label: "Interesados", icon: UsersRound },
  {
    href: "/app/preinscripciones",
    label: "Preinscripciones",
    icon: UsersRound,
  },
  { href: "/app/formatos", label: "Formatos", icon: Layers3 },
];
const peopleLinks = [
  { href: "/app/instructores", label: "Instructores", icon: UsersRound },
  {
    href: "/app/administradores",
    label: "Administradores",
    icon: UsersRound,
  },
];
const standaloneLinks = [
  { href: "/app/certificados", label: "Certificados", icon: FileBadge },
  { href: "/app/configuracion", label: "Configuración", icon: Settings },
];
---

<nav
  class="private-nav"
  aria-label={mode === "desktop" ? "Navegación privada" : "Navegación móvil"}
>
  <ul class="private-nav-list">
    {isInstructor && (
      <li>
        <a
          class="private-nav-link"
          href="/app/mis-cursos"
          title="Mis cursos"
          aria-label="Mis cursos"
          aria-current={isActive("/app/mis-cursos") ? "page" : undefined}
        >
          <BookOpen size={19} aria-hidden="true" />
          <span class="private-label">Mis cursos</span>
        </a>
      </li>
    )}
    {isAdmin && (
      <li>
        <details class="private-nav-group" open>
          <summary
            class:list={[
              "private-nav-link",
              courseLinks.some(({ href }) => isActive(href)) &&
                "private-parent-active",
            ]}
            title="Cursos"
            aria-label="Cursos"
          >
            <BookOpen size={19} aria-hidden="true" />
            <span class="private-label">Cursos</span>
            <ChevronDown
              className="private-label private-chevron"
              size={16}
              aria-hidden="true"
            />
          </summary>
          <ul class="private-subnav">
            {courseLinks.map(({ href, label, icon: Icon }) => (
              <li>
                <a
                  href={href}
                  class="private-subnav-link"
                  aria-current={isActive(href) ? "page" : undefined}
                >
                  <Icon size={17} aria-hidden="true" />
                  <span>{label}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      </li>
    )}
    {isAdmin && (
      <li>
        <details class="private-nav-group" open>
          <summary
            class:list={[
              "private-nav-link",
              peopleLinks.some(({ href }) => isActive(href)) &&
                "private-parent-active",
            ]}
            title="Personas"
            aria-label="Personas"
          >
            <UsersRound size={19} aria-hidden="true" />
            <span class="private-label">Personas</span>
            <ChevronDown
              className="private-label private-chevron"
              size={16}
              aria-hidden="true"
            />
          </summary>
          <ul class="private-subnav">
            {peopleLinks.map(({ href, label, icon: Icon }) => (
              <li>
                <a
                  href={href}
                  class="private-subnav-link"
                  aria-current={isActive(href) ? "page" : undefined}
                >
                  <Icon size={17} aria-hidden="true" />
                  <span>{label}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      </li>
    )}
    {isAdmin &&
      standaloneLinks.map(({ href, label, icon: Icon }) => (
        <li>
          <a
            href={href}
            class="private-nav-link"
            title={label}
            aria-label={label}
            aria-current={isActive(href) ? "page" : undefined}
          >
            <Icon size={19} aria-hidden="true" />
            <span class="private-label">{label}</span>
          </a>
        </li>
      ))}
  </ul>
</nav>
