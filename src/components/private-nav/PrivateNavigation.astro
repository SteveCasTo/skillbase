---
import {
  BookOpen,
  ChevronDown,
  LayoutDashboard,
  Layers3,
  UsersRound,
  Settings,
} from "lucide-react";

interface Props {
  mode: "desktop" | "mobile";
  currentPath: string;
  isAdmin: boolean;
  isInstructor: boolean;
}

const { mode, currentPath, isAdmin, isInstructor } = Astro.props;
const courseActive =
  currentPath === "/app/cursos" || currentPath.startsWith("/app/cursos/");
const formatActive = currentPath === "/app/formatos";
const interestActive =
  currentPath === "/app/interesados" ||
  currentPath.startsWith("/app/interesados/");
const registrationActive =
  currentPath.startsWith("/app/preinscripciones") ||
  currentPath.startsWith("/app/participantes");
---

<nav
  class="private-nav"
  aria-label={mode === "desktop" ? "Navegación privada" : "Navegación móvil"}
>
  <ul class="private-nav-list">
    {isAdmin && (
      <li>
        <a
          class="private-nav-link"
          href="/app/instructores"
          title="Instructores"
          aria-current={
            currentPath.startsWith("/app/instructores") ? "page" : undefined
          }
        >
          <UsersRound size={19} aria-hidden="true" />
          <span class="private-label">Instructores</span>
        </a>
      </li>
    )}
    {isInstructor && (
      <li>
        <a
          class="private-nav-link"
          href="/app/mis-cursos"
          title="Mis cursos"
          aria-current={
            currentPath.startsWith("/app/mis-cursos") ? "page" : undefined
          }
        >
          <BookOpen size={19} aria-hidden="true" />
          <span class="private-label">Mis cursos</span>
        </a>
      </li>
    )}
    <li>
      <a
        class="private-nav-link"
        href="/app"
        aria-current={currentPath === "/app" ? "page" : undefined}
        title="Resumen"
      >
        <LayoutDashboard size={19} aria-hidden="true" />
        <span class="private-label">Resumen</span>
      </a>
    </li>
    {isAdmin && (
      <li>
        <details class="private-nav-group" open>
          <summary
            class:list={[
              "private-nav-link",
              (courseActive ||
                formatActive ||
                interestActive ||
                registrationActive) &&
                "private-parent-active",
            ]}
            title="Cursos"
          >
            <BookOpen size={19} aria-hidden="true" />
            <span class="private-label">Cursos</span>
            <ChevronDown
              className="private-label private-chevron"
              size={16}
              aria-hidden="true"
            />
          </summary>
          <ul class="private-subnav">
            <li>
              <a
                href="/app/preinscripciones"
                aria-current={registrationActive ? "page" : undefined}
                class="private-subnav-link"
              >
                <UsersRound size={17} aria-hidden="true" />
                <span>Preinscripciones</span>
              </a>
            </li>
            <li>
              <a
                href="/app/interesados"
                aria-current={interestActive ? "page" : undefined}
                class="private-subnav-link"
              >
                <UsersRound size={17} aria-hidden="true" />
                <span>Interesados</span>
              </a>
            </li>
            <li>
              <a
                href="/app/cursos"
                aria-current={courseActive ? "page" : undefined}
                class="private-subnav-link"
              >
                <BookOpen size={17} aria-hidden="true" />
                <span>Cursos</span>
              </a>
            </li>
            <li>
              <a
                href="/app/formatos"
                aria-current={formatActive ? "page" : undefined}
                class="private-subnav-link"
              >
                <Layers3 size={17} aria-hidden="true" />
                <span>Formatos</span>
              </a>
            </li>
          </ul>
        </details>
      </li>
    )}
    {isAdmin && (
      <li>
        <a
          href="/app/configuracion"
          class="private-nav-link"
          title="Configuración"
          aria-current={
            currentPath === "/app/configuracion" ? "page" : undefined
          }
        >
          <Settings size={19} aria-hidden="true" />
          <span class="private-label">Configuración</span>
        </a>
      </li>
    )}
  </ul>
</nav>
