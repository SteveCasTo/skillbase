---
import type {
  AttendanceSessionDetailDto,
  AttendanceMarkDto,
} from "@/domain/attendance/types";
import { buttonVariants } from "@/components/ui/button";
import AttendanceMarkRow from "./AttendanceMarkRow.astro";
import SessionActions from "./SessionActions.astro";
import { dateLabel, timeLabel, sessionLabels } from "./presentation";
interface Props {
  detail: AttendanceSessionDetailDto;
  path: string;
  isAdmin: boolean;
  correction?: boolean;
  values?: Readonly<Record<string, string>>;
  errors?: Readonly<Record<string, string>>;
  message?: string | undefined;
  failedOperation?: string | undefined;
}
const {
  detail,
  path,
  isAdmin,
  correction = false,
  values = {},
  errors = {},
  message,
  failedOperation,
} = Astro.props;
const { group, session, participants } = detail;
let attemptedId = "";
try {
  const marks = JSON.parse(values.marks ?? "[]") as {
    registrationId?: unknown;
  }[];
  if (typeof marks[0]?.registrationId === "string")
    attemptedId = marks[0].registrationId;
} catch {
  /* The HTTP boundary supplies the persistent error. */
}
const rowProps = (registrationId?: string) =>
  failedOperation === "record" &&
  ((registrationId && attemptedId === registrationId) ||
    (!registrationId && values.instructorStatus !== undefined))
    ? { values, errors, message }
    : {};
const pending: AttendanceMarkDto = {
  status: "PENDING",
  inferred: false,
  markedBy: null,
  markedByName: null,
  markedAt: null,
};
const original = group.sessions.find(
  (row) => row.id === session.replacementForSessionId,
);
const replacement = group.sessions.find(
  (row) => row.replacementForSessionId === session.id,
);
const candidates = detail.reviewCandidates.filter(
  (row) =>
    !participants.some(
      (person) => person.registrationId === row.registrationId,
    ),
);
const attemptedPerson = participants.find(
  (person) => person.registrationId === attemptedId,
);
const inlineRecordFailure =
  session.status !== "CANCELLED" &&
  session.canRecord &&
  Boolean(
    (attemptedPerson && (isAdmin || attemptedPerson.currentlyEnrolled)) ||
    (isAdmin &&
      candidates.some((person) => person.registrationId === attemptedId)) ||
    (isAdmin &&
      values.instructorStatus !== undefined &&
      group.instructorName) ||
    (isAdmin &&
      values.completeAdministrativeReview &&
      session.administrativeReviewRequired),
  );
const inlineFailure =
  failedOperation === "record"
    ? inlineRecordFailure
    : isAdmin &&
      ((failedOperation === "replace" && session.canReplace === true) ||
        (failedOperation === "cancel" && session.canCancel === true));
---

<div data-attendance-session-panel class="flex min-w-0 flex-col gap-6">
  <header class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div class="min-w-0">
      <h1 data-attendance-title class="text-3xl font-semibold tracking-tight">
        <time datetime={session.startsAt}>{dateLabel(session.startsAt)}</time>
      </h1>
      <p class="mt-3 text-muted-foreground">
        {timeLabel(session.startsAt)}–{timeLabel(session.endsAt)} ·{" "}
        {sessionLabels[session.status]}
      </p>
      <div class="mt-3 flex flex-wrap gap-3 text-sm">
        {original && (
          <a
            href={`${path.slice(0, path.lastIndexOf("/"))}/${original.id}`}
            class="min-h-11 underline underline-offset-4"
          >
            Sesión original: {dateLabel(original.startsAt)}
          </a>
        )}
        {replacement && (
          <a
            href={`${path.slice(0, path.lastIndexOf("/"))}/${replacement.id}`}
            class="min-h-11 underline underline-offset-4"
          >
            Recuperación: {dateLabel(replacement.startsAt)}
          </a>
        )}
      </div>
    </div>
    {isAdmin && (
      <SessionActions
        {session}
        {path}
        {failedOperation}
        {values}
        {errors}
        {message}
      />
    )}
  </header>
  {session.status === "CANCELLED" && (
    <p class="text-sm text-muted-foreground">
      Sesión cancelada.
      {session.cancellationReason && ` ${session.cancellationReason}`}
    </p>
  )}
  {!session.canRecord &&
    session.administrativeReviewRequired &&
    session.status !== "CANCELLED" && (
      <p class="text-sm text-muted-foreground">
        Revisión administrativa pendiente.
      </p>
    )}
  {session.status !== "CANCELLED" && (
    <>
      {group.instructorName && (
        <section
          aria-label="Asistencia del instructor"
          class="min-w-0 border-b pb-1"
        >
          <h2 class="text-lg font-semibold">Instructor</h2>
          <AttendanceMarkRow
            id="attendance-instructor"
            name={group.instructorName}
            mark={session.instructorAttendance}
            revision={session.revision}
            action={`${path}?operation=record`}
            canEdit={isAdmin && session.canRecord}
            {...rowProps()}
          />
        </section>
      )}
      <section aria-label="Asistencia de participantes" class="min-w-0">
        <h2 class="text-lg font-semibold">
          {correction ? "Corrección de asistencia" : "Asistencia"}
        </h2>
        {participants.length === 0 ? (
          <p class="py-5 text-sm text-muted-foreground">
            {session.administrativeReviewRequired
              ? "Establece los participantes de esta sesión antes de completar la revisión."
              : "No hay participantes inscritos para esta sesión."}
          </p>
        ) : (
          <div class="divide-y">
            {participants.map((person) => (
              <AttendanceMarkRow
                id={`attendance-mark-${person.registrationId}`}
                registrationId={person.registrationId}
                name={`${person.firstName} ${person.lastName}`}
                mark={person.attendance}
                participant={person}
                revision={session.revision}
                action={`${path}?operation=record`}
                canEdit={
                  session.canRecord && (isAdmin || person.currentlyEnrolled)
                }
                {...rowProps(person.registrationId)}
              />
            ))}
          </div>
        )}
      </section>
      {isAdmin && session.administrativeReviewRequired && session.canRecord && (
        <section aria-label="Revisión histórica" class="min-w-0 border-t pt-5">
          <h2 class="text-lg font-semibold">Revisión histórica</h2>
          {candidates.length > 0 && (
            <div class="divide-y">
              {candidates.map((person) => (
                <AttendanceMarkRow
                  id={`attendance-mark-${person.registrationId}`}
                  registrationId={person.registrationId}
                  name={`${person.firstName} ${person.lastName}`}
                  mark={pending}
                  revision={session.revision}
                  action={`${path}?operation=record`}
                  canEdit
                  candidate
                  {...rowProps(person.registrationId)}
                />
              ))}
            </div>
          )}
          <form
            id="attendance-review"
            method="post"
            action={`${path}?operation=record`}
            data-attendance-form
            data-attendance-operation="review"
            class="mt-4 flex flex-col items-start gap-4"
          >
            <input
              type="hidden"
              name="requestKey"
              value={
                failedOperation === "record" &&
                values.completeAdministrativeReview
                  ? values.requestKey
                  : crypto.randomUUID()
              }
            />
            <input type="hidden" name="revision" value={session.revision} />
            <input type="hidden" name="marks" value="[]" />
            <label class="flex items-start gap-3 text-sm">
              <input
                type="checkbox"
                name="completeAdministrativeReview"
                value="true"
                required
                class="mt-1 size-5 accent-primary"
              />
              Confirmo los participantes establecidos y completo la revisión.
            </label>
            <p class="text-sm text-muted-foreground">
              Las marcas faltantes de los participantes establecidos y del
              instructor contarán como ausencias después de este día.
            </p>
            <p
              data-form-error
              role="alert"
              class="text-sm text-destructive empty:hidden"
            >
              {failedOperation === "record" &&
              values.completeAdministrativeReview
                ? message
                : ""}
            </p>
            <button
              type="submit"
              class={buttonVariants({ className: "min-h-11" })}
            >
              Completar revisión
            </button>
          </form>
        </section>
      )}
    </>
  )}
  <p
    data-attendance-page-error
    role="alert"
    class="text-sm text-destructive empty:hidden"
  >
    {message && !inlineFailure ? message : ""}
  </p>
  <a
    href={path}
    data-attendance-refresh
    hidden
    class="inline-flex min-h-11 items-center self-start underline underline-offset-4"
  >
    Reintentar actualización
  </a>
</div>
<script src="./client.ts"></script>
