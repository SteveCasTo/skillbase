---
import PrivateLayout from "@/layouts/PrivateLayout.astro";
import RegistrationPageError from "@/components/pre-registrations/RegistrationPageError.astro";
import SessionList from "./SessionList.astro";
import AttendanceBreadcrumbs from "./AttendanceBreadcrumbs.astro";
import { buttonVariants } from "@/components/ui/button";
import type { AttendanceGroupDto } from "@/domain/attendance/types";
interface Props {
  courseId: string;
  groupId: string;
  instructorRoute?: boolean;
  group: AttendanceGroupDto | null;
  label: string;
  message: string;
}
const {
  courseId,
  groupId,
  instructorRoute = false,
  group,
  label,
  message,
} = Astro.props;
const prefix = instructorRoute ? "/app/mis-cursos" : "/app/cursos";
---

<PrivateLayout title="Sesiones del grupo">
  <AttendanceBreadcrumbs
    {courseId}
    {groupId}
    {instructorRoute}
    courseName={group?.courseName ?? "Curso"}
    groupLabel={label}
    current="calendar"
  />
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <h1 class="break-words text-3xl font-semibold tracking-tight">{label}</h1>
      <p class="mt-2 text-sm text-muted-foreground">Sesiones y asistencia</p>
    </div>
    {group && (
      <div class="flex flex-wrap gap-3">
        <a
          href={`${prefix}/${courseId}/grupos/${groupId}/participantes`}
          class={buttonVariants({ variant: "outline", className: "min-h-11" })}
        >
          Participantes del grupo
        </a>
        <a
          href={`${prefix}/${courseId}/grupos/${groupId}/evaluaciones`}
          class={buttonVariants({ variant: "outline", className: "min-h-11" })}
        >
          Evaluaciones
        </a>
      </div>
    )}
  </header>
  {group ? (
    <div class="mt-6">
      <SessionList
        {group}
        sessionBase={`${prefix}/${courseId}/grupos/${groupId}/sesiones`}
      />
    </div>
  ) : (
    <RegistrationPageError {message} retryHref={Astro.url.pathname} />
  )}
</PrivateLayout>
