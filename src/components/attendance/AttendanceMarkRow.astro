---
import type {
  AttendanceMarkDto,
  AttendanceParticipantDto,
} from "@/domain/attendance/types";
import {
  ATTENDANCE_LABELS,
  ATTENDANCE_STATUSES,
} from "@/domain/attendance/types";
import AttendanceSelect from "./AttendanceSelect";
import { buttonVariants } from "@/components/ui/button";
import { markValue, dateLabel, timeLabel } from "./presentation";
import { cn } from "@/lib/utils";
import {
  CheckCircle2,
  XCircle,
  ShieldCheck,
  Clock,
  Pencil,
  X,
} from "lucide-react";
interface Props {
  id: string;
  name: string;
  mark: AttendanceMarkDto;
  revision: number;
  action: string;
  canEdit: boolean;
  registrationId?: string;
  participant?: AttendanceParticipantDto;
  candidate?: boolean;
  values?: Readonly<Record<string, string>>;
  errors?: Readonly<Record<string, string>>;
  message?: string | undefined;
}
const {
  id,
  name,
  mark,
  revision,
  action,
  canEdit,
  registrationId,
  participant,
  candidate = false,
  values = {},
  errors = {},
  message,
} = Astro.props;
const field = registrationId ? "marks" : "instructorStatus";
const baseline = registrationId
  ? markValue(registrationId, mark.status)
  : mark.status === "PENDING"
    ? ""
    : mark.status;
const options = ATTENDANCE_STATUSES.map((status) => ({
  value: registrationId ? markValue(registrationId, status) : status,
  label: ATTENDANCE_LABELS[status],
}));
const StatusIcon = {
  PRESENT: CheckCircle2,
  ABSENT: XCircle,
  EXCUSED: ShieldCheck,
  PENDING: Clock,
}[mark.status];
---

<article
  class="grid min-w-0 gap-x-4 gap-y-2 py-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]"
  aria-labelledby={`${id}-name`}
>
  <div class="flex min-w-0 flex-wrap items-baseline gap-x-3 gap-y-1 self-center">
    <h3 id={`${id}-name`} class="break-words font-semibold">
      {name}
    </h3>
    {participant && !participant.academicallyEligible ? (
      <span class="break-words text-sm text-destructive">
        {participant.maximumConsecutiveAbsences} faltas consecutivas · Sin
        reconocimiento
      </span>
    ) : (
      participant?.warning && (
        <span class="break-words text-sm text-destructive">
          {participant.consecutiveAbsences} faltas consecutivas
        </span>
      )
    )}
  </div>
  {canEdit ? (
    <form
      id={id}
      aria-labelledby={`${id}-name`}
      method="post"
      action={action}
      data-attendance-form
      data-attendance-operation="record"
      data-attendance-autosave
      data-baseline={JSON.stringify({ [field]: baseline })}
      data-last-submitted={
        Object.keys(values).length ? JSON.stringify(values) : undefined
      }
      class="flex min-w-0 flex-col gap-2"
    >
      <input
        type="hidden"
        name="revision"
        value={values.revision ?? revision}
      />
      <input
        type="hidden"
        name="requestKey"
        value={values.requestKey ?? crypto.randomUUID()}
      />
      {candidate && registrationId && (
        <input
          type="hidden"
          name="reviewRegistrationIds"
          value={JSON.stringify([registrationId])}
        />
      )}
      <div
        data-mark-display
        hidden
        class="flex min-h-11 items-center justify-end gap-2 text-sm"
      >
        <StatusIcon size={16} aria-hidden="true" className="shrink-0" />
        <span>{ATTENDANCE_LABELS[mark.status]}</span>
        <button
          type="button"
          data-mark-edit
          aria-label={`Editar asistencia de ${name}`}
          title="Editar asistencia"
          class={buttonVariants({
            variant: "ghost",
            size: "icon",
            className: "min-h-11 min-w-11",
          })}
        >
          <Pencil size={16} aria-hidden="true" />
        </button>
      </div>
      <fieldset data-mark-editor class="flex min-w-0 items-start gap-2">
        <div class="min-w-0 flex-1 [&_label]:sr-only">
          <AttendanceSelect
            client:load
            id={`${id}-status`}
            name={field}
            label={`Asistencia de ${name}`}
            value={values[field] ?? baseline}
            required
            placeholder="Pendiente"
            options={options}
            error={errors[field]}
          />
        </div>
        <button
          type="button"
          data-mark-cancel
          hidden
          aria-label={`Cancelar edición de asistencia de ${name}`}
          title="Cancelar edición"
          class={buttonVariants({
            variant: "ghost",
            size: "icon",
            className: "min-h-11 min-w-11",
          })}
        >
          <X size={16} aria-hidden="true" />
        </button>
      </fieldset>
      <button
        type="submit"
        data-mark-submit
        class={buttonVariants({
          variant: "outline",
          className: "min-h-11 self-end",
        })}
      >
        Guardar asistencia
      </button>
      <p
        data-form-error
        role="alert"
        class="text-sm text-destructive empty:hidden"
      >
        {message}
      </p>
      <span data-mark-pending role="status" class="sr-only"></span>
    </form>
  ) : (
    <span
      class={cn(
        "inline-flex min-h-11 items-center gap-2 justify-self-end rounded-md px-3 py-1.5 text-sm font-medium",
        {
          "bg-primary/15 text-foreground": mark.status === "PRESENT",
          "bg-destructive/15 text-foreground": mark.status === "ABSENT",
          "bg-secondary text-foreground": mark.status === "EXCUSED",
          "bg-muted text-muted-foreground": mark.status === "PENDING",
        },
      )}
    >
      <StatusIcon size={16} aria-hidden="true" className="shrink-0" />
      {ATTENDANCE_LABELS[mark.status]}
    </span>
  )}
  {!mark.inferred && mark.markedByName && mark.markedAt && (
    <p class="text-sm text-muted-foreground sm:col-span-2">
      Marcado por {mark.markedByName} ·{" "}
      <time datetime={mark.markedAt}>
        {dateLabel(mark.markedAt)}, {timeLabel(mark.markedAt)}
      </time>
    </p>
  )}
  {participant && !participant.currentlyEnrolled && (
    <p class="text-sm text-muted-foreground sm:col-span-2">
      Inscripción inactiva
    </p>
  )}
</article>
