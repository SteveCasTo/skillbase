---
import type { AttendanceSettingsDto } from "@/domain/attendance/types";
import { Input } from "@/components/ui/input";
import InlineEditField from "@/components/pre-registrations/InlineEditField.astro";
interface Props {
  settings: AttendanceSettingsDto;
  action?: string;
  values?: Readonly<Record<string, string>>;
  errors?: Readonly<Record<string, string>>;
  message?: string | undefined;
}
const {
  settings,
  action = "/app/configuracion/asistencia",
  values = {},
  errors = {},
  message,
} = Astro.props;
---

<form
  id="attendance-settings"
  method="post"
  action={action}
  data-attendance-form
  data-attendance-operation="settings"
  data-baseline={JSON.stringify(settings)}
  data-last-submitted={
    Object.keys(values).length ? JSON.stringify(values) : undefined
  }
  class="min-w-0"
>
  <input
    type="hidden"
    name="revision"
    value={values.revision ?? settings.revision}
  />
  <input
    type="hidden"
    name="requestKey"
    value={values.requestKey ?? crypto.randomUUID()}
  />
  <InlineEditField
    label="Ausencias consecutivas para advertencia"
    value={String(settings.consecutiveAbsenceLimit)}
  >
    <label for="attendance-limit" class="text-sm font-medium">
      Ausencias consecutivas para advertencia
    </label>
    <Input
      id="attendance-limit"
      name="consecutiveAbsenceLimit"
      type="text"
      inputMode="numeric"
      pattern="[0-9]+"
      data-settings-integer
      data-integer-max="2147483647"
      required
      defaultValue={
        values.consecutiveAbsenceLimit ?? settings.consecutiveAbsenceLimit
      }
      aria-invalid={Boolean(errors.consecutiveAbsenceLimit)}
      aria-describedby="attendance-limit-error attendance-limit-help"
      className="min-h-11 max-w-sm"
    />
    <p
      slot="help"
      id="attendance-limit-help"
      class="text-sm text-muted-foreground"
    >
      Al alcanzar este número se muestra una advertencia; al superarlo se pierde
      el reconocimiento.
    </p>
    <p
      id="attendance-limit-error"
      data-field-error="consecutiveAbsenceLimit"
      role="alert"
      class="text-sm text-destructive empty:hidden"
    >
      {errors.consecutiveAbsenceLimit}
    </p>
    <p
      data-form-error
      role="alert"
      class="text-sm text-destructive empty:hidden"
    >
      {message}
    </p>
  </InlineEditField>
  <a
    href="/app/configuracion"
    data-attendance-settings-refresh
    hidden={!message}
    class="mt-3 inline-flex min-h-11 items-center text-sm underline underline-offset-4"
  >
    Recargar valores vigentes
  </a>
</form>
<script src="./client.ts"></script>
