---
import "@fontsource/montserrat/400.css";
import "@fontsource/montserrat/500.css";
import "@fontsource/montserrat/600.css";
import "@fontsource/montserrat/700.css";
import "@/styles/globals.css";
import "sileo/styles.css";
import "@/styles/notifications.css";

import { SileoHost } from "@/components/SileoHost";
import { ClientRouter } from "astro:transitions";
import { themeInitializationScript } from "@/lib/theme";

interface Props {
  title: string;
  description?: string;
  showToasts?: boolean;
  noindex?: boolean;
  allowSystemTheme?: boolean;
  clientRouter?: boolean;
}

const {
  title,
  description = "Gestión de cursos de formación continua y certificados verificables.",
  showToasts = true,
  noindex = false,
  allowSystemTheme = true,
  clientRouter = false,
} = Astro.props;
---

<!doctype html>
<html
  lang="es"
  data-theme={allowSystemTheme ? "system" : "light"}
  data-allow-system-theme={String(allowSystemTheme)}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0d1d28"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {clientRouter && <ClientRouter fallback="swap" />}
    <script is:inline set:html={themeInitializationScript}></script>
    <script>
      import { syncTheme, syncThemeStorage } from "@/lib/theme";
      document.addEventListener("astro:before-swap", (event) =>
        syncTheme(event.newDocument),
      );
      document.addEventListener("astro:after-swap", () => syncTheme());
      window.addEventListener("storage", syncThemeStorage);
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", () => {
          syncTheme();
        });
    </script>
  </head>
  <body>
    <slot />
    {showToasts && <SileoHost client:load transition:persist="sileo-host" />}
  </body>
</html>
