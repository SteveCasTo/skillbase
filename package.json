{
  "name": "skillbase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev": "bun scripts/dev.ts",
    "start": "bun run dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro:sync": "astro sync",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "test": "bun run test:unit",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun scripts/run-integration.ts",
    "test:e2e": "bun scripts/run-e2e.ts",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "supabase:start": "supabase start --exclude realtime,imgproxy,studio,mailpit,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "bun scripts/reset-database.ts",
    "db:seed": "bun scripts/seed.ts",
    "db:seed:demo": "bun scripts/seed-demo.ts",
    "db:cleanup:legacy-test": "bun scripts/cleanup-legacy-test-fixtures.ts",
    "user:preprovision": "bun scripts/preprovision-user.ts",
    "db:studio": "drizzle-kit studio",
    "validate": "bun run check && bun run test:all && bun run build",
    "vercel:link": "vercel link",
    "vercel:pull": "vercel pull"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/vercel": "11.0.10",
    "@fontsource/alef": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/ubuntu-mono": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.45.0",
    "postgres": "3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "sileo": "0.1.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.117.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vercel": "59.16.0"
  }
}
