# Local server runtime. Use the pooler URL in serverless cloud environments.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Direct PostgreSQL connection used only by Drizzle migrations.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Public Auth configuration. Replace the key with `bun run supabase:status` output.
PUBLIC_SITE_URL=http://127.0.0.1:4321
PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only credential for Storage and ADMIN-only instructor provisioning. Never prefix PUBLIC_
# or pass this key to browser code. Set from local CLI status / cloud secrets.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC secret, externally generated with at least 32 characters.
# Public interest POST fails closed (503) until configured. Never print/share it.
# Deployment must supply a trusted Astro.clientAddress; forwarded headers are ignored.
INTEREST_RATE_LIMIT_SECRET=
# Technical abuse-control defaults (positive integers), not commercial quotas.
INTEREST_RATE_COURSE_LIMIT=20
INTEREST_RATE_COURSE_SECONDS=600
INTEREST_RATE_NETWORK_LIMIT=100
INTEREST_RATE_NETWORK_SECONDS=3600

# Optional development-only invitation. Never put a password here.
DEV_INITIAL_ADMIN_EMAIL=

# Local Google OAuth configuration is read by Supabase CLI. Keep real values only
# in the ignored .env file.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Server-only random secret (at least 32 characters) for Auth rate limits and
# short-lived, session-bound confirmation proofs. Never use a PUBLIC_ prefix.
AUTH_RATE_LIMIT_SECRET=
